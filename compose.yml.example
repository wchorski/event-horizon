services:
  db:
    image: postgres:18-alpine
    restart: unless-stopped
    container_name: event_horizon_db
    environment:
      POSTGRES_USER: ${PGUSER}
      POSTGRES_PASSWORD: ${PGPASSWORD}
      POSTGRES_DB: ${PGDATABASE}
      PGDATA: /data/postgres
    # ports:
    #   - "5060:5432"
    networks:
      - event-horizon-network
    volumes:
      - ./db/postgres-data:/data/postgres
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U ${PGUSER} -d ${PGDATABASE}" ]
      interval: 5s
      retries: 10

  # Migration service - runs once using the build stage with dev deps
  migrate:
    container_name: event_horizon_migrate
    build:
      context: .
      target: migrate # Use the migrate stage that has drizzle-kit
    networks:
      - event-horizon-network
    depends_on:
      db:
        condition: service_healthy
    env_file:
      - .env
    restart: "no" # Run once and exit

  seed:
    container_name: event_horizon_seed
    build:
      context: .
      target: seed
    networks:
      - event-horizon-network
    env_file:
      - .env
    depends_on:
      db:
        condition: service_healthy
      app:
        condition: service_healthy
    restart: "no"

  app:
    build: .
    container_name: event_horizon_app
    restart: unless-stopped
    # ports:
    #   - "4321:4321"
    networks:
      - event-horizon-network
      - proxy
    env_file:
      - .env
    volumes:
      - ./public:/app/public
      # - ./uploads:/app/uploads
    healthcheck:
      test: [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:4321/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

    depends_on:
      migrate:
        condition: service_completed_successfully
      db:
        condition: service_healthy
  # seed:
  #   build: .
  #   command: >
  #     sh -c "npm install && npx tsx db/seed-libsql.ts"
  #   environment:
  #     - LIBSQL_URL=http://db:4320
  #   depends_on:
  #     db:
  #       condition: service_healthy
  #   restart: "no" # exits after running — intentional

networks:
  event-horizon-network:
    name: event-horizon-network
    driver: bridge
  proxy:
    name: nginx-prox-mgmt-3_default
    driver: bridge
    external: true
