{
  "name": "event-horizon",
  "type": "module",
  "version": "0.0.3",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "build": "astro build --remote",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:e2e": "npm run build && playwright test",
    "db:create": "tsx src/db/create-collection.ts",
    "db:push": "npx drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts --seed",
    "db:seed:fix": "tsx src/db/fix-seed-data.ts",
    "db:seed:truncate": "tsx src/db/seed.ts -- --seed --truncate",
    "start": "node ./dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@azure/msal-node": "^5.4.1",
    "@better-auth/passkey": "^1.6.23",
    "@js-temporal/polyfill": "^0.5.1",
    "astro": "^7.2.4",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "htmx-ext-response-targets": "^2.0.4",
    "htmx.org": "^2.0.10",
    "pg": "^8.22.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
