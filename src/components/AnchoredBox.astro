---
// components/AnchoredBox.astro
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"div"> {
  messageId: string;
  anchorName: string;
}
const { messageId, anchorName, class: className, ...attrs } = Astro.props;
---

<anchored-box
  data-anchor-name={anchorName}
  class:list={[className]}
  style={`--anchor-name: ${anchorName};`}
  {...attrs}
>
  <p class="message"><slot /></p>
  <button class="close">
    <svg
      width="24px"
      height="24px"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M6.99486 7.00636C6.60433 7.39689 6.60433 8.03005 6.99486 8.42058L10.58 12.0057L6.99486 15.5909C6.60433 15.9814 6.60433 16.6146 6.99486 17.0051C7.38538 17.3956 8.01855 17.3956 8.40907 17.0051L11.9942 13.4199L15.5794 17.0051C15.9699 17.3956 16.6031 17.3956 16.9936 17.0051C17.3841 16.6146 17.3841 15.9814 16.9936 15.5909L13.4084 12.0057L16.9936 8.42059C17.3841 8.03007 17.3841 7.3969 16.9936 7.00638C16.603 6.61585 15.9699 6.61585 15.5794 7.00638L11.9942 10.5915L8.40907 7.00636C8.01855 6.61584 7.38538 6.61584 6.99486 7.00636Z"
        fill="currentColor"></path>
    </svg>
  </button>
</anchored-box>

<script>
  class AnchoredBox extends HTMLElement {
    connectedCallback() {
      const clearBtn = this.querySelector(".close");

      if (clearBtn) {
        clearBtn.addEventListener("click", () => {
          const msgSpans = this.querySelectorAll(".message span");
          msgSpans.forEach((span) => {
            span.textContent = "";
          });
        });
      }
    }
  }

  customElements.define("anchored-box", AnchoredBox);
</script>

<style>
  anchored-box {
    --bg: rgb(51, 51, 51);
    --border: rgb(183, 42, 42);
    --arrow: 22px;
    --gap: 0.5rem;

    display: block;
  }

  anchored-box {
    background: var(--c-txt-bg, var(--bg));
    border: 2px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    z-index: 999;

    display: flex;
    gap: 1rem;
    align-items: center;
    position: fixed;
    box-sizing: border-box;

    /* inline-size: min(anchor-size(width), 100%); */
    /* max-inline-size: calc(100vw - 2rem); */
    position-anchor: var(--anchor-name);
    top: calc(anchor(bottom) + var(--gap));
    right: calc((var(--arrow)));
    /* left: clamp(1rem, anchor(left), calc(100vw - min(anchor-size(width), 100%) - 1rem)); */
    position-try-fallbacks: --bottom-right, --bottom-left;

    transition-property: opacity, transform, overlay, display, visibility;
    transition-duration: 220ms;
    transition-timing-function: ease-out;
    transition-behavior: allow-discrete;
  }

  anchored-box button.close {
    margin-left: auto;
    color: var(--border);
    display: grid;
    place-items: center;
    background-color: transparent;
    border: solid 2px currentColor;
    border-radius: 50%;
    padding: 0.3rem;
    cursor: pointer;
  }

  anchored-box button.close:active {
    border-color: inherit;
    color: inherit;
  }

  anchored-box::after {
    content: "";
    position: absolute;
    top: calc(var(--arrow) / -2);
    /* right: calc(anchor(left) - (var(--arrow) / 2)); */
    right: var(--arrow);
    color: inherit;
    width: var(--arrow);
    height: var(--arrow);
    transform: rotate(45deg);
    background: inherit;

    border-left-style: solid;
    border-top-style: solid;
    border-left-width: inherit;
    border-top-width: inherit;
    border-left-color: inherit;
    border-top-color: inherit;
    z-index: 0;
  }
</style>
