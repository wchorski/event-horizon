---
interface Props {}
const {} = Astro.props;
---

<barcode-scanner data-state="idle">
  <div data-error class="error"></div>

  <div data-view="start">
    <div data-camera-select style="margin-bottom: 15px">
      <label class="camera-select">
        <span class="text">Select Camera:</span>
        <select name="camera" data-camera-list>
          <option value="">Loading cameras...</option>
        </select>
      </label>
    </div>
    <button
      type="button"
      class="btn"
      data-action="start"
      popovertarget="scanner-dialog">Scan Barcode</button
    >
  </div>

  <dialog
    popover
    id="scanner-dialog"
    class="card"
    data-view="scan"
    aria-labelledby="scanner-dialog"
  >
    <h2>Scan Code</h2>
    <div class="video-container">
      <video data-video playsinline></video>
      <div class="scanner-overlay">
        <div class="scanner-frame"></div>
      </div>
      <button class="btn-close" data-action="stop">x</button>
    </div>
    <button popovertarget="scanner-dialog" popovertargetaction="hide"
      >Close</button
    >
    <caption>Align Barcode or QR code into view</caption>
  </dialog>

  <div data-view="result">
    <div class="result-box">
      <header>✓ Barcode Detected!</header>
      <div class="result-format" data-result-format></div>
      <div data-result-value></div>
    </div>
    <div class="button-group">
      <button
        popovertarget="scanner-dialog"
        class="btn"
        data-action="start"
      >
        Scan Again
      </button>
      <button class="btn btn-secondary" data-action="clear">Clear</button>
    </div>
  </div>
</barcode-scanner>

<script>
  interface ScanResult {
    value: string;
    format: string;
    timestamp: Date;
  }

  interface Elements {
    error: HTMLElement;
    startView: HTMLElement;
    scanView: HTMLElement;
    resultView: HTMLElement;
    cameraList: HTMLSelectElement;
    cameraSelect: HTMLElement;
    video: HTMLVideoElement;
    resultFormat: HTMLElement;
    resultValue: HTMLElement;
  }

  class BarcodeScanner extends HTMLElement {
    private stream: MediaStream | null = null;
    private scanInterval: number | null = null;
    private selectedCamera: string | null = null;
    private elements!: Elements; // Add the ! to tell TypeScript we'll initialize it

    connectedCallback() {
      this.elements = this.getElements();
      this.initializeCameras();
      this.setupEventListeners();
    }

    disconnectedCallback() {
      // Cleanup when component is removed
      this.stopScanning();
    }

    private getElements(): Elements {
      const query = <T extends HTMLElement>(selector: string): T => {
        const el = this.querySelector<T>(selector);
        if (!el) throw new Error(`Element not found: ${selector}`);
        return el;
      };

      return {
        error: query("[data-error]"),
        startView: query("[data-view='start']"),
        scanView: query("[data-view='scan']"),
        resultView: query("[data-view='result']"),
        cameraList: query("[data-camera-list]"),
        cameraSelect: query("[data-camera-select]"),
        video: query("[data-video]"),
        resultFormat: query("[data-result-format]"),
        resultValue: query("[data-result-value]"),
      };
    }

    private setupEventListeners(): void {
      this.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const action =
          target.closest<HTMLElement>("[data-action]")?.dataset.action;

        switch (action) {
          case "start":
            this.startScanning();
            break;
          case "stop":
            this.stopScanning();
            break;
          case "clear":
            this.clearResult();
            break;
        }
      });
    }

    private async initializeCameras(): Promise<void> {
      try {
        const devices = await navigator.mediaDevices.enumerateDevices();
        const videoDevices = devices.filter(
          (device) => device.kind === "videoinput",
        );

        if (videoDevices.length > 0) {
          this.elements.cameraList.innerHTML = videoDevices
            .map((device, index) => {
              const label = device.label || `Camera ${index + 1}`;
              return `<option value="${device.deviceId}">${label}</option>`;
            })
            .join("");

          this.selectedCamera = videoDevices[0].deviceId;
        }
      } catch (err) {
        console.error("Error loading cameras:", err);
      }
    }

    private async startScanning(): Promise<void> {
      try {
        this.hideError();
        this.clearResult();

        // Get selected camera
        this.selectedCamera =
          this.elements.cameraList.value || this.selectedCamera;

        const constraints: MediaStreamConstraints = {
          video: this.selectedCamera
            ? { deviceId: { exact: this.selectedCamera } }
            : { facingMode: "environment" },
        };

        this.stream = await navigator.mediaDevices.getUserMedia(constraints);
        this.elements.video.srcObject = this.stream;

        this.setViewState("scanning");

        this.elements.video.onloadedmetadata = () => {
          this.elements.video.play();
          this.startDetection();
        };

        // Reload cameras after permission granted (labels will now be available)
        await this.initializeCameras();

        // throw new Error("debug ");
      } catch (err) {
        this.showError("Camera access denied or not available");
        console.error(err);
      }
    }

    private startDetection(): void {
      if (!("BarcodeDetector" in window)) {
        this.showError(
          "Barcode detection not supported on this browser. Try Chrome on Android.",
        );
        this.stopScanning();
        return;
      }

      // @ts-ignore - BarcodeDetector not in TypeScript lib yet
      const detector = new BarcodeDetector({
        formats: [
          "code_128",
          "code_39",
          "ean_13",
          "ean_8",
          "upc_a",
          "upc_e",
          "qr_code",
        ],
      });

      this.scanInterval = window.setInterval(async () => {
        if (
          this.elements.video.readyState ===
          this.elements.video.HAVE_ENOUGH_DATA
        ) {
          try {
            const barcodes = await detector.detect(this.elements.video);
            if (barcodes.length > 0) {
              this.handleDetection(barcodes[0]);
            }
          } catch (err) {
            console.error("Detection error:", err);
          }
        }
      }, 300);
    }

    private handleDetection(barcode: any): void {
      const result: ScanResult = {
        value: barcode.rawValue,
        format: barcode.format,
        timestamp: new Date(),
      };
      onBarcodeScanned(result.value);
      this.displayResult(result);

      if (navigator.vibrate) {
        navigator.vibrate(200);
      }

      this.stopScanning();
    }

    private stopScanning(): void {
      if (this.scanInterval !== null) {
        clearInterval(this.scanInterval);
        this.scanInterval = null;
      }

      if (this.stream) {
        this.stream.getTracks().forEach((track) => track.stop());
        this.stream = null;
      }

      this.elements.video.srcObject = null;
      // this.setViewState("idle");
    }

    private displayResult(result: ScanResult): void {
      this.elements.resultFormat.textContent = `Format: ${result.format.toUpperCase()}`;
      this.elements.resultValue.textContent = result.value;
      this.setViewState("result");
    }

    private clearResult(): void {
      this.setViewState("idle");
    }

    private showError(message: string): void {
      this.elements.error.textContent = message;
      this.setViewState("error");
    }

    private hideError(): void {
      this.setViewState("idle");
    }

    // TODO prob could do away with this helper function, but i like the type saftey
    private setViewState(
      state: "idle" | "scanning" | "result" | "error",
    ): void {
      this.setAttribute("data-state", state);
    }
  }

  customElements.define("barcode-scanner", BarcodeScanner);

  function onBarcodeScanned(scannedValue: string) {
    // Dispatch custom event with the scanned value
    document.dispatchEvent(
      new CustomEvent("barcode-scanned", {
        detail: { value: scannedValue },
      }),
    );
  }
</script>

<style>
  label.camera-select {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
    color: #374151;
  }
  select[data-camera-list] {
    width: 100%;
    padding: 12px;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    font-size: 16px;
  }
  video {
    transform: scaleX(-1);
  }

  /* Hide all views by default */
  barcode-scanner [data-view] {
    display: none;
  }

  /* State-based view visibility */
  barcode-scanner[data-state="idle"] [data-view="start"] {
    display: block;
  }
  barcode-scanner[data-state="error"] {
    & [data-error] {
      display: block;
    }
    & [data-view="start"] {
      display: block;
    }
  }

  barcode-scanner[data-state="scanning"] [data-view="scan"] {
    display: block;
  }

  barcode-scanner[data-state="result"] [data-view="result"] {
    display: block;
  }

  [data-error] {
    display: none;
  }

  .error {
    background: #fee;
    border: 2px solid #fcc;
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 20px;
    color: #c33;
  }

  .btn {
    width: 100%;
    padding: 18px;
    font-size: 18px;
    font-weight: 600;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .btn:active {
    transform: scale(0.98);
  }

  .video-container {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
  }

  [data-video] {
    width: 100%;
    display: block;
  }

  .scanner-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .scanner-frame {
    position: absolute;
    left: 50px;
    right: 50px;
    top: 30%;
    bottom: 30%;
    border: 3px solid #667eea;
    border-radius: 12px;
    box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.5);
  }

  .btn-close {
    position: absolute;
    top: 15px;
    right: 15px;
    background: #e53e3e;
    color: white;
    border: none;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    font-size: 24px;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    z-index: 10;
  }

  .result-box {
    background: #f0fdf4;
    border: 2px solid #86efac;
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 20px;

    & header {
      font-size: 18px;
      font-weight: 600;
      color: #166534;
      margin-bottom: 5px;
    }
  }

  .result-format {
    font-size: 13px;
    color: #15803d;
    margin-bottom: 15px;
  }

  div[data-result-value] {
    background: white;
    border: 1px solid #86efac;
    border-radius: 8px;
    padding: 15px;
    font-family: "Courier New", monospace;
    font-size: 16px;
    word-break: break-all;
  }

  .button-group {
    display: flex;
    gap: 10px;
  }

  .btn-secondary {
    background: #f3f4f6;
    color: #374151;
  }

  .btn-secondary:hover {
    background: #e5e7eb;
  }
</style>
