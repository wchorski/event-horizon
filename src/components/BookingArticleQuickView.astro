---
// components/BookingArticleQuickView.astro
import { prettyDateToLocale } from "@lib/formatters";
import type {
  BookingSelect,
  LocationSelect,
  TimelineSelect,
  UserSelect,
} from "@ty/Schema";
import Address from "@components/Address.astro";
import SvgBookIcon from "@public/icons/book.svg";
import SvgTimelineIcon from "@public/icons/timeline-clock-outline.svg";

interface Props {
  booking: BookingSelect & {
    location: LocationSelect | null;
    author: UserSelect;
    client: UserSelect | null;
    timeline: TimelineSelect | null;
  };
}
const { booking } = Astro.props;
const { id, start, status, location, author, client, timeline } = booking;
function addressProps(location: LocationSelect){
  const { excerpt, ...loc } = location;
  return loc;
};
---

<article class="card">
  <header class="callout">
    <div>
      {
        client ? (
          <h3>{`${client.name} <${client.email}>`}</h3>
        ) : (
          <h3>No Client Set</h3>
        )
      }
    </div>
    <time datetime={start.toISOString()}>{prettyDateToLocale(start)}</time>
    <p>
      {location ? <Address {...addressProps(location)} />: "address not set"}
    </p>
    <span class="status" data-status={status}>{status}</span>
  </header>

  <div class="flex space-between">
    <div class="actions flex gap-s">
      <a class="btn" href={`/bookings/${id}`}>
        <SvgBookIcon class:list={["inline-icon"]} /> booking</a
      >
      {
        timeline ? (
          <a class="btn" href={`/timelines/${timeline.id}`}>
            <SvgTimelineIcon class:list={["inline-icon"]} /> timeline
          </a>
        ) : (
          <a href={`/timelines?bookingId=${id}`}>+ add timeline</a>
        )
      }
    </div>
  </div>
  <p class="sub-text author">
    <span>author: </span>
    {`${author.name} <${author.email}>`}
  </p>
</article>

<style>
  article {
    position: relative;
  }
  .status {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
  }

  .inline-icon {
    font-size: 1rem;
    height: 0.8rem;
    width: 0.8rem;
    fill: var(--c-txt);
  }

  p.author {
    margin-bottom: 0;
  }
</style>
