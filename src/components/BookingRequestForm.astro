---
// components/BookingRequestForm.astro
import { Booking } from "@db/schema";
import type { BookingSelect, LocationSelect } from "@ty/Schema";
import InputField from "./form/InputField.astro";
import SubmitButton from "./form/SubmitButton.astro";
import type { HTMLAttributes } from "astro/types";
import type { SelectOption } from "@ty/Form";
import SelectField from "./form/SelectField.astro";
import TextareaField from "./form/TextareaField.astro";
import SearchSelect from "./form/SearchSelect.astro";
import SearchSelectAsync from "./form/SearchSelectAsync.astro";
import { DATALIST_TIMEZONES } from "astro:env/client";

interface Props extends HTMLAttributes<"form"> {
  author_user_id: string;
  formId?: string;
  timelineId?: string | null;
  start?: string | null;
  locationOptions?: SelectOption[];
  userOptions?: SelectOption[];
}
const {
  author_user_id,
  formId = "create_a_booking",
  timelineId,
  start,
  class: classList,
  locationOptions = [],
  userOptions = [],
  ...attr
} = Astro.props;
const model = "bookings";
const errorTargetId = `top-level-error-${model}-create`;
const fieldErrorId = (fieldName: string) =>
  `field-error-${model}-create-${fieldName}`;

const cityOptions = DATALIST_TIMEZONES.split(",").map((str) => ({
  value: str,
  label: str,
}));
---

<form
  id={formId}
  class:list={[classList, "bookings-form"]}
  hx-ext="response-targets"
  hx-post={`/partials/bookings/request`}
  hx-target={`#${formId}-success`}
  hx-target-error={`#${errorTargetId}`}
  hx-swap="innerHTML"
  hx-headers='{"X-Partial-Type": "single-page"}'
  hx-include="[name^='booking'], [name^='location']"
>
  <legend>Request a Booking</legend>

  <fieldset>
    <legend>Connect Timeline by ID</legend>
    <InputField
      id={"timelineId"}
      name={"timeline_id"}
      model={"bookings"}
      type={"text"}
      value={timelineId}
      isCreate={true}
    />
    <p class="ghost info">
      Optional: You may create and connect a timeline later
    </p>
  </fieldset>

  <fieldset>
    <legend>Date & Time</legend>
    <InputField
      id={"start"}
      name={"start"}
      model={"bookings"}
      type={"datetime-local"}
      value={start ? `${start}T00:00` : null}
      isCreate={true}
    />
    <TextareaField name={"notes"} errorId={"notes-error"} />
  </fieldset>

  <fieldset>
    <legend>Select Location</legend>
    <SearchSelectAsync
      endpoint="/partials/locations/search"
      searchName="search.locations"
      model="locations"
      isCreate={true}
      name={"location_id"}
      id={"location-search"}
      label="Search by venu name or street address"
      minChars={2}
      debounce={300}
    />
  </fieldset>
  <fieldset>
    <details>
      <summary>Or add a new location</summary>
      <div class="grid gap-s" id="new-location-fields">
        <InputField
          id={"location.name"}
          name={"location.name"}
          model={"bookings"}
          type={"text"}
          isCreate={true}
        />
        <InputField
          id={"location.address"}
          name={"location.address"}
          model={"bookings"}
          type={"text"}
          isCreate={true}
        />
        <InputField
          id={"location.city"}
          name={"location.city"}
          model={"bookings"}
          type={"text"}
          isCreate={true}
        />
        <InputField
          id={"location.state"}
          name={"location.state"}
          model={"bookings"}
          type={"text"}
          isCreate={true}
        />
        <InputField
          id={"location.zip"}
          name={"location.zip"}
          model={"bookings"}
          type={"text"}
        />
        <InputField
          id={"location.timezone"}
          name={"location.timezone"}
          model={"bookings"}
          type={"text"}
          isCreate={true}
          datalist={cityOptions}
        />
      </div>
    </details>
  </fieldset>
  <fieldset>
    <legend>Connect a User</legend>
    <SearchSelectAsync
      endpoint="/partials/users/search"
      searchName="search.users"
      model="users"
      isCreate={true}
      name={"client_id"}
      id={"user-search"}
      label="Search by name or email"
      minChars={2}
      debounce={300}
    />
  </fieldset>
  <fieldset>
    <details>
      <summary>Or register a new User</summary>
      <div class="grid gap-s" id="new-user-fields">
        <InputField
          label="first name"
          id={"new-user.first_name"}
          name={"user.first_name"}
          model={"bookings"}
          type={"text"}
          isCreate={true}
        />
        <InputField
          label="last name"
          id={"new-user.last_name"}
          name={"user.last_name"}
          model={"bookings"}
          type={"text"}
          isCreate={true}
        />
        <InputField
          label="email"
          id={"new-user.email"}
          name={"user.email"}
          model={"bookings"}
          type={"text"}
          isCreate={true}
        />
        <InputField
          label="phone"
          id={"new-user.phone"}
          name={"user.phone"}
          model={"bookings"}
          type={"text"}
          isCreate={true}
        />
      </div>
    </details>
  </fieldset>

  <fieldset class="actions" id={`${formId}-success`}>
    <div class="row-error error top-level">
      <p class="message">
        <span id={errorTargetId}></span>
      </p>
    </div>

    <!-- <div id={`${formId}-success`}></div> -->
    <SubmitButton />
  </fieldset>
</form>
