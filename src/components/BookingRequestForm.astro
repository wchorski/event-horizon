---
// components/BookingRequestForm.astro
import { Booking } from "@db/schema";
import type { BookingSelect, LocationSelect } from "@ty/Schema";
import InputField from "./form/InputField.astro";
import SubmitButton from "./form/SubmitButton.astro";
import type { HTMLAttributes } from "astro/types";
import type { SelectOption } from "@ty/Form";
import SelectField from "./form/SelectField.astro";
import TextareaField from "./form/TextareaField.astro";

interface Props extends HTMLAttributes<"form"> {
  author_user_id: string;
  formId?: string;
  locationOptions?: SelectOption[];
}
const {
  author_user_id,
  formId = "create_a_booking",
  class: classList,
  locationOptions = [],
  ...attr
} = Astro.props;
const model = "bookings";
const errorTargetId = `top-level-error-${model}-create`;
const fieldErrorId = (fieldName: string) =>
  `field-error-${model}-create-${fieldName}`;
---

<form
  id={formId}
  class:list={[classList, "bookings-form"]}
  hx-ext="response-targets"
  hx-post={`/partials/bookings/request`}
  hx-target={`#${formId}`}
  hx-target-error={`#${errorTargetId}`}
  hx-swap="innerHTML"
  hx-headers='{"X-Partial-Type": "single-page"}'
>
  <legend>Create a Booking</legend>

  <fieldset>
    <legend>Date & Time</legend>
    <InputField
      id={"start"}
      name={"start"}
      model={"bookings"}
      type={"datetime-local"}
      isCreate={true}
    />
    <TextareaField name={"notes"} errorId={"notes-error"} />
  </fieldset>

  <fieldset>
    <legend>Select Location</legend>
    <SelectField
      label=""
      name="location_id"
      options={locationOptions}
      errorId={fieldErrorId("location_id")}
    >
      <option slot="first-option" value="">-- select location --</option>
    </SelectField>
  </fieldset>
  <fieldset>
    <details open>
      <summary>Or add a new location</summary>
      <div class="grid gap-s" id="new-location-fields">
        <InputField
          id={"location.name"}
          name={"location.name"}
          model={"locations"}
          type={"text"}
          isCreate={true}
        />
        <InputField
          id={"location.address"}
          name={"location.address"}
          model={"locations"}
          type={"text"}
          isCreate={true}
        />
        <InputField
          id={"location.city"}
          name={"location.city"}
          model={"locations"}
          type={"text"}
          isCreate={true}
        />
        <InputField
          id={"location.state"}
          name={"location.state"}
          model={"locations"}
          type={"text"}
          isCreate={true}
        />
        <InputField
          id={"location.zip"}
          name={"location.zip"}
          model={"locations"}
          type={"text"}
        />
        <InputField
          id={"location.timezone"}
          name={"location.timezone"}
          model={"locations"}
          type={"text"}
          isCreate={true}
        />
      </div>
    </details>
  </fieldset>
  <fieldset>
    <legend>Connect a User</legend>
    <p>TODO</p>
    <!-- <SelectField
        label=""
        name="client_id"
        options={userOptions}
        errorId={"client_id-error"}
      >
        <option slot="first-option">-- select a user --</option>
      </SelectField> -->
  </fieldset>

  <fieldset class="actions">
    <div class="row-error error top-level">
      <p class="message">
        <span id={errorTargetId}></span>
      </p>
    </div>
    <SubmitButton />
  </fieldset>
</form>
