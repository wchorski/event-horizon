---
import type { DriveItem } from "@microsoft/microsoft-graph-types";
import { buildDriveHref, type DriveCrumb } from "@lib/driveNav";

interface Props {
  items: DriveItem[];
  crumbs: DriveCrumb[];
  basePath: string;
}

const { organization } = Astro.locals;
if (!organization) throw new Error("this component is tied to organization");
const { items, crumbs, basePath } = Astro.props;

function formatBytes(bytes?: number | null): string {
  if (bytes === undefined || bytes === null || bytes === 0) return "—";
  const units = ["B", "KB", "MB", "GB"];
  let value = bytes;
  let unitIndex = 0;
  while (value >= 1024 && unitIndex < units.length - 1) {
    value /= 1024;
    unitIndex++;
  }
  return `${value.toFixed(unitIndex === 0 ? 0 : 1)} ${units[unitIndex]}`;
}

function formatDate(dateString?: string | null): string {
  if (!dateString) return "—";
  return new Date(dateString).toLocaleDateString(undefined, {
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function itemType(item: DriveItem): string {
  if (item.folder) return "Folder";
  if (item.file) return item.file.mimeType?.split("/").pop() ?? "File";
  return "Item";
}

function itemIcon(item: DriveItem): string {
  if (item.folder) return "📁";
  const ext =
    item.file?.fileExtension?.toLowerCase() ??
    item.name?.split(".").pop()?.toLowerCase();
  if (ext === "docx" || ext === "doc") return "📄";
  if (ext === "xlsx" || ext === "xls" || ext === "csv") return "📊";
  if (ext === "pdf") return "📕";
  return "📄";
}

// Sort folders first, then alphabetically by name
const sortedItems = [...items].sort((a, b) => {
  const aIsFolder = Boolean(a.folder);
  const bIsFolder = Boolean(b.folder);
  if (aIsFolder !== bIsFolder) return aIsFolder ? -1 : 1;
  return (a.name ?? "").localeCompare(b.name ?? "");
});
---

<div class="drive-table-wrapper">
  <table class="drive-table">
    <thead>
      <tr>
        <th scope="col" class="col-name">Name</th>
        <th scope="col">Type</th>
        <th scope="col">Size</th>
        <th scope="col">Modified</th>
        <th scope="col">Modified By</th>
        <th scope="col">Shared</th>
      </tr>
    </thead>
    <tbody>
      {
        sortedItems.length === 0 && (
          <tr>
            <td colspan="6" class="empty-row">
              This folder is empty.
            </td>
          </tr>
        )
      }
      {
        sortedItems.map((item) => {
          const isFolder = Boolean(item.folder);
          const modifiedByName = item.lastModifiedBy?.user?.displayName ?? "—";

          // Internal drill-down link: same page, folder appended to the breadcrumb trail
          const drillDownHref = isFolder
            ? buildDriveHref(basePath, [
                ...crumbs,
                {
                  id: item.id ?? null,
                  name: item.name ?? "Untitled",
                  webUrl: item.webUrl,
                },
              ])
            : null;

          return (
            <tr class={isFolder ? "row-folder" : "row-file"}>
              <td class="col-name">
                <span class="icon" aria-hidden="true">
                  {itemIcon(item)}
                </span>{" "}
                {isFolder ? (
                  <a href={drillDownHref!} class="drill-link">
                    {item.name}
                  </a>
                ) : (
                  <a
                    href={item.webUrl ?? "#"}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {item.name}
                  </a>
                )}
                {isFolder && item.folder?.childCount !== undefined && (
                  <span class="child-count">
                    ({item.folder.childCount} items)
                  </span>
                )}
                <a
                  class="external-link"
                  href={item.webUrl ?? "#"}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Open in SharePoint"
                  aria-label={`Open ${item.name} in SharePoint`}
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                </a>
                {item.file ? (
                  <a
                    class="external-link"
                    href={`/org/${organization.slug}/packets/${item.id}`}
                    rel="noopener noreferrer"
                    title="View Doc in browser"
                    aria-label={`View ${item.name} in Browser`}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      width="20"
                      height="20"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        opacity="0.5"
                        d="M10 22C6.22876 22 4.34315 22 3.17157 20.8284C2 19.6569 2 18.7712 2 15"
                        stroke="white"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                      <path
                        opacity="0.5"
                        d="M22 15C22 18.7712 22 19.6569 20.8284 20.8284C19.6569 22 17.7712 22 14 22"
                        stroke="white"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                      <path
                        opacity="0.5"
                        d="M14 2C17.7712 2 19.6569 2 20.8284 3.17157C22 4.34315 22 5.22876 22 9"
                        stroke="white"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                      <path
                        opacity="0.5"
                        d="M10 2C6.22876 2 4.34315 2 3.17157 3.17157C2 4.34315 2 5.22876 2 9"
                        stroke="white"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                      <path
                        d="M5.89243 14.0598C5.29748 13.3697 5 13.0246 5 12C5 10.9754 5.29747 10.6303 5.89242 9.94021C7.08037 8.56222 9.07268 7 12 7C14.9273 7 16.9196 8.56222 18.1076 9.94021C18.7025 10.6303 19 10.9754 19 12C19 13.0246 18.7025 13.3697 18.1076 14.0598C16.9196 15.4378 14.9273 17 12 17C9.07268 17 7.08038 15.4378 5.89243 14.0598Z"
                        stroke="white"
                        stroke-width="1.5"
                      />
                      <circle
                        cx="12"
                        cy="12"
                        r="2"
                        stroke="white"
                        stroke-width="1.5"
                      />
                    </svg>
                  </a>
                ) : null}
              </td>
              <td>{itemType(item)}</td>
              <td>{isFolder ? "—" : formatBytes(item.size)}</td>
              <td>{formatDate(item.lastModifiedDateTime)}</td>
              <td>{modifiedByName}</td>
              <td>{item.shared?.scope ?? "Private"}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<style>
  .drive-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--c-seperate, gray);
    border-radius: 8px;
  }

  .drive-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .drive-table thead {
    background: var(--c-seperate, gray);
  }

  .drive-table th {
    text-align: left;
    padding: 0.65rem 0.9rem;
    font-weight: 600;
    color: var(--c-txt-rev);
    border-bottom: 1px solid var(--c-seperate, gray);
    white-space: nowrap;
  }

  .drive-table td {
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--c-seperate, gray);
    vertical-align: middle;
  }

  .drive-table tbody tr:last-child td {
    border-bottom: none;
  }

  .drive-table tbody tr:hover {
    background: #fafafa;
  }

  .col-name {
    /* display: flex; */
    align-items: center;
    gap: 0.4rem;
    min-width: 220px;
  }

  .col-name a {
    text-decoration: none;
    font-weight: 500;
  }

  .drill-link {
    color: #b8860b;
  }

  .drill-link:hover {
    text-decoration: underline;
  }

  .row-file .col-name a:not(.external-link) {
    color: #1a5cff;
  }

  .row-file .col-name a:not(.external-link):hover {
    text-decoration: underline;
  }

  .icon {
    font-size: 1rem;
  }

  .child-count {
    color: #888;
    font-size: 0.8rem;
    margin-left: 0.1rem;
  }

  .external-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #999;
    margin-left: auto;
    padding: 0.15rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .external-link:hover {
    color: #1a5cff;
    background: #eef2ff;
  }

  .empty-row {
    text-align: center;
    color: #888;
    padding: 1.5rem;
  }
</style>
