---
interface Props {
  /** viewport start hour (can be > 24 if you want a multi-day viewport) */
  start?: number; // HOURS
  /** viewport end hour (can be > 24 if you want a multi-day viewport) */
  end?: number; // HOURS
  skills: { name: string; id: number }[];
  moments: TimelineMoment[];
}

import { formatTimeMinutesToClockString } from "@lib/timeFormatters";
import "@styles/timeline-graph.css";
import type { TimelineMoment } from "@ty/Schema";

const { start = 0, end = 24, moments, skills } = Astro.props;

/** grid resolution */
const stepMinutes = 15;
/** x-axis labels every hour */
const tickEvery = 60;

/** viewport bounds in minutes */
const viewStartMin = start * 60;
const viewEndMin = end * 60;

/** number of 15-min columns visible */
const cols = Math.ceil((viewEndMin - viewStartMin) / stepMinutes);

/** lanes: skills define row order (id -> row index 1..N) */
const laneIndex = new Map(skills.map((s, i) => [s.id, i + 1]));
const lanes = skills.length;

/** clamp helper */
const clamp = (n: number, lo: number, hi: number) =>
  Math.min(hi, Math.max(lo, n));
const maxLine = cols + 1; // time-grid lines are 1..(cols+1)

/** compute hourly ticks within viewport */
let firstTick = Math.ceil(viewStartMin / 60) * 60;
if (viewStartMin % 60 === 0) firstTick = viewStartMin;

const ticks: { time: number; colLine: number }[] = [];
for (let t = firstTick; t <= viewEndMin; t += tickEvery) {
  const offset = t - viewStartMin;
  const colLine = Math.round(offset / stepMinutes) + 1; // time-grid line
  ticks.push({ time: t, colLine });
}

/**
 * Blocks:
 * - filter to those overlapping viewport
 * - clamp to viewport so we don't create implicit extra columns
 * - convert minutes -> grid line numbers (c1/c2)
 * - map skill_id -> row number
 */
const momentFormat = moments
  .filter((item) => item.end > viewStartMin && item.start < viewEndMin)
  .map((item) => {
    const clampedStart = Math.max(item.start, viewStartMin);
    const clampedEnd = Math.min(item.end, viewEndMin);

    const startOffset = clampedStart - viewStartMin;
    const endOffset = clampedEnd - viewStartMin;

    let c1 = Math.floor(startOffset / stepMinutes) + 1;
    let c2 = Math.ceil(endOffset / stepMinutes) + 1;

    c1 = clamp(c1, 1, maxLine - 1);
    c2 = clamp(Math.max(c1 + 1, c2), 2, maxLine);

    const r = laneIndex.get(item.skill_id) ?? 1;

    return { item, c1, c2, r };
  });
---

<div
  class="timeline-graph-grid"
  style={`
    --cols:${cols};
    --lanes:${lanes};
  `}
  aria-label="Timeline"
  id={"timeline"}
  data-start={start}
  data-end={end}
>
  {
    ticks.map((t) => (
      <div class="hour-line" style={`--c:${t.colLine};`} aria-hidden="true" />
    ))
  }

  {
    skills.map((skill, i) => (
      <div class="y-axis" style={`grid-row:${i + 1};`} title={skill.name}>
        {skill.name}
      </div>
    ))
  }

  {
    momentFormat.map(({ item, c1, c2, r }) => (
      <div
        class="time-moment"
        style={`--c1:${c1}; --c2:${c2}; --r:${r};`}
        title={`${item.desc} ${formatTimeMinutesToClockString(item.start, true)}–${formatTimeMinutesToClockString(item.end, true)} • skill:${item.skill_id}`}
      >
        <div class="time-moment__title">{item.desc}</div>
        <div class="time-moment__meta">
          {formatTimeMinutesToClockString(item.start, true)}–
          {formatTimeMinutesToClockString(item.end, true)}
        </div>
      </div>
    ))
  }

  {
    ticks.map((t) => (
      <div class="x-tick" style={`--c:${t.colLine};`}>
        <span class="x-tick__label">
          {formatTimeMinutesToClockString(t.time, true)}
        </span>
      </div>
    ))
  }
</div>

<script>
  const timeline = document.getElementById("timeline")!;

  //* LOCAL SYNC
  import { uiTimelineGraph } from "@client/templates/timelineGraph";
  const start = Number(timeline.dataset.start ?? 0);
  const end = Number(timeline.dataset.end ?? 24);

  document.addEventListener("timeline:load", (e: Event) => {
    const { moments, skills } = (e as CustomEvent).detail;
    uiTimelineGraph(timeline, { start, end, skills, moments });
  });

  //* SCROLL TO START
  // config (must match your CSS / component)
  const stepMinutes = 15;

  // ✅ read from computed style so it's always correct
  const colWidth = parseFloat(
    getComputedStyle(timeline).getPropertyValue("--col-w"),
  );

  // ✅ choose your target time (minutes)
  const targetTimeMin = 16 * 60; // 4:00 PM

  // ✅ view start (same logic as your component)
  const viewStartMin = 0; // or whatever you're passing

  const offsetMinutes = targetTimeMin - viewStartMin;

  const scrollLeft = (offsetMinutes / stepMinutes) * colWidth;

  timeline.scrollTo({
    left: scrollLeft,
    behavior: "smooth",
  });
</script>
