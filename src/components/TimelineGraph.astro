---
export type Planner = {
  desc: string;
  block_id: number;
  skill_id: number;
  note: string;
  start: number;
  end: number;
};
interface Props {
  hours?: number;
  start?: number;
  end?: number;
  skills: {
    name: string;
    id: number;
  }[];
  planner: Planner[];
}

import { formatTimeMinutesToClockString } from "@lib/timeFormatters";
import "@styles/timeline-graph.css";

const { hours = 24, start = 0, end = 24, planner, skills } = Astro.props;

const stepMinutes = 15;
const tickEvery = 60;

const toMinutes = (hhmm: string) => {
  const [h, m] = hhmm.split(":").map(Number);
  return h * 60 + m;
};

// bounds
const minStart = Math.min(...planner.map((p) => p.start));
const maxEnd = Math.max(...planner.map((p) => p.end));

// const totalMinutes = maxEnd - minStart;
// const cols = Math.ceil(totalMinutes / stepMinutes); // 15-min columns

// // align hourly grid lines even if minStart isn't on the hour
// const hourRemainder = minStart % 60;
// const hourOffsetMinutes = (60 - hourRemainder) % 60;
// const hourOffsetSteps = Number.isInteger(hourOffsetMinutes / stepMinutes)
//   ? hourOffsetMinutes / stepMinutes
//   : 0;

// // lanes: using block_id
// const laneIds = Array.from(new Set(planner.map((p) => p.skill_id))).sort(
//   (a: any, b: any) => {
//     // numeric sort if both numeric-like
//     const na = Number(a),
//       nb = Number(b);
//     if (!Number.isNaN(na) && !Number.isNaN(nb)) return na - nb;
//     return String(a).localeCompare(String(b));
//   },
// );
// const laneIndex = new Map(skills.map((s, i) => [s, i + 1])); // grid rows are 1-based

// x-axis ticks (hourly only)
let firstTick = Math.ceil(minStart / 60) * 60;
if (minStart % 60 === 0) firstTick = minStart;

const ticks: { time: number; colLine: number }[] = [];
for (let t = firstTick; t <= maxEnd; t += tickEvery) {
  const offset = t - minStart;
  const colLine = Math.round(offset / stepMinutes) + 1;
  ticks.push({ time: t, colLine });
}

// place blocks: compute grid lines for grid-column start/end [1](https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/grid-column)
const blocks = planner.map((item) => {
  const startOffset = item.start - minStart;
  const endOffset = item.end - minStart;

  const c1 = Math.floor(startOffset / stepMinutes) + 1;
  const c2Raw = Math.ceil(endOffset / stepMinutes) + 1;
  const c2 = Math.max(c1 + 1, c2Raw); // ensure at least 1 column wide

  const r = item.skill_id ?? 1;
  return { item, c1, c2, r };
});

// const laneLabel = (name: string, id: number) => `${name} (${id})`;
const columns = 24;
---

<div
  class="timeline-graph"
  style={`
    --cols:${columns};
    --lanes:${skills.length};
  `}
>
  <div class="y-axis" aria-label="Y axis lanes">
    {skills.map(({ name, id }) => <div class="lane">{`${name} (${id})`}</div>)}
  </div>

  <div class="timeline-scroll" style={`--cols:${columns}; --time-cols: repeat(${columns}, var(--col-w));`}>
    <div class="grid-container unstyled" aria-label="Timeline grid">
      {
        blocks.map(({ item, c1, c2, r }) => (
          <div
            class="time-block-item"
            style={`--c1:${c1}; --c2:${c2}; --r:${r};`}
            title={`${item.desc} ${formatTimeMinutesToClockString(item.start, true)}-${formatTimeMinutesToClockString(item.end, true)} • ${item.skill_id}`}
          >
            <div class="time-block-item__title">{item.desc}</div>
            <div class="time-block-item__meta">
              {formatTimeMinutesToClockString(item.start, true)}-
              {formatTimeMinutesToClockString(item.end, true)} • {item.skill_id}
            </div>
          </div>
        ))
      }
    </div>

    <div class="x-axis unstyled" aria-label="X axis time labels">
      {
        ticks.map((t) => (
          <div class="tick" style={`--c:${t.colLine};`}>
            {formatTimeMinutesToClockString(t.time, true)}
          </div>
        ))
      }
    </div>
  </div>
</div>

<style define:vars={{ hours }}>
  :root {
    --hours: hours;
  }
</style>
