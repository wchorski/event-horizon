---
// components/form/CardForm.astro
import type { HTMLAttributes } from "astro/types";
import SubmitButton from "./SubmitButton.astro";

interface Props extends Omit<HTMLAttributes<"form">, "method"> {
  id: string;
  endpoint: string;
  submitText?: string;
  method: "get" | "post" | "patch" | "put";
  error?: string | null;
}

const { error, submitText, id, endpoint, method, ...attrs } = Astro.props;

const hxAttrs = endpoint
  ? { [`hx-${method}`]: endpoint } // pure htmx
  : { method, "hx-boost": "true" }; // native POST, boosted
const toplevelMsgId = id + "-toplevel-msg";
---

<form
  class:list={["card"]}
  hx-target={toplevelMsgId}
  hx-target-error={toplevelMsgId}
  hx-disabled-elt="find button[type=submit]"
  {...hxAttrs}
  {...attrs}
>
  <slot />
  <div id={toplevelMsgId} class="toplevel-msg">{error && <p class="form-error error callout" role="alert">{error}</p>}</div>
  <SubmitButton text={submitText} />
</form>
