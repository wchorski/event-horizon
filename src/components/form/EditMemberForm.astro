---
// components/form/InviteMemberform
interface Props extends Omit<HTMLAttributes<"form">, "method"> {
  id?: string;
  member: ListMember;
  organizationSlug: string;
  organizationId: string;
  orgTeamCheckboxes?: CheckboxField[];
  memberRoleOpts?: { label: string; value: string }[];
}
import InputField from "@components/form/InputField.astro";
import SelectField from "@components/form/SelectField.astro";
import FormCard from "./FormCard.astro";
import type { ListMember } from "@ty/Schema";
import type { HTMLAttributes } from "astro/types";
import CheckboxMulti from "./CheckboxMulti.astro";
import type { CheckboxField } from "@ty/FieldConfig";

const {
  id = "form--member-edit",
  organizationSlug,
  organizationId,
  member,
  orgTeamCheckboxes = [],
  memberRoleOpts = [],
  ...props
} = Astro.props;

console.log({orgTeamCheckboxes});

// TODO on success completely remove form
---

<FormCard
  {id}
  class="card"
  method="patch"
  endpoint={`/org/${organizationSlug}/partials/members/${member.id}/${organizationId}`}
  submitText="Update"
  hx-on--after-request="if (event.detail.successful) this.reset()"
  {...props}
>
  <header>
    <h2>Edit Member</h2>
    <span class="sub-text">{member.user.email}</span>
  </header>
  {
    orgTeamCheckboxes.length > 0 ? (
      <fieldset>
        <legend>Teams</legend>
        <CheckboxMulti
            formId={id}
            boxes={orgTeamCheckboxes}
            name={"teamIds"}
            
          />
        {/* {orgTeamCheckboxes.map((teamBox) => (
          <CheckboxMulti
            formId={id}
            
            idSuffix={teamBox.value}
            name={"teamIds"}
            label={teamBox.label}
            checked={teamBox.checked}
            value={teamBox.value}
          />
        ))} */}
      </fieldset>
    ) : null
  }
  <fieldset class="no-style">
    {
      memberRoleOpts.length > 0 ? (
        <SelectField
          formId={id}
          id={`${id}-role`}
          name={"role"}
          options={memberRoleOpts}
          value={member.role}
        >
          <option slot="first-option" value={undefined}>
            -- select role --
          </option>
        </SelectField>
      ) : null
    }

    <InputField formId={id} type={"checkbox"} name="notify" checked={false} />
  </fieldset>

  <slot name="icon" slot="icon" />
</FormCard>
