---
// components/form/IntegrationCredForm
interface Props {
  organizationId: string;
  organizationSlug: string;
}
import { INTEGRATION_PROVIDERS } from "@db/enums";
import InputField from "./InputField.astro";
import SelectField from "./SelectField.astro";
import SubmitButton from "./SubmitButton.astro";
const { organizationId, organizationSlug } = Astro.props;

const providerOptions = INTEGRATION_PROVIDERS.map((text) => ({
  label: text,
  value: text,
}));

const formId = "integration-form";
// TODO use FormCard
---

<form
  id={formId}
  class="card"
  hx-post=`/org/${organizationSlug}/partials/integrations/${organizationId}`
  hx-target={`#${formId}-success`}
  hx-target-error={`#${formId}-error`}
  hx-swap="innerHTML"
>
  <legend>Integration Form</legend>
  <fieldset>
    <SelectField
    {formId}
      name={"provider"}
      
      options={providerOptions}
    />
    <InputField
    {formId}
      name="tenantId"
      type={"text"}
      autocomplete="off"
    />
    <InputField
      {formId}
      name="clientId"
      
      type={"text"}
      autocomplete="off"
    />
    <InputField
      {formId}
      name="secret"
      type={"password"}
      autocomplete="off"
    />
  </fieldset>
  <div id={formId + "-error"}></div>
  <div id={`${formId}-success`}></div>
  <SubmitButton>Connect</SubmitButton>
</form>
