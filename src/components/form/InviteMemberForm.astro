---
interface Props {
  id?:string
  organizationSlug: string;
  organizationId: string;
}
import { MEMBER_ROLES } from "@db/schema";
import InputField from "@components/form/InputField.astro";
import SelectField from "@components/form/SelectField.astro";
import SubmitButton from "@components/form/SubmitButton.astro";
import FormCard from "./FormCard.astro";

const { id = 'form--member-invite', organizationSlug, organizationId } = Astro.props;

const roleOptions = MEMBER_ROLES.map((text) => ({
  label: text,
  value: text,
})).reverse();

// TODO target list of users instead to self populate user table
---

<FormCard
  {id}
  class="card"
  hx-post={`/org/${organizationSlug}/partials/invite-member/${organizationId}`}
  submitText="Send Invite""
>
  <h2>Invite a user to become a member</h2>
  <fieldset class="no-style">
    <SelectField
      id={`${id}-role`}
      name={"role"}
      errorId={id + "-role"}
      options={roleOptions}
    />
    <InputField formId={id} name="email" type={"email"} autocomplete="off" />
  </fieldset>
  
</FormCard>
