---
// components/form/InviteMemberform
interface Props {
  id?: string;
  organizationSlug: string;
  organizationId: string;
}
import { MEMBER_ROLES } from "@db/schema";
import InputField from "@components/form/InputField.astro";
import SelectField from "@components/form/SelectField.astro";
import FormCard from "./FormCard.astro";

const {
  id = "form--member-invite",
  organizationSlug,
  organizationId,
} = Astro.props;

const roleOptions = MEMBER_ROLES.map((text) => ({
  label: text,
  value: text,
})).reverse();

// TODO target list of users instead to self populate user table
---

<FormCard
  {id}
  class="card"
  method="post"
  endpoint={`/org/${organizationSlug}/partials/invite-member/${organizationId}`}
  submitText="Send Invite"
  hx-on--after-request="if (event.detail.successful) this.reset()"
>
  <h2>Invite a user to become a member</h2>
  <fieldset class="no-style">
    <SelectField name={"role"} formId={id} options={roleOptions} />
    <InputField
      formId={id}
      name="email"
      type={"email"}
      autocomplete="off"
      required
    />  
  </fieldset>

  <slot name="icon" slot="icon" />
</FormCard>
