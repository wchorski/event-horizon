---
// components/form/OrganizationCreationForm
interface Props {
  id?: string;
}
import InputField from "./InputField.astro";
import FormCard from "./FormCard.astro";
import { ForbiddenError } from "@lib/errors";

const { id = "form--org-create-" } = Astro.props;

// TODO also make submitting user a member of this org
const isAdmin = Astro.locals.user?.role === "admin";
---

{
  isAdmin ? (
    <FormCard
      {id}
      submitText="Create"
      method="post"
      endpoint="/admin/partials/organizations/create"
    >
      <h2>Create New Organization</h2>
      <InputField
        formId={id}
        name="name"
        required="true"
        placeholder="My Organization"
      />

      <InputField
        formId={id}
        name="slug"
        required="true"
        placeholder={"my-org-abbreviation (no spaces, all lowercase)"}
      />

      <InputField
        formId={id}
        name="logo"
        placeholder={"https://pictures/my-logo.png"}
      />
    </FormCard>
  ) : null
}
