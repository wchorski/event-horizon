---
// components/form/SubmitButton
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"button"> {
  formId?: string;
  text?: string;
  indicatorText?: string;
  hideText?: boolean;
  size?: "s" | "m" | "l";
}
const {
  formId = "submit-button",
  text = "Submit",
  indicatorText = "Submitting...",
  hideText = false,
  class: className,
  size,
  ...attrs
} = Astro.props;

type Style = HTMLAttributes<"span">["style"];

const style = {
  ...(size
    ? {
        padding: `var(--size-${size})`,
        fontSize: `calc(1rem + (var(--size-m) * 0.3))`,
      }
    : {}),
};
const id = formId ? `${formId}--submit-button` : null;
---

<button
  type="submit"
  title={hideText ? text : ""}
  class:list={[className]}
  {id}
  {style}
  {...attrs}
>
  <span class:list={["text", hideText ? "hide" : ""]}>{text}</span>
  <span class="submit-indicator htmx-indicator">{indicatorText}</span>
  <slot name="icon" slot="icon" />
</button>
