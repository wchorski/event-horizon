---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"button"> {
  id?: string;
  text?: string;
  indicatorText?: string;
  hideText?: boolean;
  size?: "s" | "m" | "l";
}
const {
  id = "submit-button",
  text = "Submit",
  indicatorText = "Submitting...",
  hideText = false,
  class: className,
  size,
  ...attrs
} = Astro.props;

type Style = HTMLAttributes<"span">["style"];

const style = {
  ...(size ? { padding: `var(--size-${size})` } : {}),
};
---

<button
  type="submit"
  title={hideText ? text : ""}
  id={id}
  class:list={[className]}
  {style}
  {...attrs}
>
  <span class:list={["text", hideText ? "hide" : ""]}>{text}</span>
  <span class="submit-indicator">{indicatorText}</span>
  <slot name="icon" />
</button>
