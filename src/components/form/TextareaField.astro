---
import { fieldErrorId, fieldId } from "@lib/fieldIds";
import type { FieldSlot, FieldOption } from "@ty/FieldConfig";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<
  HTMLAttributes<"textarea">,
  "type" | "value" | "checked" | "name"
> {
  formId: string;
  idSuffix?: string;
  name: string;
  label?: string;
  value?: string | number;
  error?: string;
}
const {
  formId,
  idSuffix,
  name,
  label,
  value,
  error,
  //   options,
  autofocus,
  ...props
} = Astro.props;

const id = fieldId(formId, idSuffix ? `${name}-${idSuffix}` : name);
const errorId = fieldErrorId(formId, idSuffix ? `${name}-${idSuffix}` : name);
---

<label>
  <span class="text">{label ?? name}</span>
  <textarea {id} form={formId} name={name} autofocus={autofocus} {...props}>{value}</textarea>
  <small id={errorId} class="field-error" aria-live="polite">
        {error}
      </small>
</label>
