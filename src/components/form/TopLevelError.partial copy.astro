---
// TopLevelError.partial.astro
import type { CrudRegistryType } from "@lib/crudRegistry";

interface Props {
  id: string;
  headers: string[];
  crud: CrudRegistryType;
  message: string;
  code?: number;
}
const { id, headers, crud, message, code } = Astro.props;
const topLevelTargetId = `top-level-error-${crud}-${id}`;
const fieldLevelTargetId = (fieldName: string) =>
  `field-error-${crud}-${id}-${fieldName}`;
---

<>
  <span id={topLevelTargetId} class="anim-vibrate" hx-swap-oob="outerHTML">
    {code ? `[CODE: ${code}] ` : ""}
    {message}
  </span>

  {
    headers.map((fieldName) => (
      <span
        id={fieldLevelTargetId(fieldName)}
        hx-swap-oob="outerHTML"
        class="field-error"
      />
    ))
  }
</>
