---
import InputField from "./InputField.astro";
import SubmitButton from "./SubmitButton.astro";
interface Props {
  otp: string | null;
  email: string | null;
  type: "sign-in" | "email-verification" | "forget-password";
}

const { otp, email, type } = Astro.props;

const formId = "check-verification-otp";
---

<form
  hx-post="/partials/auth/check-verification-otp"
  hx-target-error={`#${formId}-error`}
  hx-target={`#${formId}-success`}
  hx-swap="innerHTML"
  class="card theme c-primary"
>
  <legend>Confirm Verification Code</legend>
  <fieldset class="no-style">
    <InputField
      id={formId + "-code"}
      name={"otp"}
      label={"One Time Password"}
      model={"account"}
      type={"text"}
      required={true}
      value={otp}
    />
    {
      type === "forget-password" ? (
        <InputField
          id={formId + "-password"}
          name={"password"}
          label={"New Password"}
          model={"account"}
          type={"password"}
          required={true}
        />
      ) : null
    }
    <InputField
      id={formId + "-email"}
      name={"email"}
      model={"account"}
      type={"email"}
      required={true}
      value={email}
    />
    <InputField
      id={formId + "-type"}
      name={"type"}
      model={"account"}
      type={"text"}
      required={true}
      value={type}
    />
  </fieldset>
  <div class="row-error error top-level">
    <p class="message">
      <span id={`${formId}-error`}></span>
    </p>
  </div>
  <div id={`${formId}-success`}></div>
  <SubmitButton text="Verify" />
</form>
