---
// components/form/VerifyOneTimePassForm.astro
import FormCard from "./FormCard.astro";
import InputField from "./InputField.astro";

interface Props {
  id?: string;
  otp?: string | null;
  email?: string | null;
  type: "sign-in" | "email-verification" | "forget-password";
  redirectTo?: string; // where to land after success; validated server-side
}

const {
  id = "check-verification-otp",
  otp,
  email,
  type,
  redirectTo,
} = Astro.props;
---

<FormCard
  {id}
  method="post"
  endpoint="/partials/auth/check-verification-otp"
  submitText="Verify"
  class="theme c-primary"
>
  <h2>Confirm Verification Code</h2>

  <input type="hidden" name="type" value={type} />
  {redirectTo && <input type="hidden" name="redirectTo" value={redirectTo} />}

  {
    email ? (
      <>
        <input type="hidden" name="email" value={email} />
        <p>
          Code sent to <strong>{email}</strong>
        </p>
      </>
    ) : (
      <InputField
        id={`${id}-email`}
        name="email"
        type="email"
        model="accounts"
        required
      />
    )
  }

  <InputField
    id={`${id}-code`}
    name="otp"
    label="Code"
    type="text"
    model="accounts"
    required
    value={otp ?? undefined}
    inputmode="numeric"
    autocomplete="one-time-code"
    maxlength="6"
  />

  {
    type === "forget-password" && (
      <InputField
        id={`${id}-password`}
        name="password"
        label="New Password"
        type="password"
        model="accounts"
        required
        autocomplete="new-password"
      />
    )
  }
</FormCard>
