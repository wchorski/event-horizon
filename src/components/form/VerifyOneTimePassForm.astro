---
// components/form/VerifyOneTimePassForm.astro
import FormCard from "./FormCard.astro";
import InputField from "./InputField.astro";

interface Props {
  id?: string;
  otp?: string | null;
  email?: string | null;
  type: "sign-in" | "email-verification" | "forget-password";
  redirectTo?: string; // where to land after success; validated server-side
}

const {
  id = "check-verification-otp",
  otp,
  email,
  type,
  redirectTo,
} = Astro.props;
---

<FormCard
  {id}
  method="post"
  endpoint="/partials/auth/check-verification-otp"
  submitText="Verify"
  class="theme c-primary"
>
  <h2>Confirm Verification Code</h2>

  <input type="hidden" name="type" value={type} />
  {redirectTo && <input type="hidden" name="redirectTo" value={redirectTo} />}

  {email ? (
    <>
      <input type="text" name="email" value={email} />
      <p>
        Code sent to {' '}<code>{email}</code>
      </p>
    </>
  ) : (
    <InputField
      formId={id}
      name="email"
      type="email"
    />
  )}

  <InputField
    formId={id}
    name="otp"
    label="Code"
    type="text"

    value={otp ?? undefined}
    inputmode="numeric"
    autocomplete="one-time-code"
    maxlength="6"
  />

  {type === "forget-password" && (
    <InputField
      formId={id}
      name="password"
      label="New Password"
      type="password"

      autocomplete="new-password"
    />
  )}

  <fieldset slot="sub-actions" class="no-style">
    <button
      id="request-otp-btn"
      type="button"
      class="just-text"
      hx-post="/partials/auth/resend-verification-otp"
      hx-swap="outerHTML"
      hx-vals={JSON.stringify({ email })}
    >
      resend new code
    </button>
  </fieldset>
</FormCard>
