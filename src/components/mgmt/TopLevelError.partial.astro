---
// TopLevelError.partial.astro
import type { CrudRegistryType } from "@lib/crudRegistry";

interface Props {
  id: string;
  headers: string[];
  crud: CrudRegistryType;
  message: string;
}
const { id, headers, crud, message } = Astro.props;
---

<>
  <span
    id={`top-level-error-${crud}-${id}`}
    class="anim-vibrate"
    hx-swap-oob="outerHTML"
  >
    {message}
  </span>

  {
    headers.map((fieldName) => (
      <span
        id={`field-error-${crud}-${id}-${fieldName}`}
        hx-swap-oob="outerHTML"
        class="field-error"
      />
    ))
  }
</>
