---
const { pathname } = Astro.url;

const links = [
  { href: "/admin/events", label: "Events" },
  { href: "/admin/locations", label: "Locations" },
  { href: "/admin/users", label: "Users" },
  { href: "/admin/tickets", label: "Tickets" },
];
---

<div class="flex space-between">
  <nav class="main-menu">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={pathname.startsWith(link.href) ? "page" : undefined}
          class="link"
        >
          <span>{link.label}</span>
          {pathname.startsWith(link.href) ? (
            <span
              transition:name="active-span"
              style="view-transition-name: active-span"
              class="striped-corner"
            />
          ) : null}
        </a>
      ))
    }
  </nav>

  <div class="flex gap-m">
    <span class="pill c-primary">ADMIN</span>
    <div class="pill c-secondary">
      <span>PROTOTYPE</span>
      <br />
      <span>Using fake member data for testing.</span>
    </div>
  </div>
</div>
<style>
  nav.main-menu {
    color: white;
    display: flex;
    gap: 0.1rem;
    --c-link-bg: rgb(72, 95, 95);
  }

  a.link {
    background-color: var(--c-link-bg);
    border-width: 2px;
    border-style: solid;
    border-color: transparent;
    color: white;
    padding: 0.3rem 1rem;
    border-radius: 10px 10px 0 0;
    position: relative;
    /* border-top: 60px solid coral; */
    /* border-right: 60px solid transparent; */

    &:hover {
      background-color: var(--c-link-bg);
    }
  }
  a[aria-current="page"] {
    color: var(--c-active);
    background-color: transparent;
    border-color: var(--c-link-bg);
  }

  .striped-corner {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 20px;
    height: 20px;
    background: var(--c-link-bg);
    clip-path: polygon(100% 0, 0 100%, 100% 100%);
  }
</style>
