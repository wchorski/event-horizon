---
import type { auth } from "@lib/auth";
import type { MemberSelect, OrganizationSelect, UserSelect } from "@ty/Schema";
import type {
  SessionMember,
  SessionOrganization,
  SessionTeam,
  SessionUser,
} from "../../env";

interface Props {
  organization: SessionOrganization;
  user: SessionUser;
  member: SessionMember;
  teams: SessionTeam[] | null;
}

const { organization, user, member, teams = [] } = Astro.props;

const displayName = user
  ? user.name
    ? `${user.name} <${user.email}>`
    : (user.username ?? user.email)
  : "anonymous";
---

<header>
  <div class="flex gap-m space-between">
    <div>
      <h1>{organization?.name}</h1>
      <br />
      <a href=`/org/${organization?.slug}/`>Organization Dashboard</a>
    </div>
    <div>
      <img
        class="org-logo"
        src={organization?.logo}
        width="100"
        height="auto"
      />
      <br />
      <br />
      <span class="pill">
        <a href={`/dashboard`}>{displayName}</a>
      </span>
      <br />
      <span>org {member.role}</span>
      {
        teams && teams.length > 0 ? (
          <div>
            <ul class="unstyled flex gap-xs wrap">
              {teams.map((tm) => (
                <li class="pill">{tm.name}</li>
              ))}
            </ul>
          </div>
        ) : null
      }
    </div>
  </div>
</header>

<style>
  .org-logo {
    padding: var(--size-xs);
    background-color: hsla(0, 0%, 0%, 0.441);
  }
</style>
