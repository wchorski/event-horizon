const { start, end, desc, skill_id, group_id, id, note } = block;
---

<tr class={`time-block-row`}>
  <td>
    <InputField
      value={formatTimeMinutesToClockString(start)}
      type={"time"}
      name={"start"}
      id="timeline-start"
      model="time-block"
      data-id={id}
      label=""
    />
    <InputField
      value={formatTimeMinutesToClockString(end)}
      type={"time"}
      name={"end"}
      id={`timeline-block-${id}-start`}
      model="time-block"
      data-id={id}
      label=""
    />
  </td>

  <td>
    <InputField
      label=""
      value={desc}
      type={"text"}
      name="desc"
      id={`timeline-block-${id}-desc`}
      data-id={id}
      model="time-block"
    />
  </td>
  <td>
    <select name={"skill_id"} data-id={id}>
      {
        skills.map((skill) => (
          <option value={skill.id} selected={skill.id === skill_id}>
            {skill.name}
          </option>
        ))
      }
    </select>
  </td>
  <td>
    <a href={`#${group_id}`}>{group_id}</a>
  </td>
  <td>{note}</td>
</tr>
