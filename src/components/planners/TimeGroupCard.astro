---
import type { TimelineMoment, TimelineGroup } from "@ty/Schema";

interface Props {
  group: TimelineGroup;
  relatedBlocks: TimelineMoment[];
}
const { group, relatedBlocks } = Astro.props;
const { name, id } = group;
// const relatedPlans = blocks_template.filter((plan) => plan.group_id === id);
---

<div class="card" id={String(id)}>
  <h3>
    {name} | {id}
  </h3>
  {
    relatedBlocks.length > 0 ? (
      <ul>
        {relatedBlocks.map((block) => (
          <li>{block.desc}</li>
        ))}
      </ul>
    ) : (
      <p class="faded">no moments set</p>
    )
  }
</div>
