---
// components/tables/BookingManagemntRow
import type { BOOKING_STATUSES } from "@db/enums";
import type { BookingSelect, TimelineSelect } from "@ty/Schema";
import type { HTMLAttributes } from "astro/types";
import { prettyDateToLocale } from "@lib/formatters";
import type { BookingWithRelations } from "@lib/dbQueries/getUsers";

interface Props extends HTMLAttributes<"tr"> {
  row: BookingWithRelations;
  orgSlug?: string;
}

export type TBookingsManagementRow = BookingSelect & {
  clients: {
    id: string;
    name: string;
    email: string;
    emailVerified: boolean;
    status: typeof BOOKING_STATUSES;
  }[];
  location?: { id: string; name: string };
  timeline: TimelineSelect;
};
const { row, orgSlug, class: className, ...attrs } = Astro.props;
const { id, start, location, timeline, clients, status } = row;
const rowId = `bookings-row--${id}`;
const dateAndTime = prettyDateToLocale(start)
const clientLabel = (c: (typeof clients)[number]) =>
  row.status === 'ACCEPTED' && c ? c.name : c.email + `[${row.status}]`;
---

<tr id={rowId} class:list={[className]} {...attrs}>
  <td>{dateAndTime}</td>
  <td>
    <ul>
      {clients.map((c) => (
        <li>
          <span>
            {clientLabel(c)}
            {!c && <span class="badge">pending</span>}
          </span>
          {/* {!c.emailVerified && <span style="color: red;" data-verified={c.emailVerified}>
            email not verified
          </span>} */}
        </li>
      ))}
    </ul>
  </td>
  <td>{location?.name ?? <span class="no-data">-</span>}</td>
  <td>
    {timeline ? (
      <a href={`/timelines/${timeline.id}`}>timeline</a>
    ) : (
      <button class="just-text">create/connect</button>
    )}
  </td>
  <td><span data-status={status} class="status">{status}</span></td>
  <td>
    <button
      hx-get={`/partials/bookings/${encodeURIComponent(id)}/edit-form`}
      hx-target={"#edit-booking-wrap"}
    >
      edit
    </button>
  </td>
</tr>
