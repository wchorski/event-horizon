---
// components/tables/BookingManagementTable
import type { BookingWithRelations } from "@lib/getBookingsPage";
import BookingManagementRow from "./BookingManagementRow.astro";

interface Props {
  rows: BookingWithRelations[];
  orgSlug?: string;
}

const { rows, orgSlug } = Astro.props;
// console.log(JSON.stringify({rows},null,2));
---

<table class="color-alternate"> 
  <thead>
    <tr>
      <th>start</th>
      <th>clients</th>
      <th>location</th>
      <th>timeline</th>
      <th>action</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.length > 0 ? (
        rows.map((row) => <BookingManagementRow {row} {orgSlug} />)
      ) : (
        <tr> <td class='no-data'>-- no bookings found --</td></tr>
      )
    }
  </tbody>
</table>
