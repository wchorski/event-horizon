---
import type { MemberSelect, UserSelect } from "@ty/Schema";
import type { TMemberManagementRow } from "./MemberManagementRow.astro";
import MemberManagementRow from "./MemberManagementRow.astro";

interface Props {
  rows: TMemberManagementRow[];
  orgSlug: string;
}

const { rows, orgSlug } = Astro.props;
---

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>email</th>
      <th>role</th>
      <th>department(s)</th>
      <th>action</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.length > 0 ? (
        rows.map((row) => <MemberManagementRow {row} {orgSlug} />)
      ) : (
        <p>no members assigned</p>
      )
    }
  </tbody>
</table>
