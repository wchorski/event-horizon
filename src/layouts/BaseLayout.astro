---
interface Props {
  title?: string;
  excerpt?: string;
  classNames?: string;
}
import "@styles/global.css";
import "@styles/sizing.css";
import "@styles/colors.css";
import "@styles/form.css";
import "@styles/table.css";
import "@styles/typography.css";
import "@styles/animation.css";
import styles from "@styles/layout_reading.module.css";
import DialogConfirm from "@components/DialogConfirm.astro";
import { ClientRouter } from "astro:transitions";
import { UMAMI_PROXY_PREFIX } from "../middleware";

const { SITE_TITLE, SITE_EXCERPT, DOMAIN_URL, UMAMI_WEB_ID } = import.meta.env;
const {
  title = SITE_TITLE,
  excerpt = SITE_EXCERPT,
  classNames = styles.layout_reading,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{title}</title>
    <meta name="excerpt" content={excerpt} />
    <slot name="head" />

    <script>
      import "@client/htmx";
    </script>
    {
      UMAMI_WEB_ID && !import.meta.env.DEV ? (
        <script
          defer
          is:inline
          data-astro-rerun
          src={UMAMI_PROXY_PREFIX}
          data-website-id={UMAMI_WEB_ID}
          data-host-url={`${DOMAIN_URL}/assets/ramen`}
        />
      ) : <meta name="analytics" content="analytics were not loaded" />
    }
  </head>
  <body hx-ext="response-targets" class={classNames}>
    <slot name="header" />
    <slot name="nav" />
    <slot />
    <slot name="footer" />
    <DialogConfirm />
  </body>
</html>
