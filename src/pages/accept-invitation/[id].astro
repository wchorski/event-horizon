---
/* /pages/accept-invitation/[id].astro */
import { eq } from "drizzle-orm";
import { APIError } from "better-auth/api";
import { db } from "@db/db";
import { Invitation, User } from "@db/schema";
import { auth } from "@lib/auth";
import { signup } from "@lib/auth/signup";
import { login } from "@lib/auth/login";
import { authRedirect } from "@lib/auth/respond";
import { FormError, useForm } from "@lib/useForm";
import { emptyForm } from "@lib/form-state";
import { validate } from "@lib/validate";
import BaseLayout from "@layouts/BaseLayout.astro";
import VerifyOneTimePassForm from "@components/form/VerifyOneTimePassForm.astro";
import FormCard from "@components/form/FormCard.astro";
import InputField from "@components/form/InputField.astro";
import Footer from "@components/navigation/Footer.astro";

type State =
  "ready" | "wrong_user" | "accepted" | "rejected" | "canceled" | "expired";
type View = "signup" | "login" | "verify" | "accept";

/* ---------- 1. Load ---------- */

const { id } = Astro.params;
if (!id) {
  Astro.response.status = 400;
  throw new Error("Invitation ID was not provided");
}

const user = Astro.locals.user;
const formId = Astro.request.headers.get("HX-Trigger");
// avoids junk from client
if (!formId || !/^[\w-]+$/.test(formId))
  return new Response("Bad request", { status: 400 });

const invitation = await db.query.Invitation.findFirst({
  where: eq(Invitation.id, id),
  with: { organization: { columns: { name: true, slug: true, logo: true } } },
});
if (!invitation) return Astro.rewrite("/404");

const { organization, ...invite } = invitation;
const inviteEmail = invite.email.trim().toLowerCase();
const here = Astro.url.pathname;

/* ---------- 2. Invitation state ---------- */

let state: State = "ready";
if (invite.status === "accepted") state = "accepted";
else if (invite.status === "rejected") state = "rejected";
else if (invite.status === "canceled") state = "canceled";
else if (invite.expiresAt < new Date()) state = "expired";
else if (user && user.email.toLowerCase() !== inviteEmail) state = "wrong_user";

if (state === "wrong_user") Astro.response.status = 403;
if (state === "expired") Astro.response.status = 410;

/* ---------- 3. Which form to show ---------- */

const verifyRequested = Astro.url.searchParams.get("view") === "verify";

// Only look up the account when it can change the answer
const account =
  state === "ready" && !user && !verifyRequested
    ? await db.query.User.findFirst({
        where: eq(User.email, inviteEmail),
        columns: { id: true },
      })
    : null;

const view: View = user
  ? user.emailVerified
    ? "accept" // 3. logged in and verified
    : "verify" // unverified session
  : verifyRequested
    ? "verify" // after sign-up or login (1.b / 2.a)
    : account
      ? "login" // 2. account exists
      : "signup"; // 1.a no account yet

const allowedIntents: Record<View, string[]> = {
  signup: ["signup"],
  login: ["login"],
  verify: ["resend"],
  accept: ["accept"],
};

/* ---------- 4. POST handling ---------- */

let formState = emptyForm(); // every request starts clean

if (Astro.request.method === "POST" && state === "ready") {
  const form = await Astro.request.formData();
  const intent = String(form.get("_intent") ?? ""); // runForm strips "_" keys
  if (!allowedIntents[view].includes(intent)) {
    return new Response("Bad Request", { status: 400 });
  }

  const toVerify = `${here}?view=verify`;

  switch (intent) {
    case "signup": {
      const out = await useForm(form, {
        // email comes from the invitation, never from the client
        schema: validate.signup.omit({ email: true }),
        sensitive: ["password"],
        labels: { first_name: "first name", last_name: "last name" },
        run: (input) => signup({ ...input, email: inviteEmail }),
      });
      if (out.ok)
        return authRedirect(Astro.request, toVerify, out.data.setCookies);
      formState = out.state;
      break;
    }

    case "login": {
      const out = await useForm(form, {
        schema: validate.login.pick({ password: true }),
        sensitive: ["password"],
        run: (input) => login({ email: inviteEmail, password: input.password }),
      });
      if (out.ok) {
        return out.data.kind === "needs-verification"
          ? authRedirect(Astro.request, toVerify, []) // sendOnSignIn already sent a code
          : authRedirect(Astro.request, here, out.data.setCookies); // re-render as "accept"
      }
      formState = out.state;
      break;
    }

    case "resend": {
      const out = await useForm(form, {
        successMessage: "A new code is on its way.",
        run: () =>
          auth.api.sendVerificationOTP({
            body: { email: inviteEmail, type: "email-verification" },
          }),
      });
      formState = out.state;
      break;
    }

    case "accept": {
      // Session is re-checked on every POST, never trusted from the render
      if (!user?.emailVerified || user.email.toLowerCase() !== inviteEmail) {
        return new Response("Forbidden", { status: 403 });
      }
      const out = await useForm(form, {
        run: async () => {
          try {
            return await auth.api.acceptInvitation({
              body: { invitationId: id },
              headers: Astro.request.headers,
            });
          } catch (e) {
            if (e instanceof APIError) {
              throw new FormError(
                e.body?.message ?? e.message,
                e.statusCode ?? 400,
              );
            }
            throw e; // runForm logs it and returns a generic 500
          }
        },
      });
      if (out.ok)
        return authRedirect(Astro.request, `/org/${organization.slug}`, []);
      formState = out.state;
      break;
    }
  }

  Astro.response.status = formState.status;
}

/* ---------- 5. Copy for blocked states ---------- */

const blocked: Record<
  Exclude<State, "ready">,
  { title: string; body: string }
> = {
  wrong_user: {
    title: "Wrong account",
    body: `You're signed in as ${user?.email ?? "another account"}, but this invitation was sent to ${invite.email}. Sign out and continue with the invited email address.`,
  },
  accepted: {
    title: "Already accepted",
    body: "This invitation has already been accepted.",
  },
  rejected: {
    title: "Invitation declined",
    body: "This invitation was declined and can no longer be used.",
  },
  canceled: {
    title: "Invitation canceled",
    body: `${organization.name} canceled this invitation. Ask them to send a new one.`,
  },
  expired: {
    title: "Invitation expired",
    body: `This invitation expired on ${invite.expiresAt.toLocaleDateString("en-US", { dateStyle: "long" })}. Ask ${organization.name} to send a new one.`,
  },
};
---

<BaseLayout>
  <header slot="header" class="flex space-between gap-l">
    <div>
      <h1>{state === "ready" ? "You're Invited!" : blocked[state].title}</h1>
      {
        state === "ready" && (
          <p>
            {organization.name} is inviting you to become a {invite.role} of the
            organization.
          </p>
        )
      }
    </div>
    {
      organization.logo && (
        <img
          src={organization.logo}
          alt={`${organization.name} logo`}
          width="200"
          height="auto"
        />
      )
    }
  </header>

  <main>
    {
      state !== "ready" ? (
        <div class="card" role="status">
          <p>{blocked[state].body}</p>

          {state === "wrong_user" && (
            <form
              method="post"
              action={`/sign-out?returnTo=${encodeURIComponent(here)}`}
            >
              <button type="submit" class="button">
                Sign Out
              </button>
            </form>
          )}

          {state === "accepted" && (
            <a href={`/org/${organization.slug}`} class="button">
              Go to {organization.name}
            </a>
          )}
        </div>
      ) : (
        <section class="card" aria-labelledby="onboarding-title">
          <p>
            Invitation for <strong>{invite.email}</strong>
          </p>

          {view === "signup" && (
            <FormCard
              id="invite-signup-form"
              submitText="Create account"
              state={formState}
            >
              <h2 id="onboarding-title">Create your account</h2>
              <input type="hidden" name="_intent" value="signup" />
              <InputField
                formId={formId}
                name="first_name"
                type="text"
                value={formState.values.first_name}
                error={formState.fieldErrors.first_name}
              />
              <InputField
                formId={formId}
                name="last_name"
                type="text"
                value={formState.values.last_name}
                error={formState.fieldErrors.last_name}
              />
              <InputField
                formId={formId}
                name="password"
                type="password"
                required
                error={formState.fieldErrors.password}
              />
            </FormCard>
          )}

          {view === "login" && (
            <FormCard
              id="invite-login-form"
              submitText="Sign in"
              state={formState}
            >
              <h2 id="onboarding-title">Sign in to accept</h2>
              <input type="hidden" name="_intent" value="login" />
              <InputField
                formId={formId}
                name="password"
                type="password"
                required
                error={formState.fieldErrors.password}
              />
            </FormCard>
          )}

          {view === "verify" && (
            <>
              <h2 id="onboarding-title">Verify your email</h2>
              <VerifyOneTimePassForm
                email={inviteEmail}
                redirectTo={here}
                type="email-verification"
              />
              <FormCard
                id="invite-resend-form"
                submitText="Resend code"
                state={formState}
              >
                <input type="hidden" name="_intent" value="resend" />
              </FormCard>
            </>
          )}

          {view === "accept" && (
            <FormCard
              id="invite-accept-form"
              submitText="Join Organization"
              state={formState}
            >
              <h2 id="onboarding-title">Accept your invitation</h2>
              <input type="hidden" name="_intent" value="accept" />
            </FormCard>
          )}
        </section>
      )
    }
  </main>

  <Footer slot="footer" />
</BaseLayout>
