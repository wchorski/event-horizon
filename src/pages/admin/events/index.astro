---
import ButtonCoursesImport from "@components/ButtonCoursesImport.astro";
import EventsEditableTable from "@components/EventsEditableTable.astro";
import AdminNav from "@components/navigation/AdminNav.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getEventsPage } from "@lib/getEventsPage";
import PaginationNav from "@components/navigation/PaginationNav.astro";
import TableMenu from "@components/tables/TableMenu.astro";
import FilterSelect from "@components/form/FilterSelect.astro";
const { SITE_TITLE } = import.meta.env;
const { WORDPRESS_ENDPOINT } = import.meta.env;

const params = Astro.url.searchParams;
const rawLocation = params.get("location_id");

if (params.has("location_id") && rawLocation === "") {
  return Astro.redirect(Astro.url.pathname);
}

const location_id = rawLocation ?? undefined;

const ALLOWED_PER_PAGE = [5, 10, 25, 50, 100];
const DEFAULT_PER_PAGE = 25;

let perPageParam = DEFAULT_PER_PAGE;
const page = parseInt(params.get("page") || "1");
const rawPerPage = params.get("perPage");

if (rawPerPage !== null) {
  const n = Number(rawPerPage);

  if (ALLOWED_PER_PAGE.includes(n)) {
    perPageParam = n;
  } else {
    params.delete("perPage");
    return Astro.redirect(`${Astro.url.pathname}?${params.toString()}`);
  }
}

const result = await getEventsPage({
  page,
  perPage: perPageParam,
  location_id,
});

if ("redirect" in result) {
  return Astro.redirect("/admin/events");
}

const { events, locations, perPage, totalCount, totalPages } = result;
// SEO metadata
const pageTitle = page === 1 ? "Events" : `Events - Page ${page}`;
---

<BaseLayout>
  <Fragment slot="head">
    <title>{pageTitle} | {SITE_TITLE}</title>
  </Fragment>
  <script type="module" src="/src/client/tablePerPage.ts"></script>

  <AdminNav />
  <main>
    <header class="flex space-between">
      <h1>Events - Page {page}</h1>
      <div>
        <ButtonCoursesImport />
        <a href={WORDPRESS_ENDPOINT + "/events"}>View Wordpress Events</a>
      </div>
    </header>
    <div data-layout="content" class="content">
      <div class="callout warning">
        <p>
          Created/Updated Events here will create/update an accompanying
          Wordpress event set as DRAFT. To become viewable on the <a
            href={WORDPRESS_ENDPOINT + "/wp-admin/edit.php?post_type=event"}
            >Wordpress site</a
          >, it must be set to PUBLISH.
        </p>
      </div>
      <hr />

      <TableMenu
        page={page}
        perPage={perPage}
        model="events"
        placeholder={"Search by subject, excerpt, or numerical date..."}
      >
        <fieldset slot="filters-fieldset">
          <FilterSelect
            name="location_id"
            options={locations.map((loc) => ({
              value: loc.id,
              label: loc.name,
            }))}
            value={location_id}
            model="locations"
          />
        </fieldset>
      </TableMenu>

      {
        locations.length === 0 ? (
          <p>
            No locations set. First create a location on the{" "}
            <a href="/attendance/admin/locations">locations page</a>
          </p>
        ) : (
          <EventsEditableTable events={events} locations={locations} />
        )
      }

      {
        events.length > 0 ? (
          <PaginationNav
            path="/admin/events"
            page={page}
            perPage={perPage}
            totalCount={totalCount}
          />
        ) : null
      }
    </div>
  </main>
</BaseLayout>
