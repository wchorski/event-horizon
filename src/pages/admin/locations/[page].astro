---
import LocationsEditableTable from "@components/LocationsEditableTable.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getLocationsPage } from "@lib/getLocationsPage";
import PaginationNav from "@components/navigation/PaginationNav.astro";
import AdminNav from "@components/navigation/AdminNav.astro";
import TableMenu from "@components/tables/TableMenu.astro";
const page = Number(Astro.params.page);
const params = Astro.url.searchParams;

const ALLOWED_PER_PAGE = [5, 10, 25, 50, 100];
const DEFAULT_PER_PAGE = 25;

let perPageParam = DEFAULT_PER_PAGE;
const rawPerPage = params.get("perPage");

if (rawPerPage !== null) {
  const n = Number(rawPerPage);

  if (ALLOWED_PER_PAGE.includes(n)) {
    perPageParam = n;
  } else {
    params.delete("perPage");
    return Astro.redirect(`${Astro.url.pathname}?${params.toString()}`);
  }
}

const result = await getLocationsPage({ page: 1, perPage: perPageParam });

if ("redirect" in result) {
  return Astro.redirect("/attendance/admin/locations");
}

const { locations, perPage, totalCount, totalPages } = result;
---

<BaseLayout>
  <script type="module" src="/src/client/tablePerPage.ts"></script>
  <AdminNav />
  <main>
    <header class="flex space-between">
      <h1>Locations - Page {page}</h1>
    </header>
    <div data-layout="content" class="content">
      <TableMenu
        page={page}
        perPage={perPage}
        model="locations"
        placeholder={"Search by name, excerpt, or address..."}
      />
      <LocationsEditableTable locations={locations} />

      {
        locations.length > 0 ? (
          <PaginationNav
            path="/attendance/admin/locations"
            page={Number(page)}
            perPage={perPage}
            totalCount={totalCount}
          />
        ) : null
      }
    </div>
  </main>
</BaseLayout>
