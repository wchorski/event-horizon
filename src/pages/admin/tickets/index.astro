---
import AdminNav from "@components/navigation/AdminNav.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PaginationNav from "@components/navigation/PaginationNav.astro";
import CreditsEditableTable from "@components/CreditsEditableTable.astro";
import { getTicketsPage } from "@lib/getTicketsPage";
import TableMenu from "@components/tables/TableMenu.astro";
const { SITE_TITLE } = import.meta.env;
const params = Astro.url.searchParams;

const ALLOWED_PER_PAGE = [5, 10, 15, 25, 50, 100];
const DEFAULT_PER_PAGE = 25;

let perPageParam = DEFAULT_PER_PAGE;
const page = parseInt(params.get("page") || "1");
const rawPerPage = params.get("perPage");

if (rawPerPage !== null) {
  const n = Number(rawPerPage);

  if (ALLOWED_PER_PAGE.includes(n)) {
    perPageParam = n;
  } else {
    params.delete("perPage");
    return Astro.redirect(`${Astro.url.pathname}?${params.toString()}`);
  }
}
const result = await getTicketsPage(1, perPageParam);

if ("redirect" in result) {
  return Astro.redirect("/admin/tickets");
}

const { tickets, events, users, perPage, totalCount, totalPages } = result;

// SEO metadata
const pageTitle = page === 1 ? "Tickets" : `Tickets - Page ${page}`;
---

<BaseLayout>
  <Fragment slot="head">
    <title>{pageTitle} | {SITE_TITLE}</title>
  </Fragment>
  <script type="module" src="/src/client/tablePerPage.ts"></script>

  <AdminNav />
  <main>
    <header>
      <h1>Tickets - Page {page}</h1>
      <p class="sub-text">List of all tickets from all events.</p>
    </header>
    <div data-layout="content" class="content">
      <TableMenu
        page={page}
        perPage={perPage}
        model="tickets"
        placeholder={"Search tickets by user:NAME, course:SUBJECT"}
      />
      <CreditsEditableTable tickets={tickets} events={events} users={users} />
      {
        tickets ? (
          <PaginationNav
            path="/admin/tickets"
            page={page}
            perPage={perPage}
            totalCount={totalCount}
          />
        ) : null
      }
    </div>
  </main>
</BaseLayout>
