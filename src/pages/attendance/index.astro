---
import { getEventsPage } from "@lib/getEventsPage";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventsList from "@components/EventsList.astro";
const result = await getEventsPage({page: 1});

if ("redirect" in result) {
  return Astro.redirect("/attendance");
}

const { events = [], page, perPage, totalCount, totalPages } = result;
---

<BaseLayout>
  <main>
    <h1>Attendance</h1>
    <h2>Event List</h2>
    {events ? <EventsList events={events} /> : <p>no events found</p>}
  </main>
</BaseLayout>
