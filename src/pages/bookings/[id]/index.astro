---
interface Params {
  id: string;
}
import { db } from "@db/db";
import { User, Ticket, Event, Location, Booking } from "@db/schema";
import { eq } from "drizzle-orm";
import BaseLayout from "@layouts/BaseLayout.astro";
import AdminNav from "@components/navigation/AdminNav.astro";
import TableEditable from "@components/TableEditable.astro";
import { crud } from "@lib/crudRegistry";
import { TEST_ADMIN_SESSION } from "@lib/auth/session";
import { formatPhonePrettyManual, prettyDateToLocale } from "@lib/formatters";
import CourseCreditsEditableTable from "@components/CourseCreditsEditableTable.astro";
import { bookingSummary } from "@lib/virtualFields";
import AddressOfLocation from "@components/AddressOfLocation.astro";
import ArticleOfUserInfo from "@components/ArticleOfUserInfo.astro";
import SiteNav from "@components/navigation/SiteNav.astro";
export const prerender = false; // Not needed in 'server' mode
const { id } = Astro.params;

if (!id) {
  return new Response(null, { status: 404 });
}

const booking = await db.query.Booking.findFirst({
  where: eq(Booking.id, id),
  // where: and(...conditions),
  with: {
    assignments: {
      with: {
        user: true,
        role: true,
      },
    },
    client: true,
    location: true,
  },
});

if (!booking) {
  return new Response(null, { status: 404 });
}

const { start, status, end, client, notes, location, assignments } = booking;
const summary = bookingSummary(booking, client);
// const locations = await crud.locations.readMany(session);
---

<BaseLayout>
  <SiteNav />
  <main>
    <header>
      <h1>
        {summary}
      </h1>
      <dl class="kv">
        <dd>Status</dd>
        <dt><span class="status" data-status={status}>{status}</span></dt>
        <dd>start</dd>
        <dt>
          <time datetime={start.toString()}>
            {prettyDateToLocale(start)}
          </time>
        </dt>
        <dd>end</dd>
        <dt>
          <time datetime={end.toString()}>
            {prettyDateToLocale(end)}
          </time>
        </dt>
      </dl>

      <br />
      <br />
      {location ? <AddressOfLocation location={location} /> : null}

      <a href={`./${id}/edit`} class="edit-tab">
        <svg
          width="30px"
          height="30px"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path opacity="0.15" d="M8 16H12L18 10L14 6L8 12V16Z" fill="#000000"
          ></path>
          <path
            d="M14 6L8 12V16H12L18 10M14 6L17 3L21 7L18 10M14 6L18 10M10 4L4 4L4 20L20 20V14"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span> Edit </span>
      </a>
    </header>
    <hr />
    <div data-layout="content">
      <h2>Client</h2>
      {
        client ? (
          <ArticleOfUserInfo user={client} />
        ) : (
          <p class="callout">No client set</p>
        )
      }

      <hr />
      <h2>Assignments</h2>
      {
        assignments
          .map((a) => a.user)
          .map((user) => <ArticleOfUserInfo user={user} />)
      }
      <p class="notes">
        {notes}
      </p>
      <hr />
    </div>
  </main>
</BaseLayout>

<style>
  main {
    padding: 1rem;
  }

  h1 {
    anchor-name: --heading;
    width: fit-content;
  }

  .user-info {
    display: flex;
    gap: 2rem;
  }

  .edit-tab {
    position: absolute;
    position-anchor: --heading;
    top: anchor(top); /* aligns to h1's top edge */
    right: anchor(right); /* aligns to h1's right edge */
    transform: translate(100%, 0%); /* nudge outside the corner */
  }
</style>
