---
import CommonPageLayout from "@layouts/CommonPageLayout.astro";
import BookingRequestForm from "@components/BookingRequestForm.astro";
import { getLocationsPage } from "@lib/getLocationsPage";
import { getUsersPage } from "@lib/getUsersPage";
import { location as Location } from "@db/schema";

const { user: author } = Astro.locals;
const returnTo = Astro.url.pathname + Astro.url.search;

if (!author) {
  return Astro.redirect(
    `/login?msg=${encodeURIComponent("Must have an account create bookings. Login to return to booking page")}&returnTo=${encodeURIComponent(returnTo)}`,
  );
}

const timelineId = Astro.url.searchParams.get("timelineId");
const start = Astro.url.searchParams.get("start");

const { users } = await getUsersPage({ page: 1, perPage: 200 });
const usersOptions = users?.map((usr) => ({
  value: usr.id,
  label: `${usr.firstName} ${usr.lastName} <${usr.email}>`,
}));
// const { locations } = await getLocationsPage({ page: 1, perPage: 25 });
// const locations = await Astro.locals.rls((tx) =>
//   tx.query.location.findMany({
//     // where: { id: bookingId },
//     // with: { location: true },
//   }),
// );
const locations = await Astro.locals.rls((tx) =>
  tx.select().from(Location).orderBy(Location.name),
);
const locationOptions = locations?.map((loc) => ({
  value: loc.id,
  label: `${loc.name} <${loc.address}>`,
}));

//? handled with html slot instead
// locationOptions?.unshift({ value: "", label: "-- select location --" });
---

<CommonPageLayout>
  <main>
    <header class="display none">
      <h1>Request a Booking</h1>
    </header>

    <div data-layout="content" class="content">
      <h2>debug locations</h2>
      <ul>
        {locations?.map((loc) => (
          <li>{loc.name}</li>
        ))}
      </ul>
      <BookingRequestForm
        userOptions={usersOptions}
        locationOptions={locationOptions}
        authorUserId={author.id}
        timelineId={timelineId}
        start={start}
      />
    </div>
  </main>
</CommonPageLayout>
