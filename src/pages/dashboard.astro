---
// pages/dashboard.astro
import BookingArticleQuickView from "@components/BookingArticleQuickView.astro";
import CommonPageLayout from "@layouts/CommonPageLayout.astro";
import MiniPaginationControls from "@components/navigation/MiniPaginationControls.astro";
import { getBookingsPage } from "@lib/getBookingsPage";
import { SITE_TITLE } from "astro:env/client";

const user = Astro.locals.user;

if (user === null) return Astro.redirect("/login");
if (!user) throw new Error("Must be logged in to view page");

const page = Number(Astro.url.searchParams.get("bookings_page") ?? 1);
const msg = Astro.url.searchParams.get("msg");

const { bookings, totalPages } = await getBookingsPage({
  author_user_id: user.id,
  page,
  perPage: 3,
});
---

<CommonPageLayout title={`Dashboard | ${SITE_TITLE}`}>
  <header>
    <h1 class="etched-line">Dashboard</h1>
    {msg ? <p class="callout">{msg}</p> : null}
  </header>
  <div data-layout="content">
    <div class="flex gap-m flex-align-center">
      <h2>Upcoming Bookings</h2>
      <MiniPaginationControls
        id="bookings-pagination"
        paramKey="bookings_page"
        page={page}
        totalPages={totalPages || 1}
        partialUrl="/partials/bookings/article-list"
        pageUrl="/dashboard"
        target="#bookings-list"
      />
    </div>
    <ul id="bookings-list" class="unstyled grid auto-fill gap-s">
      {
        bookings ? (
          bookings.map((bk) => (
            <li>
              <BookingArticleQuickView booking={bk} />
            </li>
          ))
        ) : (
          <li class="callout ghost">no bookings found</li>
        )
      }
    </ul>
  </div>
</CommonPageLayout>
