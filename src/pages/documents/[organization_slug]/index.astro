---
// pages/documents/index
import type { Event } from "@microsoft/microsoft-graph-types";
import type { DriveItem } from "@microsoft/microsoft-graph-types";
import { msAuthentication } from "@lib/auth/msAuthentication";
import { parseDriveCrumbs } from "@lib/driveNav";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import DriveItemsTable from "@components/DriveItemsTable.astro";
import SubmitButton from "@components/form/SubmitButton.astro";
import InputField from "@components/form/InputField.astro";
import { isDayFolder } from "@lib/dayFolderCheck";
import { db } from "@db/db";
import { and, eq } from "drizzle-orm";
import { MeetingPacket, Organization } from "@db/schema";
import Footer from "@components/navigation/Footer.astro";
import { GraphApiError, msGraphFetch } from "@lib/microsoft/msGraphFetch";
import { prettyDateToLocale } from "@lib/formatters";
import { createCalendarDraft, outlookTimeZoneHeader, resolveMeetingTimeZone } from "@lib/calendarFactory";

const { organization_slug } = Astro.params;
if (!organization_slug) throw new Error("no id found. throw 404");

console.log({organization_slug});

try {
  const org = await db.query.Organization.findFirst({
    where: eq(Organization.slug, organization_slug)
  })

  console.log({org});

  // TODO set the org vars 
//   {
//   org: {
//     id: '01a09194-09ff-7d63-9c55-d0096b02db89',
//     name: 'Midwest Operating Engineers',
//     slug: 'moe',
//     logo: 'https://local150.org/wp-content/uploads/2020/06/moe-logo.png',
//     createdAt: 2026-05-01T21:06:36.444Z,
//     updatedAt: 2026-05-01T21:06:36.444Z,
//     metadata: null,
//     dedicated_db_url: null,
//     color: '#738793',
//     color_2: '#0873b1',
//     sharepoint_site_url: 'https://moeits.sharepoint.com/sites/MOEDocs',
//     sharepoint_site_id: 'moeits.sharepoint.com,fd7cc296-d084-4604-941a-bdc70e6195e4,a20a733c-1f92-4c6f-8415-7469223ee708',
//     sharepoint_drive_id: 'b!lsJ8_YTQBEaUGr3HDmGV5DxzCqKSH29MhBV0aSI-5wjanyzd4OQnQKS3XpK0w3l4',
//     sharepoint_library_name: null
//   }
// }

// TODO figure out auth, access, and permissions
} catch (err) {
  console.log('❌ Org: ', err);
}

const { TENANT_ID, MS_CLIENT_ID, MS_SECRET_VALUE, MS_SHAREPOINT_MOEDOCS_DRIVE_ID,
  MS_SHAREPOINT_MOEDOCS_SITE_ID,
  MS_MAILBOX_USER_EMAIL, } = import.meta.env;

const site_id =
  MS_SHAREPOINT_MOEDOCS_SITE_ID;
const drive_id =
  MS_SHAREPOINT_MOEDOCS_DRIVE_ID;
const mailbox_user_email = MS_MAILBOX_USER_EMAIL

// This page's own path — used to build "back to this folder" links
const basePath = "/documents";
let parentFolderId = null;
let packet = null;
let outlookEvent = null;
let isDayFldr = false;

// Current folder comes from the URL; no itemId means "at the root"
const folderId = Astro.url.searchParams.get("itemId");
const crumbs = parseDriveCrumbs(Astro.url.searchParams.get("crumbs"));

const url = folderId
  ? `https://graph.microsoft.com/v1.0/sites/${site_id}/drives/${drive_id}/items/${folderId}/children`
  : `https://graph.microsoft.com/v1.0/sites/${site_id}/drives/${drive_id}/root/children`;

interface DriveChildrenResponse {
  "@odata.context": string;
  "@odata.nextLink"?: string;
  value: DriveItem[];
}

// TODO(locations-schema): once MeetingPacket/folder carries a location_id,
// pass it here instead of null.
const meetingTimeZone = await resolveMeetingTimeZone(null);
let calendarDraft = createCalendarDraft({}, meetingTimeZone);
let items: DriveItem[] = [];
let error: string | null = null;

try {
  packet = folderId
    ? await db.query.MeetingPacket.findFirst({
        where: and(
          eq(MeetingPacket.sharepoint_drive_id, drive_id),
          eq(MeetingPacket.sharepoint_folder_id, folderId),
        ),
      })
    : null;

    // console.log({packet});

  if (packet?.outlook_event_id) {
    try {
      outlookEvent = await msGraphFetch<Event>(
        `/users/${mailbox_user_email}/events/${packet.outlook_event_id}`,
        { method: "GET", headers: outlookTimeZoneHeader(meetingTimeZone) },
      );

      // console.log({outlookEvent});

      if (outlookEvent) {
        calendarDraft = createCalendarDraft(
          {
            subject: outlookEvent.subject ?? calendarDraft.subject,
            start: outlookEvent.start?.dateTime
              ? { dateTime: outlookEvent.start.dateTime, timeZone: meetingTimeZone }
              : calendarDraft.start,
            end: outlookEvent.end?.dateTime
              ? { dateTime: outlookEvent.end.dateTime, timeZone: meetingTimeZone }
              : calendarDraft.end,
            location: outlookEvent.location ?? calendarDraft.location,
            body: outlookEvent.body ?? calendarDraft.body,
          },
          meetingTimeZone,
        );
      }
    } catch (graphErr) {
      const isMissingEvent =
        graphErr instanceof GraphApiError &&
        graphErr.status === 404 &&
        graphErr.code === "ErrorItemNotFound";

      if (isMissingEvent) {
        // The event was deleted/moved in Outlook — the packet's link is stale.
        // Clear it so the UI falls back to "Create" instead of showing a dead link.
        await db
          .update(MeetingPacket)
          .set({ outlook_event_id: null, outlook_web_link: null })
          .where(eq(MeetingPacket.id, packet.id));

        packet.outlook_event_id = null;
        packet.outlook_web_link = null;
        outlookEvent = null;
        // calendarDraft stays as the CST default — no re-populate needed
      } else {
        throw graphErr; // anything else (auth, throttling, network) is a real failure
      }
    }
  }
} catch (err) {
  console.log("❌ packet error; ", err);
}

try {
  const accessToken = await msAuthentication(
    TENANT_ID,
    MS_CLIENT_ID,
    MS_SECRET_VALUE,
  );

  const res = await fetch(url, {
    method: "GET",
    headers: { Authorization: `Bearer ${accessToken}` },
  });

  if (!res.ok) {
    const text = await res.text();
    throw new Error(`Request failed: ${res.status} ${res.statusText}\n${text}`);
  }

  const data: DriveChildrenResponse = await res.json();
  items = data.value ?? [];
  parentFolderId = folderId;
  const firstItem = items[0];

  if (firstItem) {
    const path = firstItem.parentReference?.path;
    if (!path) throw new Error("path does not exist");

    const afterRoot = path.split("root:")[1] ?? "";
    const rootPath = afterRoot.replace(/^\/+/, ""); // strip a leading slash if present, no-op if absent
    const parts = rootPath ? rootPath.split("/") : [];

    const department = parts.at(-3); // MOEITS Board
    const year = parts.at(-2);       // 2026
    const monthDay = parts.at(-1);   // 09-15

    if (department && year && monthDay) {
      isDayFldr = isDayFolder([{ name: year }, { name: monthDay }]);
      if (isDayFldr) {
        calendarDraft = createCalendarDraft({
          subject: `${department} | BOT Meeting`,
          start: { dateTime: `${year}-${monthDay}T07:00`, timeZone:meetingTimeZone },
          end: { dateTime: `${year}-${monthDay}T09:00`, timeZone:meetingTimeZone },
          
        }, meetingTimeZone);
      }
    }
  }
} catch (err) {
  console.error(err);
  error = err instanceof Error ? err.message : String(err);
}

const formMethodEndpoint = outlookEvent
  ? {
      "hx-patch": `/partials/events/outlook-event/${packet?.outlook_event_id}`,
    }
  : { "hx-post": "/partials/events/outlook-event" };
---

<BaseLayout>
  <main>
    <header>
      <h1>Documents</h1>
      <Breadcrumbs crumbs={crumbs} basePath={basePath} />
    </header>

    <div data-layout="content">
      {isDayFldr ? <>
    
    <hr />
    <section class="flex gap-m">
      
        {
          packet?.outlook_event_id && outlookEvent ? (
            <div class="card">
              <h2>Event:</h2>
              <dl class="kv">
                <dd>Subject</dd>
                <dt>{outlookEvent.subject}</dt>
                <dd>Start</dd>
                <dt>{outlookEvent.start?.dateTime ? prettyDateToLocale(new Date(outlookEvent.start.dateTime)) : "—"}</dt>
                <dd>End</dd>
                <dt>{outlookEvent.end?.dateTime ? prettyDateToLocale(new Date(outlookEvent.end.dateTime)) : "—"}</dt>
                <dd>location</dd>
                <dt>{outlookEvent.location?.displayName ?? "—"}</dt>
                <dd>onlineMeeting</dd>
                <dt>{String(outlookEvent.onlineMeeting)}</dt>
                <dd>isOnlineMeeting</dd>
                <dt>{String(outlookEvent.isOnlineMeeting)}</dt>
                <dd>onlineMeetingProvider</dd>
                <dt>{outlookEvent.onlineMeetingProvider}</dt>
                <dd>onlineMeetingUrl</dd>
                <dt>{String(outlookEvent.onlineMeetingUrl)}</dt>
              </dl>
              <a href={outlookEvent.webLink} target="_blank">
                outlook link
              </a>
            </div>
          ) : null
        }

        <form
          class="card"
          {...formMethodEndpoint}
          hx-swap="innerHTML"
          hx-target="#outlook-event-result"
          hx-target-error="#outlook-calendar-error"
        >
          <h2>{packet?.outlook_event_id ? "Update" : "Create"} Calendar Event</h2>
          <fieldset>
            <InputField
              name="subject"
              id="calendar.subject"
              type="text"
              model="event"
              value={calendarDraft.subject}
            />
            <InputField
              name="start.dateTime"
              id="calendar.start.dateTime"
              type="datetime-local"
              model="event"
              value={calendarDraft.start.dateTime}
            />
            <InputField
              name="end.dateTime"
              id="calendar.end.dateTime"
              type="datetime-local"
              model="event"
              value={calendarDraft.end.dateTime}
            />

            <!-- fixed values the user doesn't edit, but still need to reach the server -->
            <input
              type="hidden"
              name="start.timeZone"
              value={calendarDraft.start.timeZone}
            />
            <input
              type="hidden"
              name="end.timeZone"
              value={calendarDraft.end.timeZone}
            />
            <input
              type="hidden"
              name="body.contentType"
              value={calendarDraft.body.contentType}
            />
            <input
              type="hidden"
              name="body.content"
              value={calendarDraft.body.content}
            />
            <input
              type="hidden"
              name="location.displayName"
              value={calendarDraft.location.displayName}
            />
            <input
              type="hidden"
              name="transactionId"
              value={calendarDraft.transactionId}
            />

            <input type="hidden" name="folderId" value={parentFolderId} />
   

            {
              calendarDraft.attendees.map((a, i) => (
                <>
                  <input
                    type="hidden"
                    name={`attendees[${i}].emailAddress.address`}
                    value={a.emailAddress?.address ?? ""}
                  />
                  <input
                    type="hidden"
                    name={`attendees[${i}].emailAddress.name`}
                    value={a.emailAddress?.name ?? ""}
                  />
                  <input
                    type="hidden"
                    name={`attendees[${i}].type`}
                    value={a.type}
                  />
                </>
              ))
            }
          </fieldset>
          <div id="outlook-event-result"></div>
          <div id="outlook-calendar-error"></div>
          <SubmitButton />
        </form>

      

      <form
        class="card"
        hx-post="/partials/pdf-packet-builder"
        hx-swap="outerHTML"
        hx-target="this"
        hx-target-error="#pdf-packet-builder-error"
      >
        <h2>PDF Packet Builder</h2>
        <input type="hidden" name="folderId" value={parentFolderId} />

        <div id="pdf-packet-builder-error"></div>
        {
          packet?.published_file_url ? (
            <p>
              view published packet {" "}
              <a href={packet.published_file_url} target="_blank">
                {packet.published_file_url.split('/')[packet.published_file_url.split('/').length - 1]}
              </a>
            </p>
          ) : null
        }
        <SubmitButton text="Generate New Packet" />
      </form>
    </section>
    </> : null}
    <hr />
      {error && <p style="color: red;">Error: {error}</p>}

      {
        !error && (
          <DriveItemsTable items={items} crumbs={crumbs} basePath={basePath} />
        )
      }
    </div>
  </main>
  <Footer />
</BaseLayout>
