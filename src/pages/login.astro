---
// src/pages/login.astro
import PasswordResetForm from "@components/auth/PasswordResetForm.astro";
import SocialProviderLoginForm from "@components/auth/SocialProviderLoginForm.astro";
import Dialog from "@components/Dialog.astro";
import FormCard from "@components/form/FormCard.astro";
import InputField from "@components/form/InputField.astro";
import SubmitButton from "@components/form/SubmitButton.astro";
import VerifyOneTimePassForm from "@components/form/VerifyOneTimePassForm.astro";
import CommonPageLayout from "@layouts/CommonPageLayout.astro";
import { login } from "@lib/auth/login";
import { safeReturnTo } from "@lib/auth/respond";
import { runForm } from "@lib/form-action";
import { emptyForm } from "@lib/form-state";
import { validate } from "@lib/validate";
import { authRedirect } from "@lib/auth/respond";

const params = Astro.url.searchParams;
const returnToUrl = params.get("returnTo");
const returnTo = safeReturnTo(params.get("returnTo"));
const msg = params.get("msg");
const email = params.get("email");
const isReset = params.get("password-reset");
const otp = params.get("otp");
const otpType = params.get("type") as
  "sign-in" | "email-verification" | "forget-password" | null;
const session = Astro.locals.session;
const user = Astro.locals.user;
let error: string | null = null;
let notice: string | null = null;
let needsVerification = false;
let verifyEmail: string | null = null;

let state = emptyForm();

// TODO do i need a trycatch here?
if (Astro.request.method === "POST") {
  const outcome = await runForm(await Astro.request.formData(), {
    schema: validate.login,
    sensitive: ["password"],
    // labels: { first_name: "first name", last_name: "last name" },
    // successMessage: "Login Successful!",
    run: login,
  });

  if (outcome.ok) {
    const result = outcome.data;

    if (result.kind === "needs-verification") {
      const q = new URLSearchParams({
        email: result.email,
        type: "email-verification",
        msg: `We sent a verification code to ${result.email}.`,
      });
      if (returnTo) q.set("returnTo", returnTo); // keep the destination through verification
      return authRedirect(Astro.request, `/login?${q}`, []);
    }

    return authRedirect(
      Astro.request,
      returnTo ??
        `/dashboard?msg=${encodeURIComponent("Login successful! Welcome.")}`,
      result.setCookies,
    );
  }

  state = outcome.state;
  Astro.response.status = state.status;
}
---

<CommonPageLayout title={"Login"}>
  <header>
    <h1 class="display none">Login</h1>
    {msg ? <p class="callout warning">{msg}</p> : null}
  </header>
  <div data-layout="content" class="grid gap-m max-w-s">
    {
      session && user ? (
        <p class="callout">
          You are currently logged in as <br />
          <strong>
            {`${user.first_name} ${user.last_name} <${user.email}>`}{" "}
          </strong>
        </p>
      ) : null
    }
    <FormCard id="login-form" submitText="Login" {state}>
      <h2>Login</h2>
      <InputField
        name="email"
        type="email"
        id="email"
        model="accounts"
        required
        value={state.values.email ?? email ?? undefined}
        fieldError={state.fieldErrors.email}
      />
      <InputField
        name="password"
        type="password"
        id="password"
        model="accounts"
        required
        fieldError={state.fieldErrors.password}
      />
    </FormCard>

    <p><a href="?password-reset=true" data-astro-reload>Forgot Password?</a></p>

    <hr />

    <SocialProviderLoginForm provider="github" />
    <SocialProviderLoginForm provider="microsoft" />

    <Dialog modal id="dialog-password-reset" open={isReset} clearParams={["password-reset"]}>
      <PasswordResetForm email={email} />
    </Dialog>

    <Dialog modal id="dialog-otp" open={otpType ? true : false}>
      {msg ? <p class="callout warning">{msg}</p> : null}
      <VerifyOneTimePassForm
        otp={otp}
        email={email ? decodeURIComponent(email) : null}
        type={otpType ?? "forget-password"}
      />
    </Dialog>
  </div>
</CommonPageLayout>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>(
    "form[data-lock-on-submit]",
  );

  forms.forEach((form) => {
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!btn) return;

    // The submit event only fires after native validation passes
    form.addEventListener("submit", () => {
      btn.disabled = true;
      btn.setAttribute("aria-busy", "true");
    });
  });

  // Back button restores the page from bfcache with the button still locked
  window.addEventListener("pageshow", (e) => {
    if (!e.persisted) return;
    forms.forEach((form) => {
      const btn = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      );
      btn?.removeAttribute("disabled");
      btn?.removeAttribute("aria-busy");
    });
  });
</script>
