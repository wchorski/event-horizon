---
// src/pages/login.astro
import SocialProviderLoginForm from "@components/auth/SocialProviderLoginForm.astro";
import Dialog from "@components/Dialog.astro";
import InputField from "@components/form/InputField.astro";
import SubmitButton from "@components/form/SubmitButton.astro";
import VerifyOneTimePassForm from "@components/form/VerifyOneTimePassForm.astro";
import CommonPageLayout from "@layouts/CommonPageLayout.astro";
import { login } from "@lib/auth/login";
import type { LoginCredentials } from "@ty/Auth";

const params = Astro.url.searchParams;
const returnToUrl = params.get("returnTo");
const msg = params.get("msg");
const email = params.get("email");
const otp = params.get("otp");
const type = params.get("type") as
  "sign-in" | "email-verification" | "forget-password" | null;
const session = Astro.locals.session;
const user = Astro.locals.user;
let error: string | null = null;
let notice: string | null = null;
let needsVerification = false;
let verifyEmail: string | null = null;

// TODO do i need a trycatch here?
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  // @ts-ignore
  const payload = Object.fromEntries(formData.entries()) as LoginCredentials;

  const result = await login({
    ...payload,
    callbackURL: returnToUrl ?? undefined,
  });

  // TODO this is just a type error. i should handle login errors, notices, messages better and put them into the types
  if (result.code === "EMAIL_NOT_VERIFIED") {
    needsVerification = true;
    verifyEmail = payload.email;
    notice = `A new verification code has been sent to ${payload.email}. Follow the instructions sent to your inbox.`;
  } else {
    error = result.error;
  }

  if (result.success) {
    const redirectResponse = new Response(null, {
      status: 302,
      headers: {
        Location: returnToUrl
          ? returnToUrl
          : `/dashboard?msg=${encodeURIComponent("Login Successful! Welcome.")}`,
      },
    });
    for (const cookie of result.setCookies) {
      redirectResponse.headers.append("set-cookie", cookie);
    }
    return redirectResponse;
  }

  error = result.error;
}
---

<CommonPageLayout>
  <header>
    <h1 class="display none">Login</h1>
    {msg ? <p class="callout warning">{msg}</p> : null}
  </header>
  <div data-layout="content" class="grid gap-m max-w-s">
    {
      session && user ? (
        <p class="callout">
          You are currently logged in as <br />
          <strong>
            {`${user.first_name} ${user.last_name} <${user.email}>`}{" "}
          </strong>
        </p>
      ) : null
    }
    <form class="card" id="sign-up-form" method="POST" data-lock-on-submit>
      <legend>Login</legend>
      <InputField
        name="email"
        type={"email"}
        id="email"
        model={"accounts"}
        required={true}
      />
      <InputField
        name="password"
        type={"password"}
        id="password"
        model={"accounts"}
        required={true}
      />
      {
        error && (
          <p class="form-error error callout" role="alert">
            {error}
          </p>
        )
      }
      {
        notice && (
          <p class="callout success" role="status">
            {notice}
          </p>
        )
      }

      <SubmitButton text="Login" />
    </form>

    <form
      class="card"
      hx-post="/partials/auth/password-reset-request"
      hx-target={this}
      hx-target-error={`#password-reset-error`}
      hx-swap="outerHTML"
    >
      <legend>Request Password Reset</legend>
      <InputField
        name="email"
        type={"email"}
        id="password-reset"
        model={"accounts"}
        required={true}
        value={email}
      />
      <div class="row-error error top-level">
        <p class="message">
          <span id={`password-reset-error`}></span>
        </p>
      </div>

      <SubmitButton text="Request Code" />
    </form>

    <hr />

    <SocialProviderLoginForm provider="github" />
    <SocialProviderLoginForm provider="microsoft" />

    <Dialog modal id="dialog-otp" open={otp ? true : false}>
      <VerifyOneTimePassForm
        otp={otp}
        email={email ? decodeURIComponent(email) : null}
        type={type ?? "forget-password"}
      />
    </Dialog>
  </div>
</CommonPageLayout>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>(
    "form[data-lock-on-submit]",
  );

  forms.forEach((form) => {
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!btn) return;

    // The submit event only fires after native validation passes
    form.addEventListener("submit", () => {
      btn.disabled = true;
      btn.setAttribute("aria-busy", "true");
    });
  });

  // Back button restores the page from bfcache with the button still locked
  window.addEventListener("pageshow", (e) => {
    if (!e.persisted) return;
    forms.forEach((form) => {
      const btn = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      );
      btn?.removeAttribute("disabled");
      btn?.removeAttribute("aria-busy");
    });
  });
</script>
