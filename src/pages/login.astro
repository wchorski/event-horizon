---
// src/pages/login.astro
import SocialProviderLoginForm from "@components/auth/SocialProviderLoginForm.astro";
import Dialog from "@components/Dialog.astro";
import InputField from "@components/form/InputField.astro";
import SubmitButton from "@components/form/SubmitButton.astro";
import VerifyOneTimePassForm from "@components/form/VerifyOneTimePassForm.astro";
import CommonPageLayout from "@layouts/CommonPageLayout.astro";
import { login } from "@lib/auth/login";
import type { LoginCredentials } from "@ty/Auth";

const params = Astro.url.searchParams;
const returnToUrl = params.get("returnTo");
const msg = params.get("msg");
const email = params.get("email");
const otp = params.get("otp");
const session = Astro.locals.session;
const user = Astro.locals.user;
let error: string | null = null;

// TODO do i need a trycatch here?
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  // @ts-ignore
  const payload = Object.fromEntries(formData.entries()) as LoginCredentials;

  const result = await login({
    ...payload,
    callbackURL: returnToUrl ?? undefined,
  });

  if (result.success) {
    const redirectResponse = new Response(null, {
      status: 302,
      headers: {
        Location: returnToUrl
          ? returnToUrl
          : `/dashboard?msg=${encodeURIComponent("Login Successful! Welcome.")}`,
      },
    });
    for (const cookie of result.setCookies) {
      redirectResponse.headers.append("set-cookie", cookie);
    }
    return redirectResponse;
  }

  error = result.error;
}
---

<CommonPageLayout>
  <header>
    <h1 class="display none">Login</h1>
    {msg ? <p class="callout warning">{msg}</p> : null}
  </header>
  <div data-layout="content" class="grid gap-m max-w-s">
    {
      session && user ? (
        <p class="callout">
          You are currently logged in as <br />
          <strong>
            {`${user.first_name} ${user.last_name} <${user.email}>`}{" "}
          </strong>
        </p>
      ) : null
    }
    <form class="card" id="sign-up-form" method="POST">
      <legend>Login</legend>
      <InputField
        name="email"
        type={"email"}
        id="email"
        model={"accounts"}
        required={true}
      />
      <InputField
        name="password"
        type={"password"}
        id="password"
        model={"accounts"}
        required={true}
      />

      {
        error && (
          <p class="form-error error callout" role="alert">
            {error}
          </p>
        )
      }
      <SubmitButton text="Login" />
    </form>

    <form
      class="card"
      hx-post="/partials/auth/password-reset-request"
      hx-target={this}
      hx-target-error={`#password-reset-error`}
      hx-swap="outerHTML"
    >
      <legend>Request Password Reset</legend>
      <InputField
        name="email"
        type={"email"}
        id="password"
        model={"accounts"}
        required={true}
        value={email}
      />
      <div class="row-error error top-level">
        <p class="message">
          <span id={`password-reset-error`}></span>
        </p>
      </div>

      <SubmitButton text="Request Code" />
    </form>

    <hr />

    <SocialProviderLoginForm provider="github" />
    <SocialProviderLoginForm provider="microsoft" />

    <Dialog modal id="dialog-otp" open={otp ? true : false}>
      <VerifyOneTimePassForm
        otp={otp}
        email={email ? decodeURIComponent(email) : null}
      />
    </Dialog>
  </div>
</CommonPageLayout>
