---
import IntegrationCredForm from "@components/form/IntegrationCredForm.astro";
import InviteMemberForm from "@components/form/InviteMemberForm.astro";
import MemberManagementTable from "@components/tables/MemberManagementTable.astro";
import { db } from "@db/db";
import { IntegrationCredential, Member } from "@db/schema";
import CommonPageLayout from "@layouts/CommonPageLayout.astro";
import OrgMemberPageLayout from "@layouts/OrgMemberPageLayout.astro";
import { eq } from "drizzle-orm";

const { organization_slug } = Astro.params;
const search = Astro.url.searchParams;
const msg = search.get("msg");
const { user, organization, member } = Astro.locals;

const returnTo = Astro.url.pathname + Astro.url.search;

if (!user)
  return Astro.redirect(`/login?returnTo=${encodeURIComponent(returnTo)}`);
if (!organization)
  return Astro.redirect(`/org-not-found?slug=${organization_slug}`);
if (!member)
  return Astro.redirect(
    `/not-authorized?msg=${encodeURIComponent("you are not a member of this org: " + organization_slug)}`,
  );

const members = await db.query.Member.findMany({
  where: eq(Member.organizationId, organization.id),
  with: {
    user: true,
  },
});

// TODO only pull some fields like provider and expire (not secret or other sensative info)
const orgIntegrations = await db.query.IntegrationCredential.findMany({
  where: eq(IntegrationCredential.organizationId, organization.id),
});
---

<OrgMemberPageLayout title={organization.name + " | Organization"}>
  {msg ? <p class="callout warning">{msg}</p> : null}
  <p>
    <a
      class="btn l"
      href=`/org/${organization.slug}/documents`
      style="font-size: 2rem;"
    >
      <svg
        width="3rem"
        height="3rem"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M18 6.00002V6.75002H18.75V6.00002H18ZM15.7172 2.32614L15.6111 1.58368L15.7172 2.32614ZM4.91959 3.86865L4.81353 3.12619H4.81353L4.91959 3.86865ZM5.07107 6.75002H18V5.25002H5.07107V6.75002ZM18.75 6.00002V4.30604H17.25V6.00002H18.75ZM15.6111 1.58368L4.81353 3.12619L5.02566 4.61111L15.8232 3.0686L15.6111 1.58368ZM4.81353 3.12619C3.91638 3.25435 3.25 4.0227 3.25 4.92895H4.75C4.75 4.76917 4.86749 4.63371 5.02566 4.61111L4.81353 3.12619ZM18.75 4.30604C18.75 2.63253 17.2678 1.34701 15.6111 1.58368L15.8232 3.0686C16.5763 2.96103 17.25 3.54535 17.25 4.30604H18.75ZM5.07107 5.25002C4.89375 5.25002 4.75 5.10627 4.75 4.92895H3.25C3.25 5.9347 4.06532 6.75002 5.07107 6.75002V5.25002Z"
          fill="currentColor"></path>
        <path
          d="M8 12H16"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
        <path
          d="M8 15.5H13.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
        <path
          d="M4 6V19C4 20.6569 5.34315 22 7 22H17C18.6569 22 20 20.6569 20 19V14M4 6V5M4 6H17C18.6569 6 20 7.34315 20 9V10"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
      Packet Builder
    </a>
  </p>

  <hr />

  <section class="grid gap-m">
    <div>
      <h2>Members</h2>
      <MemberManagementTable members={members} />
    </div>
    <aside style="max-width: 20rem;">
      <InviteMemberForm
        organizationId={organization.id}
        organizationSlug={organization.slug}
      />
    </aside>
  </section>

  <hr />

  <details>
    <summary>Integrations</summary>
    <p class="callout">This is for developers only</p>
    <ul>
      {
        orgIntegrations.length > 0 ? (
          orgIntegrations.map((integ) => (
            <li>
              {integ.provider} | expires: {integ.expiresAt}
            </li>
          ))
        ) : (
          <li>no integrations set</li>
        )
      }
    </ul>
    <div style="max-width: 30rem;">
      <IntegrationCredForm
        organizationId={organization.id}
        organizationSlug={organization.slug}
      />
    </div>
  </details>
</OrgMemberPageLayout>
