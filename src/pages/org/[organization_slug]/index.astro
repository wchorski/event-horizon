---
import IntegrationCredForm from "@components/form/IntegrationCredForm.astro";
import InviteMemberForm from "@components/form/InviteMemberForm.astro";
import MemberManagementTable from "@components/tables/MemberManagementTable.astro";
import { db } from "@db/db";
import { IntegrationCredential, Member, MEMBER_ROLES, User } from "@db/schema";
import OrgMemberPageLayout from "@layouts/OrgMemberPageLayout.astro";
import { auth } from "@lib/auth";
import { eq, inArray } from "drizzle-orm";
import IconPacket from "@icons/packet.svg";
import IconAdd from "@icons/add.svg";
import IconEnvelope from "@icons/envelope.svg";
import CreateTeamForm from "@components/form/CreateTeamForm.astro";
import Dialog from "@components/Dialog.astro";
import EditMemberForm from "@components/form/EditMemberForm.astro";

const params = Astro.url.searchParams;
const msg = params.get("msg");
const { organization_slug } = Astro.params;
const editMemberId = params.get("edit-member-id");
const { user, organization, member } = Astro.locals;
// TODO check if the slug matches the current organization, if not then switch active org
const memberRoleOptions = MEMBER_ROLES.map((text) => ({
  label: text,
  value: text,
})).reverse();

const returnTo = Astro.url.pathname + Astro.url.search;

if (!user)
  return Astro.redirect(`/login?returnTo=${encodeURIComponent(returnTo)}`);
if (!organization)
  return Astro.redirect(`/org-not-found?slug=${organization_slug}`);
if (!member)
  return Astro.redirect(
    `/not-authorized?msg=${encodeURIComponent("you are not a member of this org: " + organization_slug)}`,
  );

const headers = Astro.request.headers;

// TODO am i doing too many queries?
const { members, total: memberTotal } = await auth.api.listMembers({
  query: {
    organizationId: organization.id, // An optional organization ID to list members for. If not provided, will default to the user's active organization.
    // TODO paginate
    limit: 100, // The limit of members to return.
    offset: 0, // The offset to start from.
    sortBy: "createdAt", // The field to sort by.
    sortDirection: "desc", // The direction to sort by.
    // filterField: "status", // The field to filter by.
    // filterOperator: "not_in", // The operator to filter by.
    // filterValue: "accepted", // The value to filter by.
  },
  // This endpoint requires session cookies.
  headers,
});

const invites = await auth.api.listInvitations({
  query: {
    organizationId: organization.id, // An optional ID of the organization to list invitations for. If not provided, will default to the user's active organization.
  },
  // This endpoint requires session cookies.
  headers,
});

const ctx = await auth.$context;

const teams = await auth.api.listOrganizationTeams({
  query: { organizationId: organization.id },
  headers,
});
const teamById = new Map(teams.map((t) => [t.id, t]));
const userIds = members.map((m) => m.userId);

// TODO how should i auth permission this?
const rows =
  teamById.size && userIds.length
    ? await ctx.adapter.findMany<{ teamId: string; userId: string }>({
        model: "teamMember",
        where: [
          { field: "teamId", operator: "in", value: [...teamById.keys()] },
          { field: "userId", operator: "in", value: userIds },
        ],
        limit: 10_000, // adapters apply a default limit, so set one explicitly
      })
    : [];

// TODO another query auth to worry about
const usersVerified = await db.query.User.findMany({
  where: inArray(User.id, userIds),
  columns: {
    id: true,
    emailVerified: true,
  },
});

// group by user
const teamsByUserId = new Map<string, { id: string; name: string }[]>();
for (const r of rows) {
  const team = teamById.get(r.teamId);
  if (!team) continue;
  const list = teamsByUserId.get(r.userId) ?? [];
  list.push({ id: team.id, name: team.name });
  teamsByUserId.set(r.userId, list);
}

const memberTableRows = members.map((m) => ({
  ...m,
  user: {
    ...m.user,
    emailVerified:
      usersVerified.find((usr) => usr.id === m.user.id)?.emailVerified ?? false,
  },
  teams: teamsByUserId.get(m.userId) ?? [],
}));

// TODO only pull some fields like provider and expire (not secret or other sensative info)
const orgIntegrations = await db.query.IntegrationCredential.findMany({
  where: eq(IntegrationCredential.organizationId, organization.id),
});
---

<OrgMemberPageLayout title={organization.name + " | Organization"}>
  {msg ? <p class="callout warning">{msg}</p> : null}
  <p>
    <a
      class="btn l"
      href=`/org/${organization.slug}/documents`
      style="font-size: 2rem;"
    >
      <IconPacket />
      Documents & Packet Builder
    </a>
  </p>

  <hr />

  <section class="flex gap-m table-wrap">
    <div>
      <h2>Members ({memberTotal})</h2>
      <MemberManagementTable
        rows={memberTableRows}
        orgSlug={organization.slug}
      />
    </div>
    <aside class="grid gap-m">
      <div id="edit-member-wrap"></div>
    </aside>
  </section>
  <hr />
  <div class="flex gap-m">
    <InviteMemberForm
      organizationId={organization.id}
      organizationSlug={organization.slug}
    >
      <IconEnvelope slot={"icon"} />
    </InviteMemberForm>
    <div class="card">
      <h2>Invites Sent</h2>
      {
        invites.length > 0 ? (
          <ul id="org-invitations-list" class="unstyled grid gap-s">
            {invites
              .filter((inv) => !["accepted", "canceled"].includes(inv.status))
              .map((inv) => (
                <li
                  id={`org-invite-${inv.id}`}
                  class="flex gap-s"
                  style="align-items: center;"
                >
                  <span class="email">{inv.email}</span>
                  <span class="role">{inv.role}</span>
                  <span class="status" data-status={inv.status}>
                    {inv.status}
                  </span>
                  <button
                    hx-delete={`/org/${organization.slug}/partials/invite-member/cancel/${inv.id}`}
                    hx-swap="outerHTML"
                  >
                    cancel
                  </button>
                </li>
              ))}
          </ul>
        ) : (
          <p class="callout no-data">no invitations in circulation</p>
        )
      }
    </div>
  </div>
  <hr />
  <div class="flex gap-m">
    <CreateTeamForm
      organizationId={organization.id}
      organizationSlug={organization.slug}
    >
      <IconAdd slot="icon" />
    </CreateTeamForm>
    <div class="card">
      <h2>Teams</h2>
      {
        teams.length > 0 ? (
          <ul id="org-teams-list">
            {teams.map((tm) => (
              <li id={`org-team-${tm.id}`} class="flex gap-s">
                <span class="nam">{tm.name}</span>
                <button
                  class="danger critical"
                  hx-delete={`/org/${organization.slug}/partials/teams/${tm.id}?organizationId=${organization.id}`}
                  hx-swap="outerHTML"
                >
                  remove
                </button>
              </li>
            ))}
          </ul>
        ) : (
          <p class="callout no-data">no teams have been created</p>
        )
      }
    </div>
  </div>

  <hr />

  <details>
    <summary>Integrations</summary>
    <p class="callout">This is for developers only</p>
    <ul>
      {
        orgIntegrations.length > 0 ? (
          orgIntegrations.map((integ) => (
            <li>
              {integ.provider} | expires: {integ.expiresAt}
            </li>
          ))
        ) : (
          <li>no integrations set</li>
        )
      }
    </ul>
    <div style="max-width: 30rem;">
      <IntegrationCredForm
        organizationId={organization.id}
        organizationSlug={organization.slug}
      />
    </div>
  </details>
</OrgMemberPageLayout>

