---
import IntegrationCredForm from "@components/form/IntegrationCredForm.astro";
import InviteMemberForm from "@components/form/InviteMemberForm.astro";
import { db } from "@db/db";
import { IntegrationCredential, Member } from "@db/schema";
import CommonPageLayout from "@layouts/CommonPageLayout.astro";
import { eq, or } from "drizzle-orm";

const { organization_slug } = Astro.params;
const search = Astro.url.searchParams;
const msg = search.get("msg");
const { user, organization, member } = Astro.locals;

const returnTo = Astro.url.pathname + Astro.url.search;

if (!user)
  return Astro.redirect(`/login?returnTo=${encodeURIComponent(returnTo)}`);
if (!organization)
  return Astro.redirect(`/org-not-found?slug=${organization_slug}`);
if (!member)
  return Astro.redirect(
    `/not-authorized?msg=${encodeURIComponent("you are not a member of this org: " + organization_slug)}`,
  );

const members = await db.query.Member.findMany({
  where: eq(Member.organizationId, organization.id),
  with: {
    user: true,
  },
});

// TODO only pull some fields like provider and expire (not secret or other sensative info)
const orgIntegrations = await db.query.IntegrationCredential.findMany({
  where: eq(IntegrationCredential.organizationId, organization.id),
});
---

<CommonPageLayout title={organization.name + " | Organization"}>
  {msg ? <p class="callout warning">{msg}</p> : null}
  <h1>{organization.name}</h1>
  <p>{user.email} | {member.role}</p>
  <p>
    <a class="btn" href=`./${organization.slug}/documents`
      >Documents and Packet Builder</a
    >
  </p>

  <section class="grid gap-m auto-fit">
    <div>
      <h2>Members</h2>
      <ul>
        {
          members.length > 0 ? (
            members.map(({ user, ...member }) => {
              return (
                <li>
                  {user.first_name} {user.last_name} {`<${user.email}>`}{" "}
                  <span class="pill">{member.role}</span>
                </li>
              );
            })
          ) : (
            <li>no members belong to this organization</li>
          )
        }
      </ul>
    </div>
    <aside>
      <InviteMemberForm
        organizationId={organization.id}
        organizationSlug={organization.slug}
      />
    </aside>
  </section>

  <section>
    <h2>Integrations</h2>
    <ul>
      {
        orgIntegrations.length > 0 ? (
          orgIntegrations.map((integ) => (
            <li>
              {integ.provider} | expires: {integ.expiresAt}
            </li>
          ))
        ) : (
          <li>no integrations set</li>
        )
      }
    </ul>
    <div style="max-width: 30rem;">
      <IntegrationCredForm
        organizationId={organization.id}
        organizationSlug={organization.slug}
      />
    </div>
  </section>
</CommonPageLayout>
