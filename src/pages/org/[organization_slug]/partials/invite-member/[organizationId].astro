---
// pages/org/partials/invite-member/:organizationId
import FieldErrors from "@components/form/FieldErrors.astro";
import FormMessage from '@components/form/FormMessasge.astro'
import { inviteMember } from "@lib/crud/inviteMember";
import { useForm } from "@lib/useForm";
import { validate } from "@lib/validate";
import type { MemberRoles } from "@ty/Schema";

if (Astro.request.method !== "POST")
  return new Response(null, { status: 405, headers: { Allow: "POST" } });

const { user } = Astro.locals;
if (!user) return new Response(null, { status: 401 });

const { organizationId } = Astro.params;
if (!organizationId) return new Response("Bad request", { status: 400 });

const formId = Astro.request.headers.get("HX-Trigger");
// avoids junk from client
if (!formId || !/^[\w-]+$/.test(formId))
  return new Response("Bad request", { status: 400 });

const formData = await Astro.request.formData();
const outcome = await useForm(formData, {
  schema: validate.invitation,
  labels: { email: "email", role: "role" },
  successMessage: "Invitation sent",
  run: (input) =>
    inviteMember({ ...input, organizationId }, Astro.request.headers),
});

if (!outcome.ok) Astro.response.status = outcome.state.status ?? 422;
---

{
  outcome.ok ? (
    <>
      <FormMessage kind="success" message={outcome.state.success}>
        to <strong>{outcome.data.email}</strong>
      </FormMessage>
      <ul hx-swap-oob="beforeend:#org-invitations-list">
        <li class="anim--fadein">
          {outcome.data.email} <small>({outcome.data.role}, pending)</small>
        </li>
      </ul>
    </>
  ) : (
    <FormMessage kind="error" message={outcome.state.error} status={outcome.state.status} />
  )
}
<FieldErrors
  {formId}
  names={Object.keys(validate.invitation.shape)}
  errors={outcome.ok ? {} : outcome.state.fieldErrors}
/>
