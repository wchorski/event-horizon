---
// src/pages/org/:slug/partials/outlook-event/:id
import type {
  Event,
  Attendee,
  ItemBody,
  Location,
  DateTimeTimeZone,
} from "@microsoft/microsoft-graph-types";
import { db } from "@db/db";
import { MeetingPacket } from "@db/schema";
import { validate } from "@lib/validate";
import {
  BadRequestError,
  ForbiddenError,
} from "@lib/errors";
import { unflatten } from "@lib/formParsing";
import { eq } from "drizzle-orm";
import { msGraphFetch } from "@lib/microsoft/msGraphFetch";
import {
  outlookTimeZoneHeader,
  resolveMeetingTimeZone,
} from "@lib/calendarFactory";
import { auth } from "@lib/auth";
import { useForm } from "@lib/useForm";
import FormMessage from "@components/form/FormMessage.astro";
import FieldErrors from "@components/form/FieldErrors.astro";

type OutlookEventSummary = Pick<Event, "id" | "webLink">;

if (Astro.request.method !== "PATCH") {
  return new Response(null, { status: 405, headers: { Allow: "PATCH" } });
}

const { id: eventId } = Astro.params; // present only on the PATCH route
if (!eventId) throw new BadRequestError("eventId is required.");

const formData = await Astro.request.formData();
const input = unflatten(formData);

const outcome = await useForm(input, {
  schema: validate.outlookEvent,
  labels: { subject: "subject" },
  successMessage: "Outlook event updated",
  // i'm just pulling out transactionId cuz i'm too lazy to conditionally set in frontend...
  run: async ({ folderId, transactionId, ...updateFields }) => {
    const { organization, member } = Astro.locals;
    if (!organization || !member) {
      throw new ForbiddenError("You are not authorized for this organization.");
    }
    // Authorize first, inside run, so a ForbiddenError renders in the form
    const { success: canUpdateCalendar } = await auth.api.hasPermission({
      headers: Astro.request.headers,
      body: {
        organizationId: organization.id, // be explicit rather than relying on the "active" org
        permissions: { calendar: ["update"] },
      },
    });

    if (!canUpdateCalendar)
      throw new ForbiddenError("not allowed to create calendar events");

    const meetingTimeZone = await resolveMeetingTimeZone(null);

    const { mailbox_user_email, sharepoint_drive_id, sharepoint_site_id } =
      organization;
    if (!mailbox_user_email || !sharepoint_drive_id || !sharepoint_site_id)
      throw new BadRequestError(
        "mailbox and or sharepoint api not setup for organization",
      );

    const url = `/users/${mailbox_user_email}/events/${eventId}`;
    const updated = await msGraphFetch<OutlookEventSummary>(
      organization.id,
      url,
      {
        method: "PATCH",
        headers: outlookTimeZoneHeader(meetingTimeZone),
        body: JSON.stringify(updateFields),
      },
    );

    // Keep the packet's cached webLink in sync, in case it ever changes.
    if (folderId) {
      await db
        .update(MeetingPacket)
        .set({ outlook_web_link: updated.webLink })
        .where(eq(MeetingPacket.sharepoint_folder_id, folderId));
    }

    return {
      eventId: updated.id!,
      webLink: updated.webLink,
    };
  },
});

if (!outcome.ok) Astro.response.status = outcome.state.status ?? 422;

const errorMessage = outcome.ok
  ? ""
  : (outcome.state.error ??
    Object.values(outcome.state.fieldErrors ?? {})[0] ??
    "Something went wrong.");

const formId = Astro.request.headers.get("HX-Trigger");
// avoids junk from client
if (!formId || !/^[\w-]+$/.test(formId))
  return new Response("Bad request", { status: 400 });
---

{
  outcome.ok ? (
    <FormMessage kind="success" message={outcome.state.success}>
      {outcome.data.webLink && (
        <p>
          <a href={outcome.data.webLink}>Open event in Outlook</a>
        </p>
      )}
    </FormMessage>
  ) : (
    <FormMessage
      kind="error"
      message={errorMessage}
      status={outcome.state.status}
    />
  )
}
<FieldErrors
  {formId}
  names={Object.keys(validate.invitation.shape)}
  errors={outcome.ok ? {} : outcome.state.fieldErrors}
/>