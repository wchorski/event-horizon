---
// pages/org/:slug/partials/teams/:id
import { auth } from "@lib/auth";
type Removed = {
  message: string;
};
const method = Astro.request.method;
let removed: Removed | null = null;
// if (method !== "POST")
//   return new Response(null, { status: 405, headers: { Allow: "POST" } });
const { organization_slug, id } = Astro.params;
const organizationId = Astro.url.searchParams.get("organizationId");
if (!organization_slug || !id || !organizationId)
  return new Response("Bad request", { status: 400 });

if (method === "DELETE") {
  removed = await auth.api.removeTeam({
    body: {
      teamId: id, // required, The team ID of the team to remove.
      organizationId, // The organization ID which the team falls under. If not provided, it will default to the user's active organization.
    },
  });
}
---

{
  removed ? (
    <li id={`org-team-${id}`} hx-swap-oob="outerHTML" class="danger">
      <span class="danger">{removed.message}</span>
    </li>
  ) : (
    <p class="error">refresh page and try again</p>
  )
}
