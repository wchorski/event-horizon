---
// pages/partials/auth/check-verification-otp.astro
import { z } from "astro/zod"; // same zod copy as validate.ts
import { auth } from "@lib/auth";
import { FormError, useForm } from "@lib/useForm";
import { authRedirect, safeReturnTo } from "@lib/auth/respond";

if (Astro.request.method !== "POST") {
  return new Response("Only POST is allowed", { status: 405 });
}

const schema = z
  .object({
    otp: z.string().trim().regex(/^\d{6}$/, "Enter the 6-digit code"),
    email: z.string().trim().toLowerCase().pipe(z.email("Enter a valid email")),
    type: z.enum(["sign-in", "email-verification", "forget-password"]),
    password: z.string().min(8, "Password must be at least 8 characters").max(128).optional(),
    redirectTo: z.string().optional(),
  })
  .refine((d) => d.type !== "forget-password" || !!d.password, {
    path: ["password"],
    message: "Enter a new password",
  });

type Input = z.output<typeof schema>;

async function verify({ otp, email, type, password, redirectTo }: Input) {
  const dest = safeReturnTo(redirectTo ?? null);

  if (type === "email-verification") {
    const { headers, response } = await auth.api.verifyEmailOTP({
      body: { email, otp },
      returnHeaders: true,
    });
    if (!response.status) throw new FormError("That code is invalid or expired.", 400);
    return {
      setCookies: headers.getSetCookie(),
      dest: dest ?? `/dashboard?${new URLSearchParams({ msg: "Email verified. Welcome!" })}`,
    };
  }

  if (type === "forget-password") {
    const reset = await auth.api.resetPasswordEmailOTP({
      body: { email, otp, password: password! },
    });
    if (!reset.success) throw new FormError("That code is invalid or expired.", 400);
    return {
      setCookies: [],
      dest: `/login?${new URLSearchParams({ msg: "Password updated. Please log in." })}`,
    };
  }

  // "sign-in" is not handled by this endpoint yet
  throw new FormError("Unsupported verification type.", 400);
}

const outcome = await useForm(await Astro.request.formData(), {
  schema,
  sensitive: ["otp", "password"],
  run: verify,
});

if (outcome.ok) {
  return authRedirect(Astro.request, outcome.data.dest, outcome.data.setCookies);
}

// One message area on this form: show the first field error if there is one
const message = Object.values(outcome.state.fieldErrors)[0] ?? outcome.state.error ?? "";
Astro.response.status = outcome.state.status;
---

<p class="form-error error callout" role="alert">{message}</p>