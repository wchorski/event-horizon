---
// pages/partials/auth/password-reset-request.astro
type PasswordResetFields = {
  email: string;
};
import VerifyOneTimePassForm from "@components/form/VerifyOneTimePassForm.astro";
import { auth } from "@lib/auth";
import { BadRequestError } from "@lib/errors";

if (Astro.request.method !== "POST")
  return new Response("only POST method is allowed", { status: 405 });

let error = null;
let email = null;

try {
  const formData = await Astro.request.formData();
  const payload = Object.fromEntries(formData.entries()) as PasswordResetFields;
  const { email: eml } = payload;
  if (!eml) throw new BadRequestError("otp was not provided");

  const data = await auth.api.requestPasswordResetEmailOTP({
    body: {
      email: eml, // required, Email address to send the OTP.
    },
  });

  if (!data.success) throw new Error("uh oh. no good: " + JSON.stringify(data));

  email = eml;
} catch (err) {
  console.log({ err });
  error = String(err);
}
---

{
  error ? (
    <p>an error happened {error}</p>
  ) : (
    <div>
      <p class="callout success">
        Reset requested. Check your email {email} for the code
      </p>
      <VerifyOneTimePassForm
        otp={null}
        email={email ? decodeURIComponent(email) : null}
      />
    </div>
  )
}
