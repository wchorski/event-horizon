<!-- ---
// partials/bookings/:id/edit
import { bookingConfigRequired } from "@lib/tableConfigs";
import {
  BadRequestError,
  errorHandlingOnSubmit,
  ForbiddenError,
  NotFoundError,
} from "@lib/errors";
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import type { BookingSelect } from "@ty/Schema";
import RowEdit from "@components/tables/RowEdit.astro";
import { Booking } from "@db/schema";
import { db } from "@db/db";
import { eq } from "drizzle-orm";

let booking: BookingSelect | null | undefined = null;
let error = null;

const { id } = Astro.params;
if (!id) throw new BadRequestError("booking ID missing in request");

const { user } = Astro.locals;
if (!user) return new Response(null, { status: 401 });
if (user.role !== "admin")
  throw new ForbiddenError(
    "use better-auth api for user creation and management",
  );

const locations = await crud.locations.readMany(session);
const users = await crud.users.readMany(session);
const config = bookingConfigRequired(locations, users);
const ctx = {
  crud: "bookings" as CrudRegistryType,
  config,
  endpoint: "/bookings",
  headers: Object.keys(config),
};

if (Astro.request.method === "GET") {
  try {

    const [row] = await db
      .select()
      .from(Booking)
      .where(eq(Booking.id, id))
      .limit(1);
    if (!row) throw new NotFoundError(`Booking ${id} not found`);
    booking = row;
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    console.log(JSON.stringify(err, null, 2));
  }
} else {
  return new Response("Method Not Allowed", { status: 405 });
}

enum PartialType {
  TableRow = "table-row",
  SinglePage = "single-page",
}

const partialType =
  (Astro.request.headers.get("X-Partial-Type") as PartialType) ||
  PartialType.TableRow;
---

{
  error ? (
    <div id={`top-level-error-${ctx.crud}-${id}`}>
      {typeof error === "string" ? error : JSON.stringify(error)}
    </div>
  ) : booking && partialType === PartialType.TableRow ? (
    <RowEdit {...ctx} row={booking} error={error} />
  ) : booking && partialType === PartialType.SinglePage ? (
    <button type="button" id="submit-button" disabled>
      ✓ saved
    </button>
  ) : (
    <p>unknown error occured</p>
  )
} -->
