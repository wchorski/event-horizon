---
// pages/partials/bookings/request
import { validateBookingRequest } from "@lib/validate";
import FieldErrors from "@components/form/FieldErrors.astro";
import FormMessage from "@components/form/FormMessage.astro";
import { useForm } from "@lib/useForm";
import { unflatten } from "@lib/formParsing";
import { createBooking, resolveClientLinks } from "@lib/crud/bookingHelpers";
// import { createUser } from "@lib/auth/createUser";

export const partial = true;

const method = Astro.request.method;
if (method !== "POST")
  return new Response(null, { status: 405, headers: { Allow: "POST" } });

const { user } = Astro.locals;
if (!user || user.banned) return new Response("must have an account and be logged in to use bookings", { status: 401 });

const formId = Astro.request.headers.get("HX-Trigger");
// avoids junk from client
if (!formId || !/^[\w-]+$/.test(formId))
  return new Response("Bad request", { status: 400 });
const formData = await Astro.request.formData();
const unflat = unflatten(formData);
const input = {
  ...unflat,
  authorUserId: user.id,
}

// console.log({formData, unflat, input});
const outcome = await useForm(input, {
  schema: validateBookingRequest,
  labels: { start: "start", id: "id",  location_id: "location_id", client_id: "client_id"},
  successMessage: "Booking Created",
  constraints: {
    locations_org_name_unique: {
      field: "location.name",
      message: "Name already being used",
      error: "CREATION CONFLICT: Your organization already has a Location with this name.",
      status: 409,
    },
    locations_author_name_unique: {
      field: "location.name",
      message: "Name already being used",
      error: "CREATION CONFLICT: You already have a Location with this name.",
      status: 409,
    },
    booking_clients_booking_email_role_unique: {
      field: "user.email",
      message: "Email already being used",
      error: "CREATION CONFLICT: You already have a user with email booked.",
      status: 409,
    },
  },
  run: async ({location_id, location, client_emails, client_id, author_user_id, start, end, notes }) => {
    // const { success: canCreateBooking } = await auth.api.hasPermission({
    //   headers: Astro.request.headers,
    //   body: {
    //     // organizationId: organization.id, // be explicit rather than relying on the "active" org
    //     permissions: { booking: ["create"] },
    //   },
    // });

    // if (!canCreateBooking)
    //   throw new ForbiddenError("not allowed to create bookings");

    const clients = await resolveClientLinks({
      emails: client_emails,
      user_ids: client_id ? [client_id] : [],
    });

    return createBooking({
      location_id,
      location,
      clients,
      author_user_id,
      start,
      end,
      notes,
    });
  },
});

if (!outcome.ok) Astro.response.status = outcome.state.status ?? 422;
---

{
  outcome.ok ? (
    <>
      <FormMessage kind="success" message={outcome.state.success}>
        {" "}<strong>{new Date(outcome.data.start).toLocaleString()}</strong>
      </FormMessage>
    </>
  ) : (
    <FormMessage
      kind="error"
      message={outcome.state.error}
      status={outcome.state.status}
    />
  )
}
<FieldErrors
  {formId}
  names={Object.keys(validateBookingRequest.shape)}
  errors={outcome.ok ? {} : outcome.state.fieldErrors}
/>