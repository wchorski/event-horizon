---
// pages/partials/bookings/request
import { bookingConfigRequired } from "@lib/tableConfigs";
import {
  BadRequestError,
  errorHandlingOnSubmit,
  ForbiddenError,
  NotFoundError,
  UnauthorizedError,
} from "@lib/errors";
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import type { BookingSelect } from "@ty/Schema";
import FieldErrors from "@components/mgmt/FieldErrors.partial.astro";
import FormSuccess from "@components/mgmt/FormSuccess.partial.astro";
import TopLevelError from "@components/mgmt/TopLevelError.partial.astro";
import { handleResult } from "@lib/handleRenderResult";
import { Booking, Location } from "@db/schema";
import { db } from "@db/db";
import { validateBookingRequest } from "@lib/validate";
import { parseNestedFormData } from "@lib/parseFormFields";
import { createUser } from "@lib/auth/createUser";

export const partial = true;

const { user } = Astro.locals;
if (!user) return new Response(null, { status: 401 });
if (user.role !== "admin")
  throw new ForbiddenError(
    "use better-auth api for user creation and management",
  );

let booking: BookingSelect | null | undefined = null;
let error = null;
const userId = user.id;
const locations = await crud.locations.readMany();
const users = await crud.users.readMany();
const config = bookingConfigRequired(locations, users);
const ctx = {
  crud: "bookings" as CrudRegistryType,
  config,
  endpoint: "/bookings",
  // TODO is there a better way to make sure error ids sync with partials?
  headers: [
    ...Object.keys(config),
    "user.phone",
    "user.first_name",
    "user.last_name",
    "user.email",
    "location.name",
    "location.address",
    "location.city",
    "location.state",
    "location.zip",
    "location.timezone",
  ],
};

type Payload = {
  start: string;
  end?: string;
  status?: string;
  notes: string;
  location_id?: string;

  location: {
    name: string;
    address: string;
    city: string;
    state: string;
    zip: string;
    timezone: string;
  };
  user: {
    id: string;
  };
};

if (Astro.request.method === "POST") {
  try {
    if (!userId) {
      throw new UnauthorizedError("Must be logged in to submit form");
    }
    const formData = await Astro.request.formData();

    const submitFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    const payload = parseNestedFormData({
      ...submitFields,
      author_user_id: userId || "",
    }) as Payload;

    payload.end = payload.start;
    payload.status = "REQUESTED";
    const validated = validateBookingRequest.parse(payload);
    let locationId = validated.location_id;
    let clientId = validated.client_id;

    if (!locationId && validated.location) {
      const [newLocation] = await db
        .insert(Location)
        .values({
          ...validated.location,
          author_user_id: userId,
        })
        .returning();

      if (!newLocation) {
        throw new Error("Location could not be created");
      }

      locationId = newLocation.id;
    }

    if (!clientId && validated.user) {
      const userResult = await createUser(validated.user);

      if (!userResult.success)
        throw new Error(`User Create Error: ${userResult.error}`);
      clientId = userResult.user.id;
    }

    const [result] = await db
      .insert(Booking)
      .values({
        start: validated.start,
        end: validated.end,
        notes: validated.notes,
        status: validated.status,
        author_user_id: validated.author_user_id,
        client_id: clientId,
        location_id: locationId,
      })
      .returning();
    if (!result) throw new NotFoundError(`Booking not created`);
    booking = result;
    Astro.response.headers.set("HX-Redirect", "/dashboard");
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
} else {
  return new Response("Method Not Allowed", { status: 405 });
}

enum PartialType {
  TableRow = "table-row",
  SinglePage = "single-page",
}

const partialType = Astro.request.headers.get("X-Partial-Type") as
  PartialType | undefined;
if (!partialType) throw new BadRequestError("X-Partial-Type header not set");

const result = handleResult<BookingSelect>({
  error,
  entity: booking,
  method: Astro.request.method,
  emptyMessage: "No data available",
});
---

{
  result.kind === "field-error" ? (
    <FieldErrors
      id={"create"}
      headers={ctx.headers}
      errors={result.errors}
      model={ctx.crud}
    />
  ) : result.kind === "top-error" ? (
    <TopLevelError
      id={"create"}
      headers={ctx.headers}
      crud={ctx.crud}
      message={result.message}
      code={Astro.response.status}
    />
  ) : (
    <FormSuccess
      entity={result.entity}
      method={result.method}
      partialType={partialType}
      ctx={ctx}
    />
  )
}
