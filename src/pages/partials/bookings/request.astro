// import { createUser } from "@lib/auth/createUser";

export const partial = true;

const method = Astro.request.method;
if (method !== "POST")
  return new Response(null, { status: 405, headers: { Allow: "POST" } });

const { user } = Astro.locals;
if (!user || user.banned) return new Response("must have an account and be logged in to use bookings", { status: 401 });

const formId = Astro.request.headers.get("HX-Trigger");
// avoids junk from client
if (!formId || !/^[\w-]+$/.test(formId))
  return new Response("Bad request", { status: 400 });
const formData = await Astro.request.formData();
const unflat = unflatten(formData);
const input = {
  ...unflat,
  author_user_id: user.id,
}
// console.log({formData, unflat, input});
const outcome = await useForm(input, {
  schema: validateBookingRequest,
  labels: { start: "start", id: "id",  location_id: "location_id", client_id: "client_id"},
  successMessage: "Booking Created",
  run: async ({location_id, location, user: newUser, author_user_id, start, end, notes, status, client_id}) => {
    // const { success: canCreateBooking } = await auth.api.hasPermission({
    //   headers: Astro.request.headers,
    //   body: {
    //     // organizationId: organization.id, // be explicit rather than relying on the "active" org
    //     permissions: { booking: ["create"] },
    //   },
    // });

    // if (!canCreateBooking)
    //   throw new ForbiddenError("not allowed to create bookings");

    let new_location_id = undefined

    if (!location_id && location) {
      const [newLocation] = await db
        .insert(Location)
        .values({
          ...location,
          author_user_id: user.id,
        })
        .returning();

      if (!newLocation) {
        throw new Error("Location could not be created");
      }

      new_location_id = newLocation.id;
    }

    const [result] = await db
      .insert(Booking)
      .values({
        start,
        end,
        notes,
        status: "REQUESTED",
        author_user_id,
        client_id,
        location_id: location_id ?? new_location_id,
      })
      .returning();
    if (!result) throw new NotFoundError(`Booking not created`);
    return result
  },
});

if (!outcome.ok) Astro.response.status = outcome.state.status ?? 422;
