---
import type { CourseSelect } from "@ty/Schema";

interface Props {
  events: CourseSelect[];
}

const { events } = Astro.props;
---

<ul id="events-list">
  {
    events.length > 0 ? (
      events.map(({ id, subject, excerpt, timestamp }) => (
        <li>
          <article>
            <time datetime={timestamp.toISOString()}>
              {timestamp.toLocaleString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
            <span>
              <a href={`/attendance/check-in/${id}`}>{subject}</a>
            </span>
            <p>{excerpt}</p>
          </article>
        </li>
      ))
    ) : (
      <p>No events found</p>
    )
  }
</ul>
