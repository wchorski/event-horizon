---
// partials/tickets/:id
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import { BadRequestError, errorHandlingOnSubmit } from "@lib/errors";
import { ticketsConfigRequired, tableConfigs } from "@lib/tableConfigs";
import RowView from "@components/tables/RowView.astro";
import type { TicketSelect } from "@ty/Schema";
import type { ZodError } from "astro/zod";
import type { BaseRow } from "@ty/FieldConfig";
import type { TableRow } from "@ty/Table";
import { TEST_ADMIN_SESSION } from "@lib/auth/session";
import FieldErrors from "@components/mgmt/FieldErrors.partial.astro";
import FormSuccess from "@components/mgmt/FormSuccess.partial.astro";
import TopLevelError from "@components/mgmt/TopLevelError.partial.astro";

interface Params {
  id: string | undefined;
}

const id = Astro.params.id;
if (!id) throw new BadRequestError("Missing required parameter: id");
let ticket: TicketSelect | null | undefined = null;
let error: string | ReturnType<ZodError["flatten"]> | null = null;
const users = await crud.users.readMany(TEST_ADMIN_SESSION);
const events = await crud.events.readMany(TEST_ADMIN_SESSION);
const config = ticketsConfigRequired(users, events);
const ctx = {
  crud: "tickets" as CrudRegistryType,
  config,
  endpoint: "/attendance/admin/tickets",
  headers: Object.keys(config) as (keyof typeof config)[],
};

const session = TEST_ADMIN_SESSION;

if (Astro.request.method === "GET") {
  try {
    ticket = await crud.tickets.read(id);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}

if (Astro.request.method === "PATCH") {
  try {
    const formData = await Astro.request.formData();
    if (!formData) return new Response("Bad Request", { status: 400 });

    const submitFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    const payload = {
      ...submitFields,
      id,
    };

    ticket = await crud.tickets.update(payload);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    console.log(JSON.stringify(err, null, 2));
  }
}

if (Astro.request.method === "DELETE") {
  try {
    if (!id) throw new BadRequestError("Missing required parameter: id");

    ticket = await crud.tickets.delete(id);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}

enum PartialType {
  TableRow = "table-row",
  SinglePage = "single-page",
}

const partialType = Astro.request.headers.get("X-Partial-Type") as
  | PartialType
  | undefined;
if (!partialType) throw new BadRequestError("X-Partial-Type header not set");
type ZodErrorFlattened = ReturnType<ZodError<TicketSelect>["flatten"]>;
type RenderResult =
  | {
      kind: "field-error";
      errors: ZodErrorFlattened;
    }
  | {
      kind: "top-error";
      message: string;
    }
  | {
      kind: "success";
      ticket: TicketSelect;
      method: "GET" | "POST" | "PATCH" | "DELETE";
    };

let result: RenderResult;

if (error && typeof error === "object" && "fieldErrors" in error) {
  result = { kind: "field-error", errors: error };
} else if (error) {
  result = {
    kind: "top-error",
    message: typeof error === "string" ? error : JSON.stringify(error),
  };
} else if (ticket) {
  result = {
    kind: "success",
    ticket,
    method: Astro.request.method as any,
  };
} else {
  result = {
    kind: "top-error",
    message: "No course data available",
  };
}
---

{
  result.kind === "field-error" ? (
    <FieldErrors
      id={"create"}
      headers={ctx.headers}
      errors={result.errors}
      model={ctx.crud}
    />
  ) : result.kind === "top-error" ? (
    <TopLevelError
      id={"create"}
      headers={ctx.headers}
      crud={ctx.crud}
      message={result.message}
    />
  ) : (
    <FormSuccess
      entity={result.ticket}
      method={result.method}
      partialType={partialType}
      ctx={ctx}
    />
  )
