---
// src/pages/partials/events/outlook-event.astro

import { db } from "@db/db";
import { Event, MeetingPacket } from "@db/schema";
import { msAuthentication } from "@lib/auth/msAuthentication";
import { BadRequestError, errorHandlingOnSubmit } from "@lib/errors";
import { unflatten } from "@lib/formParsing";
import locations, { type LocationSeedInsert } from "@db/seed/locations";
import organizations from "@db/seed/organizations";
import users from "@db/seed/users";
import { and, eq } from "drizzle-orm";

const { TENANT_ID, MS_CLIENT_ID, MS_SECRET_VALUE } = import.meta.env;

if (Astro.request.method !== "POST") {
  throw new BadRequestError(
    `Unsupported method for this route: ${Astro.request.method}`,
  );
}

type RenderResult =
  | { kind: "redirect"; url: string; setCookies: string[] }
  | { kind: "success"; eventId: string; webLink?: string }
  | { kind: "top-error"; message: string };

let result: RenderResult;

const organizerMailbox = "MOEDocs@moeits.onmicrosoft.com";
const site_id =
  "moeits.sharepoint.com,fd7cc296-d084-4604-941a-bdc70e6195e4,a20a733c-1f92-4c6f-8415-7469223ee708";
const drive_id =
  "b!lsJ8_YTQBEaUGr3HDmGV5DxzCqKSH29MhBV0aSI-5wjanyzd4OQnQKS3XpK0w3l4";

try {
  const formData = await Astro.request.formData();
  const parsed = unflatten(formData);

  const { folderId, ...calendar } = parsed as {
    folderId: string;
    subject: string;
    body: { contentType: string; content: string };
    start: { dateTime: string; timeZone: string };
    end: { dateTime: string; timeZone: string };
    location: { displayName: string };
    attendees: Array<{
      emailAddress: { address: string; name: string };
      type: string;
    }>;
    transactionId: string;
  };

  if (!folderId) {
    throw new BadRequestError(
      "folderId is required to link this event to a folder.",
    );
  }

  // console.log(JSON.stringify({ calendar }, null, 2));

  const existingPacket = await db.query.MeetingPacket.findFirst({
    where: and(
      eq(MeetingPacket.sharepoint_drive_id, drive_id),
      eq(MeetingPacket.sharepoint_folder_id, folderId),
    ),
    with: { event: true },
  });

  const accessToken = await msAuthentication(
    TENANT_ID,
    MS_CLIENT_ID,
    MS_SECRET_VALUE,
  );

  let event: { id: string; webLink?: string };

  if (existingPacket?.event?.outlook_event_id) {
    // Overwrite: PATCH the existing Outlook event instead of creating a new one
    const patchRes = await fetch(
      `https://graph.microsoft.com/v1.0/users/${encodeURIComponent(organizerMailbox)}/events/${existingPacket.event.outlook_event_id}`,
      {
        method: "PATCH",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(calendar),
      },
    );

    const patchBody = await patchRes.text();
    if (!patchRes.ok) {
      throw new Error(
        `Microsoft Graph PATCH failed: ${patchRes.status} ${patchRes.statusText}\n${patchBody}`,
      );
    }
    event = JSON.parse(patchBody);

    // Keep the existing Event row, just refresh the fields that may have changed
    await db
      .update(Event)
      .set({
        subject: calendar.subject,
        timestamp: new Date(calendar.start.dateTime),
        date_civil: calendar.start.dateTime.split("T")[0],
        outlook_web_link:
          event.webLink ?? existingPacket.event.outlook_web_link,
        outlook_deleted_at: null, // in case it had been soft-deleted
      })
      .where(eq(Event.id, existingPacket.event.id));
  } else {
    // No existing link — create fresh, exactly as before
    const postRes = await fetch(
      `https://graph.microsoft.com/v1.0/users/${encodeURIComponent(organizerMailbox)}/events`,
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(calendar),
      },
    );

    const postBody = await postRes.text();
    if (!postRes.ok) {
      throw new Error(
        `Microsoft Graph request failed: ${postRes.status} ${postRes.statusText}\n${postBody}`,
      );
    }
    event = JSON.parse(postBody);

    const [savedEvent] = await db
      .insert(Event)
      .values({
        subject: calendar.subject,
        timestamp: new Date(calendar.start.dateTime),
        date_civil: calendar.start.dateTime.split("T")[0],
        location_id: locations[0].id,
        organization_id: organizations[0].id,
        author_user_id: users[0].id,
        outlook_event_id: event.id,
        outlook_web_link: event.webLink ?? null,
      })
      .returning();

    await db.insert(MeetingPacket).values({
      event_id: savedEvent.id,
      department_id: "01a091b4-b532-7b9b-9fee-95b4ad19ca0b",
      sharepoint_site_id: site_id,
      sharepoint_drive_id: drive_id,
      sharepoint_folder_id: folderId,
    });
  }

  result = {
    kind: "success",
    eventId: event.id,
    webLink: event.webLink,
  };
} catch (error) {
  console.error("Unable to create Event/Packet/Outlook:", error);

  const { err, status } = errorHandlingOnSubmit(error);

  Astro.response.status = status;

  result = {
    kind: "top-error",
    message: typeof err === "string" ? err : JSON.stringify(err),
  };
}
---

{
  result.kind === "success" && (
    <section class="card">
      <p>Event created.</p>
      <p style="max-width: 15rem; text-wrap: balance;">
        Event ID: <code>{result.eventId}</code>
      </p>

      {result.webLink && (
        <p>
          <a href={result.webLink}>Open event in Outlook</a>
        </p>
      )}
    </section>
  )
}

{
  result.kind === "top-error" && (
    <section role="alert">
      <p>Unable to create event.</p>
      <pre>{result.message}</pre>
    </section>
  )
}
