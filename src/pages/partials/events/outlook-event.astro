---
// src/pages/partials/events/outlook-event.astro
import type {
  Event,
  Attendee,
  ItemBody,
  Location,
  DateTimeTimeZone,
} from "@microsoft/microsoft-graph-types";
interface EventFormData {
  folderId: string;
  subject: string;
  body: ItemBody;
  start: DateTimeTimeZone;
  end: DateTimeTimeZone;
  location: Location;
  attendees: Attendee[];
  transactionId?: string;
}
type OutlookEventSummary = Pick<Event, "id" | "webLink">;
import { db } from "@db/db";
import { MeetingPacket } from "@db/schema";
import { BadRequestError, errorHandlingOnSubmit } from "@lib/errors";
import { unflatten } from "@lib/formParsing";
import { and, eq } from "drizzle-orm";
import departments from "@db/seed/departments";
import { msGraphFetch } from "@lib/microsoft/msGraphFetch";

const TEST_DEPARTMENT_ID = departments[0].id;

const {
  MS_SHAREPOINT_MOEDOCS_DRIVE_ID,
  MS_SHAREPOINT_MOEDOCS_SITE_ID,
  MS_MAILBOX_USER_EMAIL,
} = import.meta.env;

if (Astro.request.method !== "POST") {
  throw new BadRequestError(
    `Unsupported method for this route: ${Astro.request.method}`,
  );
}

type RenderResult =
  | { kind: "redirect"; url: string; setCookies: string[] }
  | { kind: "success"; eventId: string; webLink?: string }
  | { kind: "top-error"; message: string };

let result: RenderResult;

const site_id = MS_SHAREPOINT_MOEDOCS_SITE_ID;
const drive_id = MS_SHAREPOINT_MOEDOCS_DRIVE_ID;
const mailboxUserEmail = MS_MAILBOX_USER_EMAIL;

try {
  const formData = await Astro.request.formData();
  const parsed = unflatten(formData) as EventFormData;

  const { folderId, ...calendar } = parsed;

  if (!folderId) {
    throw new BadRequestError(
      "folderId is required to link this event to a folder.",
    );
  }

  const existingPacket = await db.query.MeetingPacket.findFirst({
    where: and(
      eq(MeetingPacket.sharepoint_drive_id, drive_id),
      eq(MeetingPacket.sharepoint_folder_id, folderId),
    ),
  });

  let outlookEvent: Event;

  if (existingPacket?.outlookEvent_id) {
    // may want to update one thing like the body's link to the new packet pdf?
    console.log("=== OUTLOOK EVENT EXISTS, may need to update ===");
    // Overwrite: PATCH the existing Outlook event instead of creating a new one
    // or
    // create a new event and delete the old one?
    const url = `/users/${mailboxUserEmail}/events/${existingPacket.outlookEvent_id}`;
    const patch: Partial<Event> = calendar;
    await msGraphFetch<void>(url, {
      method: "PATCH",
      body: JSON.stringify(patch),
    });

    outlookEvent = await msGraphFetch<Event>(url, {
      method: "GET",
    });
  } else {
    // No existing link — create fresh, exactly as before
    console.log("======== CREATE NEW OUTLOOK EVENT ========");

    const url = `/users/${mailboxUserEmail}/events`;
    // TODO sharepoint groups DO NOT support app-api keys (must be multi-tenant app)
    // const url = `/groups/${group_id}/calendar`;
    console.log(`=== https://graph.microsoft.com/v1.0${url} ===`);

    outlookEvent = await msGraphFetch<OutlookEventSummary>(url, {
      method: "POST",
      body: JSON.stringify(calendar),
    });

    const exisitingPacket = folderId
      ? await db.query.MeetingPacket.findFirst({
          where: and(
            eq(MeetingPacket.sharepoint_drive_id, drive_id),
            eq(MeetingPacket.sharepoint_folder_id, folderId),
          ),
        })
      : null;

    if (exisitingPacket) {
      await db.update(MeetingPacket).set({
        outlook_event_id: outlookEvent.id,
        outlook_web_link: outlookEvent.webLink,
      }).where(eq(MeetingPacket.id, existingPacket.id));;
    } else {
      await db.insert(MeetingPacket).values({
        // event_id: savedEvent.id,
        outlook_event_id: outlookEvent.id,
        outlook_web_link: outlookEvent.webLink,
        department_id: TEST_DEPARTMENT_ID,
        sharepoint_site_id: site_id,
        sharepoint_drive_id: drive_id,
        sharepoint_folder_id: folderId,
      });
    }
  }

  result = {
    kind: "success",
    eventId: outlookEvent.id,
    webLink: outlookEvent.webLink,
  };
} catch (error) {
  // console.error("Unable to create Event/Packet/Outlook:", error);
  const { err, status } = errorHandlingOnSubmit(error);
  console.error(JSON.stringify(err));

  Astro.response.status = status;

  result = {
    kind: "top-error",
    message: typeof err === "string" ? err : JSON.stringify(err),
  };
}
---

{
  result.kind === "success" && (
    <section class="card">
      <p>Event created.</p>
      <p style="max-width: 15rem; text-wrap: balance;">
        Event ID: <code>{result.eventId}</code>
      </p>

      {result.webLink && (
        <p>
          <a href={result.webLink}>Open event in Outlook</a>
        </p>
      )}
    </section>
  )
}

{
  result.kind === "top-error" && (
    <section role="alert">
      <p>Unable to create event.</p>
      <pre>{result.message}</pre>
    </section>
  )
}
