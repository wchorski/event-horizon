---
// src/pages/partials/events/outlook-event.astro

import { db } from "@db/db";
import { Event, MeetingPacket } from "@db/schema";
import { msAuthentication } from "@lib/auth/msAuthentication";
import { BadRequestError, errorHandlingOnSubmit } from "@lib/errors";
import { unflatten } from "@lib/formParsing";
import locations, { type LocationSeedInsert } from "@db/seed/locations";
import organizations, {
  type OrganizationSeedInsert,
} from "@db/seed/organizations";
import users, { type UserSeedInsert } from "@db/seed/users";
import departments from "@db/seed/departments";

const { TENANT_ID, MS_CLIENT_ID, MS_SECRET_VALUE } = import.meta.env;

if (Astro.request.method !== "POST") {
  throw new BadRequestError(
    `Unsupported method for this route: ${Astro.request.method}`,
  );
}

type RenderResult =
  | { kind: "redirect"; url: string; setCookies: string[] }
  | { kind: "success"; eventId: string; webLink?: string }
  | { kind: "top-error"; message: string };

let result: RenderResult;

const organizerMailbox = "wchorski@moeits.com";
const site_id =
  "moeits.sharepoint.com,fd7cc296-d084-4604-941a-bdc70e6195e4,a20a733c-1f92-4c6f-8415-7469223ee708";
const drive_id =
  "b!lsJ8_YTQBEaUGr3HDmGV5DxzCqKSH29MhBV0aSI-5wjanyzd4OQnQKS3XpK0w3l4";

try {
  const formData = await Astro.request.formData();
  const parsed = unflatten(formData);

  const { folderId, ...calendar } = parsed as {
    folderId: string;
    subject: string;
    body: { contentType: string; content: string };
    start: { dateTime: string; timeZone: string };
    end: { dateTime: string; timeZone: string };
    location: { displayName: string };
    attendees: Array<{
      emailAddress: { address: string; name: string };
      type: string;
    }>;
    transactionId: string;
  };

  if (!folderId) {
    throw new BadRequestError(
      "folderId is required to link this event to a folder.",
    );
  }

  console.log(JSON.stringify({ calendar }, null, 2));

  const accessToken = await msAuthentication(
    TENANT_ID,
    MS_CLIENT_ID,
    MS_SECRET_VALUE,
  );

  const endpoint =
    `https://graph.microsoft.com/v1.0/users/` +
    `${encodeURIComponent(organizerMailbox)}/events`;

  const res = await fetch(endpoint, {
    method: "POST",

    headers: {
      Authorization: `Bearer ${accessToken}`,
      "Content-Type": "application/json",
      Accept: "application/json",
    },

    body: JSON.stringify(calendar),
  });

  const responseBody = await res.text();

  if (!res.ok) {
    throw new Error(
      `Microsoft Graph request failed: ${res.status} ${res.statusText}\n` +
        responseBody,
    );
  }

  const event = JSON.parse(responseBody) as {
    id: string;
    webLink?: string;
  };

  // console.log("Created Outlook event:", {
  //   eventId: event.id,
  //   webLink: event.webLink,
  // });
  const [savedEvent] = await db
    .insert(Event)
    .values({
      subject: calendar.subject,
      timestamp: new Date(calendar.start.dateTime),
      date_civil: calendar.start.dateTime.split("T")[0],
      // TODO don't hard code
      // MOEITS Conf room
      location_id: locations[0].id, // resolved from calendar.location.displayName, or passed in
      organization_id: organizations[0].id, // resolved from department/org lookup
      author_user_id: users[0].id,
      outlook_event_id: event.id,
      outlook_web_link: event.webLink ?? "",
    })
    .returning();

  await db.insert(MeetingPacket).values({
    event_id: savedEvent.id,
    department_id: "01a091b4-b532-7b9b-9fee-95b4ad19ca0b", // resolved from the "MOEITS Board" folder segment
    sharepoint_site_id: site_id,
    sharepoint_drive_id: drive_id,
    sharepoint_folder_id: folderId,
  });

  result = {
    kind: "success",
    eventId: event.id,
    webLink: event.webLink,
  };
} catch (error) {
  console.error("Unable to create Event/Packet/Outlook:", error);

  const { err, status } = errorHandlingOnSubmit(error);

  Astro.response.status = status;

  result = {
    kind: "top-error",
    message: typeof err === "string" ? err : JSON.stringify(err),
  };
}
---

{
  result.kind === "success" && (
    <section class="card">
      <p>Event created.</p>
      <p style="max-width: 15rem; text-wrap: balance;">
        Event ID: <code>{result.eventId}</code>
      </p>

      {result.webLink && (
        <p>
          <a href={result.webLink}>Open event in Outlook</a>
        </p>
      )}
    </section>
  )
}

{
  result.kind === "top-error" && (
    <section role="alert">
      <p>Unable to create event.</p>
      <pre>{result.message}</pre>
    </section>
  )
}
