---
// src/pages/partials/events/outlook-event/:id
import type {
  Event,
  Attendee,
  ItemBody,
  Location,
  DateTimeTimeZone,
} from "@microsoft/microsoft-graph-types";
import { db } from "@db/db";
import { MeetingPacket } from "@db/schema";
import { BadRequestError, errorHandlingOnSubmit } from "@lib/errors";
import { unflatten } from "@lib/formParsing";
import { and, eq } from "drizzle-orm";
import departments from "@db/seed/departments";
import { msGraphFetch } from "@lib/microsoft/msGraphFetch";
import { outlookTimeZoneHeader, resolveMeetingTimeZone } from "@lib/calendarFactory";
import { requireOrganizationAccess } from "@lib/auth/guards";

interface EventCreatePayload {
  subject: string;
  body: ItemBody;
  start: DateTimeTimeZone;
  end: DateTimeTimeZone;
  location: Location;
  attendees: Attendee[];
  transactionId: string;
}
type EventUpdatePayload = Omit<EventCreatePayload, "transactionId">;

interface EventFormData extends EventCreatePayload {
  folderId: string;
}

type OutlookEventSummary = Pick<Event, "id" | "webLink">;

type RenderResult =
  | { kind: "success"; eventId: string; webLink?: string | null }
  | { kind: "top-error"; message: string };

const TEST_DEPARTMENT_ID = departments[0].id;

// const {
//   MS_SHAREPOINT_MOEDOCS_DRIVE_ID,
//   MS_SHAREPOINT_MOEDOCS_SITE_ID,
//   MS_MAILBOX_USER_EMAIL,
// } = import.meta.env;

// const site_id = MS_SHAREPOINT_MOEDOCS_SITE_ID;
// const drive_id = MS_SHAREPOINT_MOEDOCS_DRIVE_ID;
// const mailboxUserEmail = MS_MAILBOX_USER_EMAIL;

const { id: eventId } = Astro.params; // present only on the PATCH route
if (!eventId) throw new BadRequestError("eventId is required.");
const method = Astro.request.method;

if (method !== "PATCH") {
  throw new Error(`method ${method} is NOT allowed at this endpoint`);
}
let result: RenderResult;

try {
  // --- UPDATE ---
   const user = Astro.locals.user;
  if (!user) throw new BadRequestError("Not authenticated.");

  const { organization_slug } = Astro.params;
  if (!organization_slug)
    throw new BadRequestError("organization_slug is required.");

  // Same check as the page this partial is embedded in — the URL segment
  // is just routing; the request is only trusted after this passes.
  const { organization, membership } = await requireOrganizationAccess(
    user.id,
    organization_slug,
  );
  if (!organization || !membership) {
    throw new BadRequestError("You are not authorized for this organization.");
  }

  const { sharepoint_site_id, sharepoint_drive_id, mailbox_user_email } =
    organization;
  if (!sharepoint_site_id || !sharepoint_drive_id || !mailbox_user_email) {
    throw new Error("Organization SharePoint config is not set up correctly.");
  }

  const formData = await Astro.request.formData();
  // const parsed = unflatten(formData) as Omit<EventFormData, "transactionId">;
  const parsed = unflatten(formData) as EventFormData;
  console.log("=== events/outlook-event/:id PATCH ===");
  console.log({ parsed });
  // i'm just pulling out transactionId cuz i'm too lazy to conditionally set in frontend...
  const { folderId, transactionId, ...updateFields } = parsed as EventFormData;
  const updatePayload: EventUpdatePayload = updateFields;

  // TODO(locations-schema): resolve from the packet's eventual location_id.
  const meetingTimeZone = await resolveMeetingTimeZone(null);

  const url = `/users/${mailbox_user_email}/events/${eventId}`;
  const updated = await msGraphFetch<OutlookEventSummary>(organization.id, url, {
    method: "PATCH",
    headers: outlookTimeZoneHeader(meetingTimeZone),
    body: JSON.stringify(updatePayload),
  });

  console.log({ updated });

  // Keep the packet's cached webLink in sync, in case it ever changes.
  if (folderId) {
    await db
      .update(MeetingPacket)
      .set({ outlook_web_link: updated.webLink })
      .where(
        and(
          eq(MeetingPacket.sharepoint_drive_id, sharepoint_drive_id),
          eq(MeetingPacket.sharepoint_folder_id, folderId),
        ),
      );
  }

  result = { kind: "success", eventId: updated.id!, webLink: updated.webLink };
} catch (error) {
  const { err, status } = errorHandlingOnSubmit(error);
  console.error(JSON.stringify(err));
  Astro.response.status = status;
  result = {
    kind: "top-error",
    message: typeof err === "string" ? err : JSON.stringify(err),
  };
}
---

{
  result.kind === "success" && (
    <section class="card">
      <p>Event Updated</p>
      <p style="max-width: 15rem; text-wrap: balance;">
        Event ID: <code>{result.eventId}</code>
      </p>

      {result.webLink && (
        <p>
          <a href={result.webLink}>Open event in Outlook</a>
        </p>
      )}
    </section>
  )
}

{
  result.kind === "top-error" && (
    <section role="alert">
      <p>Unable to save event.</p>
      <pre>{result.message}</pre>
    </section>
  )
}
