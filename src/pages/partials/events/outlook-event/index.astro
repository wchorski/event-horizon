---
// pages/partials/events/outlook-event/index
import { db } from "@db/db";
import { MeetingPacket } from "@db/schema";
import { BadRequestError, errorHandlingOnSubmit } from "@lib/errors";
import { unflatten } from "@lib/formParsing";
import { and, eq } from "drizzle-orm";
import departments from "@db/seed/departments";
import { msGraphFetch } from "@lib/microsoft/msGraphFetch";
import type { EventFormData, OutlookEventSummary, RenderResult } from "@ty/OutlookEvent";
import { outlookTimeZoneHeader, resolveMeetingTimeZone } from "@lib/calendarFactory";

const TEST_DEPARTMENT_ID = departments[0].id;
const { MS_SHAREPOINT_MOEDOCS_DRIVE_ID, MS_SHAREPOINT_MOEDOCS_SITE_ID, MS_MAILBOX_USER_EMAIL } =
  import.meta.env;
const site_id = MS_SHAREPOINT_MOEDOCS_SITE_ID;
const drive_id = MS_SHAREPOINT_MOEDOCS_DRIVE_ID;
const mailboxUserEmail = MS_MAILBOX_USER_EMAIL;

if (Astro.request.method !== "POST") {
  throw new BadRequestError(`Unsupported method for this route: ${Astro.request.method}`);
}

let result: RenderResult;

try {
  const formData = await Astro.request.formData();
  const { folderId, ...eventFields } = unflatten(formData) as EventFormData;

  if (!folderId) {
    throw new BadRequestError("folderId is required to link this event to a folder.");
  }

  // ... inside the POST handler, before the msGraphFetch call:
// TODO(locations-schema): resolve from the folder's eventual location_id.
const meetingTimeZone = await resolveMeetingTimeZone(null);

  const url = `/users/${mailboxUserEmail}/events`;
  const created = await msGraphFetch<OutlookEventSummary>(url, {
    method: "POST",
    headers: outlookTimeZoneHeader(meetingTimeZone),
    body: JSON.stringify(eventFields),
  });

  const existingPacket = await db.query.MeetingPacket.findFirst({
    where: and(
      eq(MeetingPacket.sharepoint_drive_id, drive_id),
      eq(MeetingPacket.sharepoint_folder_id, folderId),
    ),
  });

  if (existingPacket) {
    await db
      .update(MeetingPacket)
      .set({ outlook_event_id: created.id, outlook_web_link: created.webLink })
      .where(eq(MeetingPacket.id, existingPacket.id));
  } else {
    await db.insert(MeetingPacket).values({
      outlook_event_id: created.id,
      outlook_web_link: created.webLink,
      department_id: TEST_DEPARTMENT_ID,
      sharepoint_site_id: site_id,
      sharepoint_drive_id: drive_id,
      sharepoint_folder_id: folderId,
    });
  }

  result = { kind: "success", eventId: created.id!, webLink: created.webLink, mode: "created" };
} catch (error) {
  const { err, status } = errorHandlingOnSubmit(error);
  console.error(JSON.stringify(err));
  Astro.response.status = status;
  result = { kind: "top-error", message: typeof err === "string" ? err : JSON.stringify(err) };
}
---

{
  result.kind === "success" && (
    <section class="card">
      <p>Event Created</p>
      <p style="max-width: 15rem; text-wrap: balance;">
        Event ID: <code>{result.eventId}</code>
      </p>

      {result.webLink && (
        <p>
          <a href={result.webLink}>Open event in Outlook</a>
        </p>
      )}
    </section>
  )
}

{
  result.kind === "top-error" && (
    <section role="alert">
      <p>Unable to create event.</p>
      <pre>{result.message}</pre>
    </section>
  )
}