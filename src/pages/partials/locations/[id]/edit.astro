---
// partials/locations/:id/edit
import { tableConfigs } from "@lib/tableConfigs";
import { BadRequestError, errorHandlingOnSubmit } from "@lib/errors";
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import { TEST_ADMIN_SESSION } from "@lib/auth/session";
import type { LocationSelect } from "@ty/Schema";
import RowEditComponent from "@components/tables/RowEdit.astro";

type ViewType = "table-row" | "card";

let location: LocationSelect | null | undefined = null;
let error = null;
let view: ViewType = "table-row";

const { id } = Astro.params;
if (!id) throw new BadRequestError("location ID missing in request");
const config = tableConfigs.locations.required;
const ctx = {
  crud: "locations" as CrudRegistryType,
  config,
  endpoint: "/attendance/locations",
  headers: Object.keys(config),
};

if (Astro.request.method === "GET") {
  try {
    // const session = await requirePermission(Astro.request, "locations", "create");
    // TODO

    const session = TEST_ADMIN_SESSION;

    location = await crud.locations.read(id, session);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    console.log(JSON.stringify(err, null, 2));
  }
} else {
  return new Response("Method Not Allowed", { status: 405 });
}
---

{
  error ? (
    <div
      id={`top-level-error-${ctx.crud}-${id}`}
      class="row-error callout error top-level"
    >
      {typeof error === "string" ? error : JSON.stringify(error)}
    </div>
  ) : location && view === "table-row" ? (
    <RowEditComponent {...ctx} row={location} error={error} />
  ) : (
    <p>unknown error occured</p>
  )
}
