---
// partials/organizations/:id/edit
import { organizationConfigRequired } from "@lib/tableConfigs";
import {
  BadRequestError,
  errorHandlingOnSubmit,
  NotFoundError,
} from "@lib/errors";
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import { parseOutUndefinedFormData } from "@lib/sanatizers";
import { TEST_ADMIN_SESSION } from "@lib/auth/session";
import type { OrganizationSelect } from "@ty/Schema";
import RowEdit from "@components/tables/RowEdit.astro";
import { Organization } from "@db/schema";
import { db } from "@db/db";
import { eq } from "drizzle-orm";

let organization: OrganizationSelect | null | undefined = null;
let error = null;

const { id } = Astro.params;
if (!id) throw new BadRequestError("user ID missing in request");
const config = organizationConfigRequired();
const ctx = {
  crud: "organizations" as CrudRegistryType,
  config,
  endpoint: "/organizations",
  headers: Object.keys(config),
};

if (Astro.request.method === "GET") {
  try {

    const [row] = await db
      .select()
      .from(Organization)
      .where(eq(Organization.id, id))
      .limit(1);
    if (!row) throw new NotFoundError(`Organization ${id} not found`);
    organization = row;
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    console.log(JSON.stringify(err, null, 2));
  }
} else {
  return new Response("Method Not Allowed", { status: 405 });
}

enum PartialType {
  TableRow = "table-row",
  SinglePage = "single-page",
}

const partialType =
  (Astro.request.headers.get("X-Partial-Type") as PartialType) ||
  PartialType.TableRow;
---

{
  error ? (
    <div id={`top-level-error-${ctx.crud}-${id}`}>
      {typeof error === "string" ? error : JSON.stringify(error)}
    </div>
  ) : organization && partialType === PartialType.TableRow ? (
    <RowEdit {...ctx} row={organization} error={error} />
  ) : organization && partialType === PartialType.SinglePage ? (
    <button type="button" id="submit-button" disabled>
      ✓ saved
    </button>
  ) : (
    <p>unknown error occured</p>
  )
}
