---
// partials/bookings/[id].astro
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import {
  BadRequestError,
  errorHandlingOnSubmit,
  NotFoundError,
} from "@lib/errors";
import { bookingConfigRequired, tableConfigs } from "@lib/tableConfigs";
import type { BookingSelect, UserSelect } from "@ty/Schema";
import type { ZodError } from "astro/zod";

import { TEST_ADMIN_SESSION } from "@lib/auth/session";
import FieldErrors from "@components/mgmt/FieldErrors.partial.astro";
import FormSuccess from "@components/mgmt/FormSuccess.partial.astro";
import TopLevelError from "@components/mgmt/TopLevelError.partial.astro";
import { Booking } from "@db/schema";
import { db } from "@db/db";
import { eq } from "drizzle-orm";
import { validate } from "@lib/validate";
type ZodErrorFlattened = ReturnType<ZodError<UserSelect>["flatten"]>;
interface Params {
  id: string | undefined;
}
const { id } = Astro.params;
if (!id) throw new BadRequestError("course ID missing in request");
let booking: BookingSelect | null | undefined = null;
let error: string | ReturnType<ZodError["flatten"]> | null = null;
const session = TEST_ADMIN_SESSION;
const locations = await crud.locations.readMany(session);
const users = await crud.users.readMany(session);
const config = bookingConfigRequired(locations, users);

const ctx = {
  crud: "bookings" as CrudRegistryType,
  config,
  endpoint: "/bookings",
  headers: Object.keys(config),
};

if (Astro.request.method === "GET") {
  try {
    const [row] = await db
      .select()
      .from(Booking)
      .where(eq(Booking.id, id))
      .limit(1);
    if (!row) throw new NotFoundError(`Booking ${id} not found`);
    booking = row;
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}

if (Astro.request.method === "PATCH") {
  try {
    const formData = await Astro.request.formData();
    if (!formData) return new Response("Bad Request", { status: 400 });

    const submitFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    const payload = {
      ...submitFields,
      id,
    };

    const validated = validate.bookingUpdate.parse(payload);

    const [result] = await db
      .update(Booking)
      .set(validated)
      .where(eq(Booking.id, validated.id))
      .returning();
    if (!result) throw new NotFoundError(`Booking ${validated.id} not found`);

    booking = result;
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    // console.log(JSON.stringify(err, null, 2));
  }
}

if (Astro.request.method === "DELETE") {
  try {
    const [deleted] = await db
      .delete(Booking)
      .where(eq(Booking.id, id))
      .returning();
    if (!deleted) throw new NotFoundError(`Booking ${id} not found`);
    booking = deleted;
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
  }
}

enum PartialType {
  TableRow = "table-row",
  SinglePage = "single-page",
}

const partialType = Astro.request.headers.get("X-Partial-Type") as
  PartialType | undefined;
if (!partialType) throw new BadRequestError("X-Partial-Type header not set");

type RenderResult =
  | {
      kind: "field-error";
      errors: ZodErrorFlattened;
    }
  | {
      kind: "top-error";
      message: string;
    }
  | {
      kind: "success";
      booking: BookingSelect;
      method: "GET" | "POST" | "PATCH" | "DELETE";
    };

let result: RenderResult;

if (error && typeof error === "object" && "fieldErrors" in error) {
  result = { kind: "field-error", errors: error };
} else if (error) {
  result = {
    kind: "top-error",
    message: typeof error === "string" ? error : JSON.stringify(error),
  };
} else if (booking) {
  result = {
    kind: "success",
    booking,
    method: Astro.request.method as any,
  };
} else {
  result = {
    kind: "top-error",
    message: `No ${ctx.crud} data available`,
  };
}
---

{
  result.kind === "field-error" ? (
    <FieldErrors
      id={id}
      model={ctx.crud}
      headers={ctx.headers}
      errors={result.errors}
    />
  ) : result.kind === "top-error" ? (
    <TopLevelError
      id={id}
      headers={ctx.headers}
      crud={ctx.crud}
      message={result.message}
    />
  ) : (
    <FormSuccess
      entity={result.booking}
      method={result.method}
      partialType={partialType}
      ctx={ctx}
    />
  )
}
