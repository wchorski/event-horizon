---
// partials/organizations/create.astro
import {  organizationConfigRequired } from "@lib/tableConfigs";
import {
  BadRequestError,
  errorHandlingOnSubmit,
  NotFoundError,
} from "@lib/errors";
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import { TEST_ADMIN_SESSION } from "@lib/auth/session";
import type { OrganizationSelect } from "@ty/Schema";
import type { ZodError } from "astro:schema";
import FieldErrors from "@components/mgmt/FieldErrors.partial.astro";
import FormSuccess from "@components/mgmt/FormSuccess.partial.astro";
import TopLevelError from "@components/mgmt/TopLevelError.partial.astro";
import { handleResult } from "@lib/handleRenderResult";
import { Organization } from "@db/schema";
import { db } from "@db/db";
import { eq } from "drizzle-orm";
import { validate } from "@lib/validate";

type ZodErrorFlattened = ReturnType<ZodError<OrganizationSelect>["flatten"]>;

let organization: OrganizationSelect | null | undefined = null;
let error = null;
const config = organizationConfigRequired();
const ctx = {
  crud: "organizations" as CrudRegistryType,
  config,
  endpoint: "/organizations",
  headers: Object.keys(config),
};

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const submitFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    const validated = validate.organizationCreate.parse(submitFields);

    const [result] = await db.insert(Organization).values(validated).returning();
    if (!result) throw new NotFoundError(`Organization not created`);
    organization = result;
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    console.log(JSON.stringify(err, null, 2));
  }
} else {
  return new Response("Method Not Allowed", { status: 405 });
}

enum PartialType {
  TableRow = "table-row",
  SinglePage = "single-page",
}

const partialType = Astro.request.headers.get("X-Partial-Type") as
  PartialType | undefined;
if (!partialType) throw new BadRequestError("X-Partial-Type header not set");

const result = handleResult<OrganizationSelect>({
  error,
  entity: organization,
  method: Astro.request.method,
  emptyMessage: "No data available",
});
---

{
  result.kind === "field-error" ? (
    <FieldErrors
      id={"create"}
      headers={ctx.headers}
      errors={result.errors}
      model={ctx.crud}
    />
  ) : result.kind === "top-error" ? (
    <TopLevelError
      id={"create"}
      headers={ctx.headers}
      crud={ctx.crud}
      message={result.message}
    />
  ) : (
    <FormSuccess
      entity={result.entity}
      method={result.method}
      partialType={partialType}
      ctx={ctx}
    />
  )
}
