---
// partials/tickets/:id/edit
import { ticketsConfigRequired } from "@lib/tableConfigs";
import { BadRequestError, errorHandlingOnSubmit, ForbiddenError } from "@lib/errors";
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import type { TicketSelect } from "@ty/Schema";
import RowEdit from "@components/tables/RowEdit.astro";

type ViewType = "table-row" | "card";

const { user } = Astro.locals;
if (!user) return new Response(null, { status: 401 });
if (user.role !== "admin")
  throw new ForbiddenError(
    "use better-auth api for user creation and management",
  );

let ticket: TicketSelect | null | undefined = null;
let error = null;
let view: ViewType = "table-row";

const { id } = Astro.params;
if (!id) throw new BadRequestError("ID missing in request");
const users = await crud.users.readMany();
const events = await crud.events.readMany();
const config = ticketsConfigRequired(users, events);
const ctx = {
  crud: "tickets" as CrudRegistryType,
  config,
  endpoint: "/attendance/admin/tickets",
  headers: Object.keys(config) as (keyof typeof config)[],
};

if (Astro.request.method === "GET") {
  try {
    ticket = await crud.tickets.read(id);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    console.log(JSON.stringify(err, null, 2));
  }
} else {
  return new Response("Method Not Allowed", { status: 405 });
}
---

{
  error ? (
    <div
      id={`top-level-error-${ctx.crud}-${id}`}
      class="row-error callout error top-level"
    >
      {typeof error === "string" ? error : JSON.stringify(error)}
    </div>
  ) : ticket && view === "table-row" ? (
    <RowEdit {...ctx} row={ticket} error={error} />
  ) : (
    <p>unknown error occured</p>
  )
}
