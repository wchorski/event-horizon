---
// partials/tickets/create
import { ticketsConfigRequired, tableConfigs } from "@lib/tableConfigs";
import { BadRequestError, errorHandlingOnSubmit, ForbiddenError } from "@lib/errors";
import { crud, type CrudRegistryType } from "@lib/crudRegistry";
import type { TicketSelect } from "@ty/Schema";
import FieldErrors from "@components/mgmt/FieldErrors.partial.astro";
import FormSuccess from "@components/mgmt/FormSuccess.partial.astro";
import TopLevelError from "@components/mgmt/TopLevelError.partial.astro";
import { handleResult } from "@lib/handleRenderResult";

type ViewType = "table-row" | "card";

const { user } = Astro.locals;
if (!user) return new Response(null, { status: 401 });
if (user.role !== "admin")
  throw new ForbiddenError(
    "use better-auth api for user creation and management",
  );


let error = null;
let ticket: TicketSelect | null | undefined = null;
const users = await crud.users.readMany();
const events = await crud.events.readMany();
const config = ticketsConfigRequired(users, events);
const ctx = {
  crud: "tickets" as CrudRegistryType,
  config,
  endpoint: "/attendance/tickets",
  headers: Object.keys(config) as (keyof typeof config)[],
};

if (Astro.request.method === "POST") {
  try {

    const formData = await Astro.request.formData();

    const submitFields = Object.fromEntries(
      [...formData.entries()].filter(([key]) => !key.startsWith("_")),
    );

    ticket = await crud.tickets.create(submitFields);
  } catch (e) {
    const { err, status } = errorHandlingOnSubmit(e);
    Astro.response.status = status;
    error = err;
    console.log(JSON.stringify(err, null, 2));
  }
} else {
  return new Response("Method Not Allowed", { status: 405 });
}
enum PartialType {
  TableRow = "table-row",
  SinglePage = "single-page",
}

const partialType = Astro.request.headers.get("X-Partial-Type") as
  | PartialType
  | undefined;
if (!partialType) throw new BadRequestError("X-Partial-Type header not set");

const result = handleResult<TicketSelect>({
  error,
  entity: ticket,
  method: Astro.request.method,
  emptyMessage: "No tickets available",
});
---

{
  result.kind === "field-error" ? (
    <FieldErrors
      id={"create"}
      headers={ctx.headers}
      errors={result.errors}
      model={ctx.crud}
    />
  ) : result.kind === "top-error" ? (
    <TopLevelError
      id={"create"}
      headers={ctx.headers}
      crud={ctx.crud}
      message={result.message}
    />
  ) : (
    <FormSuccess
      entity={result.entity}
      method={result.method}
      partialType={partialType}
      ctx={ctx}
    />
  )
}