---
import InputField from "@components/form/InputField.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import CommonPageLayout from "@layouts/CommonPageLayout.astro";
import { auth } from "@lib/auth";
import { BadRequestError } from "@lib/errors";

type PasswordResetFields = {
  otp: string;
};

const params = Astro.url.searchParams;
const email = params.get("email");
const otp = params.get("otp");
if (!email)
  return Astro.redirect(
    "/login?msg=Password reset link is broken, please request a new link.",
  );

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const payload = Object.fromEntries(formData.entries()) as PasswordResetFields;
  const { otp } = payload;
  if (!otp) throw new BadRequestError("otp was not provided");

  const data = await auth.api.checkVerificationOTP({
    body: {
      email, // required, Email address to send the OTP.
      type: "forget-password", // required, Type of the OTP.
      otp, // required, OTP sent to the email.
    },
  });

  console.log({ data });
}

const formId = "password-reset";
---

<BaseLayout>
  <main>
    <header slot="header">
      <h1>Password Reset</h1>
    </header>
    <div data-layout="content">
      <form method={"POST"}>
        <legend>Confirm Verification Code</legend>
        <fieldset>
          <InputField
            id={formId}
            name={"otp"}
            label={"One Time Password"}
            model={"account"}
            type={"text"}
            required={true}
          />
        </fieldset>
        <div class="row-error error top-level">
          <p class="message">
            <span id={`${formId}-error`}></span>
          </p>
        </div>
      </form>
    </div>
  </main>
</BaseLayout>
