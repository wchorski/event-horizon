const parseTime = (hhmm: string) => {
  const [h, m] = hhmm.split(":").map(Number);
  return h * 60 + m;
};

const formatTimeRange = (start: string, end: string) => {
  let startMin = parseTime(start);
  let endMin = parseTime(end);

  // if end is "earlier", it means next day
  if (endMin <= startMin) {
    endMin += 1440;
  }

  return { start: startMin, end: endMin };
};
---

<BaseLayout>
  <main>
    <header class="flex">
      <h1>Planner</h1>
      <p class="sub-text">{id}</p>
    </header>

    <TimelineGraph blocks={[]} skills={skills} />

    <hr />

    <div class="flex gap-m" data-layout="content">
      <table>
        <thead>
          <tr>
            <th>time</th>

            <th>desc</th>
            <th>skill_id</th>
            <th>group_id</th>
            <th>note</th>
          </tr>
        </thead>
        <tbody id="time-block-list"> </tbody>
        <tfoot
          ><tr
            ><td colspan="100%"
              ><button aria-label="add line" title="add new line">+</button></td
            ></tr
          ></tfoot
        >
      </table>
      <aside class="grid gap-m">
        <h2 class="display none">blocks</h2>
        <ul id="time-groups-list" class="unstyled grid gap-s"></ul>
      </aside>
    </div>
    <hr />
    <div class="card">
      <h2>Skills</h2>
      <ul id="skills-list" class="unstyled grid gap-s"></ul>
    </div>
  </main>
</BaseLayout>

<script>
  import {
    getAllBlockPlans,
    getAllSkillPlans,
    getAllGroupPlans,
    addBlockPlan,
  } from "@client/indexedDB";
  import { seedIfEmpty } from "@client/initPlannerDB";
  import { createEmptyBlock, timeBlockRow } from "@client/templates/timeBlockRow";
  import { groupCard } from "@client/templates/groupCard";
import type { SkillPlanner } from "@ty/Schema";

  async function renderFromDB() {
    await seedIfEmpty();

    const [blocks, skills, groups] = await Promise.all([
      getAllBlockPlans(),
      getAllSkillPlans(),
      getAllGroupPlans(),
    ]);

    const tbody = document.getElementById("time-block-list")!;
    tbody.replaceChildren(); // clear existing
    blocks.forEach((b) => tbody.appendChild(timeBlockRow(b, skills)));

    const groupList = document.getElementById("time-groups-list")!;
    groupList.replaceChildren(); // clear before re-render
    groups.forEach((g) => groupList.appendChild(groupCard(g, blocks)));

    const skillList = document.getElementById("skills-list")!;
    skillList.replaceChildren();
    skills.forEach(s => {
      const li = document.createElement("li");
      li.textContent = s.name;
      skillList.appendChild(li);
    });

    // Notify TimelineGraph with the loaded blocks
    document.dispatchEvent(new CustomEvent("timeline:load", {
      detail: { blocks, skills }
    }));

    // ✅ wire add-row button after skills are loaded
    initAddRow(skills); 

    function initAddRow(skills: SkillPlanner[]) {
      const tbody  = document.getElementById("time-block-list")!;
      const button = document.querySelector("tfoot button")!;

      button.addEventListener("click", async () => {
        const newBlock = await addBlockPlan(createEmptyBlock(0));
        tbody.appendChild(timeBlockRow(newBlock, skills));
      });
    }
    
