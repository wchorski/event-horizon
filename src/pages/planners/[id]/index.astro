    //     body: JSON.stringify({ blocks, skills }),
    //   }).then((r) => r.text()),

    //   // fetch("/partials/planners/time-skills", {
    //   //   method: "POST",
    //   //   headers: { "Content-Type": "application/json" },
    //   //   // body: JSON.stringify({  }),
    //   // }).then(r => r.text()),

    //   fetch("/partials/planners/time-group-cards", {
    //     method: "POST",
    //     headers: { "Content-Type": "application/json" },
    //     body: JSON.stringify({ groups, blocks }),
    //   }).then((r) => r.text()),
    // ]);

    // document.getElementById("time-block-list")!.innerHTML = blocksHTML;
