const parseTime = (hhmm: string) => {
  const [h, m] = hhmm.split(":").map(Number);
  return h * 60 + m;
};

const formatTimeRange = (start: string, end: string) => {
  let startMin = parseTime(start);
  let endMin = parseTime(end);

  // if end is "earlier", it means next day
  if (endMin <= startMin) {
    endMin += 1440;
  }

  return { start: startMin, end: endMin };
};
---

<BaseLayout>
  <main>
    <header class="flex">
      <h1>Planner</h1>
      <p class="sub-text">{id}</p>
    </header>

    <TimelineGraph blocks={blocks_template} skills={skills} />

    <hr />

    <div class="flex gap-m" data-layout="content">
      <table>
        <thead>
          <tr>
            <th>time</th>

            <th>desc</th>
            <th>skill_id</th>
            <th>group_id</th>
            <th>note</th>
          </tr>
        </thead>
        <tbody>
          {
            blocks_template.map(
              ({ start, end, desc, skill_id, group_id, id, note }) => (
                <tr class={`time-block-row`}>
                  <td>
                    <InputField
                      value={formatTimeMinutesToClockString(start)}
                      type={"time"}
                      name={"start"}
                      id="timeline-start"
                      model="time-block"
                      data-id={id}
                      label=""
                    />
                    <InputField
                      value={formatTimeMinutesToClockString(end)}
                      type={"time"}
                      name={"end"}
                      id={`timeline-block-${id}-start`}
                      model="time-block"
                      data-id={id}
                      label=""
                    />
                  </td>

                  <td>
                    <InputField
                      label=""
                      value={desc}
                      type={"text"}
                      name="desc"
                      id={`timeline-block-${id}-desc`}
                      data-id={id}
                      model="time-block"
                    />
                  </td>
                  <td>
                    <select name={"skill_id"} data-id={id}>
                      {skills.map((skill) => (
                        <option
                          value={skill.id}
                          selected={skill.id === skill_id}
                        >
                          {skill.name}
                        </option>
                      ))}
                    </select>
                  </td>
                  <td>
                    <a href={`#${group_id}`}>{group_id}</a>
                  </td>
                  <td>{note}</td>
                </tr>
              ),
            )
          }
        </tbody>
      </table>
      <aside class="grid gap-m">
        <h2>blocks</h2>
        {
          groups_template.map(({ name, id }) => {
            const relatedPlans = blocks_template.filter(
              (plan) => plan.group_id === id,
            );
            return (
              <div class="card" id={String(id)}>
                <h3>
                  {name} | {id}
                </h3>
                {relatedPlans.length > 0 ? (
                  <ul>
                    {relatedPlans.map((plan) => (
                      <li>{plan.desc}</li>
                    ))}
                  </ul>
                ) : (
                  <p>no plans set</p>
                )}
              </div>
            );
          })
        }
      </aside>
    </div>
  </main>
</BaseLayout>

