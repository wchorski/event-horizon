---
interface Params {
  id: string;
}
import InputField from "@components/form/InputField.astro";
import TimelineGraph, { type Planner } from "@components/TimelineGraph.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatTimeMinutesToClockString } from "@lib/timeFormatters";
export const prerender = false; // Not needed in 'server' mode
const { id } = Astro.params;
if (!id) return Astro.redirect("/404");

const skills = [
  // { name: "Misc", id: 0 },
  { name: "MC Announcement", id: 1 },
  { name: "Song Cue", id: 2 },
  { name: "Music Playlist", id: 3 },
];

const planner:Planner[] = [
  {
    start: 960, end: 990,
    desc: "Pre-Seating Music",
    skill_id: 3,
    block_id: 1,
    note: "",
  },
  {
    start: 990, end: 1050,
    desc: "Ceremony",
    skill_id: 2,
    block_id: 1,
    note: "",
  },
  {
    start: 1050, end: 1110,
    desc: "Cocktail Hour",
    skill_id: 3,
    block_id: 2,
    note: "",
  },
  {
    start: 1110, end: 1125, 
    desc: "Introductions",
    skill_id: 1,
    block_id: 3,
    note: "",
  },
  {
    start: 1120, end: 1125,
    desc: "Cake Cutting",
    skill_id: 2,
    block_id: 4,
    note: "",
  },
  {
    start: 1125, end: 1140,
    desc: "Blessing",
    skill_id: 1,
    block_id: 5,
    note: "",
  },
  {
    start: 1125, end: 1200,
    desc: "Dinner Music",
    skill_id: 3,
    block_id: 2,
    note: "",
  },
  {
    start: 1170, end: 1185,
    desc: "Toasts",
    skill_id: 1,
    block_id: 4,
    note: "",
  },
  {
    start: 1200, end: 1215,
    desc: "Traditional Dances",
    skill_id: 2,
    block_id: 4,
    note: "",
  },
  {
    start: 1260, end: 1275,
    desc: "Bouquet and Garter Toss",
    skill_id: 2,
    block_id: 3,
    note: "",
  },
  {
    start: 1215, end: 1380,
    desc: "Open Dancefloor",
    skill_id: 3,
    block_id: 3,
    note: "",
  },
];

const blocks = [
  {
    id: 1,
    name: "Ceremony",
  },
  {
    id: 2,
    name: "Reception",
  },
  {
    id: 3,
    name: "Introductions",
  },
  {
    id: 4,
    name: "Traditionals",
  },
  {
    id: 5,
    name: "Dancing",
  },
];

const vendors = [
  {
    name: "DJ",
    skills: ["MC", "Song Que", "Music Playlist"],
  },
  {
    name: "Photographer",
    skills: ["special moment", "candid"],
  },
];

const parseTime = (hhmm: string) => {
  const [h, m] = hhmm.split(":").map(Number);
  return h * 60 + m;
};

const formatTimeRange = (start: string, end: string) => {
  let startMin = parseTime(start);
  let endMin = parseTime(end);

  // if end is "earlier", it means next day
  if (endMin <= startMin) {
    endMin += 1440;
  }

  return { start: startMin, end: endMin };
};
---

<BaseLayout>
  <main>
    <header class="flex">
      <h1>Planner</h1>
      <p class="sub-text">{id}</p>
    </header>

    <TimelineGraph planner={planner} skills={skills} />

    <hr />

    <div class="flex gap-m" data-layout="content">
      <table>
        <thead>
          <tr>
            <th>time</th>

            <th>desc</th>
            <th>skill_id</th>
            <th>block_id</th>
            <th>note</th>
          </tr>
        </thead>
        <tbody>
          {
            planner.map(({ start, end, desc, skill_id, block_id, note }) => (
              <tr class={`time-block-row`}>
                <td>
                  <InputField
                    value={formatTimeMinutesToClockString(start)}
                    type={"time"}
                    name={"start"}
                    id="timeline-start"
                    model="time-block"
                  />
                  <InputField
                    value={formatTimeMinutesToClockString(end)}
                    type={"time"}
                    name={"end"}
                    id="timeline-start"
                    model="time-block"
                    typeof={"time"}
                  />
                </td>

                <td>{desc}</td>
                <td>
                  <select name={"skill_id"}>
                    {skills.map((skill) => (
                      <option value={skill.id} selected={skill.id === skill_id}>
                        {skill.name}
                      </option>
                    ))}
                  </select>
                </td>
                <td>
                  <a href={`#${block_id}`}>{block_id}</a>
                </td>
                <td>{note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <aside class="grid gap-m">
        <h2>blocks</h2>
        {
          blocks.map(({ name, id }) => {
            const relatedPlans = planner.filter((plan) => plan.block_id === id);
            return (
              <div class="card" id={String(id)}>
                <h3>
                  {name} | {id}
                </h3>
                {relatedPlans.length > 0 ? (
                  <ul>
                    {relatedPlans.map((plan) => (
                      <li>{plan.desc}</li>
                    ))}
                  </ul>
                ) : (
                  <p>no plans set</p>
                )}
              </div>
            );
          })
        }
      </aside>
    </div>
  </main>
</BaseLayout>
