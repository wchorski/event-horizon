---
// src/pages/sign-out.astro
import { signout } from "@lib/auth/signout";
import { authRedirect } from "@lib/auth/respond";
import { emptyForm, fail } from "@lib/form-state";
import CommonPageLayout from "@layouts/CommonPageLayout.astro";
import FormCard from "@components/form/FormCard.astro";

const { user } = Astro.locals;
if (!user && Astro.request.method === "GET") return Astro.redirect("/login");
let state = emptyForm();

if (Astro.request.method === "POST") {
  try {
    const { setCookies } = await signout(Astro.request.headers);
    return authRedirect(Astro.request, `/bye-bye-bye?msg=${encodeURIComponent("You've been signed out.")}`, setCookies);
  } catch (e) {
    console.error("signout failed", e);
    state = fail({ status: 500, error: "Couldn't sign you out. Please try again." });
    Astro.response.status = 500;
  }
}
---

<CommonPageLayout>
  <header>
    <h1>Sign Out</h1>
  </header>
  <div data-layout="content">
    {
      user ? (
        <>
          <p>You are currently logged in as</p>
          <ul>
            <li>
              {user.first_name} {user.last_name}
            </li>
            <li>{user.email}</li>
          </ul>
        </>
      ) : null
    }

    <FormCard id="sign-out-form" submitText="Sign Out" {state} />
  </div>
</CommonPageLayout>
