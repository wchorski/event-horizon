---
// src/pages/sign-out.astro
import InputField from "@components/form/InputField.astro";
import SubmitButton from "@components/form/SubmitButton.astro";
import CommonPageLayout from "@layouts/CommonPageLayout.astro";
import { signout } from "@lib/auth/signout";

const { user } = Astro.locals;
let error: string | null = null;

if (Astro.request.method === "POST") {
  const result = await signout(Astro.request.headers);
  console.log({result});

  if (result.success) {
    const redirectResponse = new Response(null, {
      status: 302,
      headers: {
        Location:
          "/bye-bye-bye?msg='Might sound crazy, but it ain't no lie Baby, bye, bye, bye (Oh, oh)'",
      },
    });

    for (const cookie of result.setCookies) {
      redirectResponse.headers.append("set-cookie", cookie);
    }

    return redirectResponse;
  }

  error = result.error;
}
---

<CommonPageLayout>
  <header>
    <h1>Sign Out</h1>
  </header>
  <div data-layout="content">
    {
      user ? (
        <>
          <p>You are currently logged in as</p>
          <ul>
            <li>{user.first_name} {user.last_name}</li>
            <li>{user.email}</li>
          </ul>
        </>
      ) : null
    }
    <form id="sign-out-form" method="POST" class="card">
      <SubmitButton text="Sign Out" size="m"/>
    </form>
    {
      error && (
        <p class="form-error error callout" role="alert">
          {error}
        </p>
      )
    }
  </div>
</CommonPageLayout>
