---
// pages/sign-up
import CommonPageLayout from "@layouts/CommonPageLayout.astro";
import FormCard from "@components/form/FormCard.astro";
import InputField from "@components/form/InputField.astro";
import { signup } from "@lib/auth/signup";
import { runForm } from "@lib/form-action";
import { authRedirect } from "@lib/auth/respond";
import { emptyForm } from "@lib/form-state";
import { validate } from "@lib/validate";

const { user } = Astro.locals;

// if (user)
//   return Astro.redirect(
//     `/dashboard?msg=Already signed in as ${user.first_name}`,
//   );

let state = emptyForm(); // every request starts clean

if (Astro.request.method === "POST") {
  const outcome = await runForm(await Astro.request.formData(), {
    schema: validate.signup,
    sensitive: ["password"],
    labels: { first_name: "first name", last_name: "last name" },
    successMessage: "Account created! Check your email for a code.",
    run: signup,
  });

  if (outcome.ok) {
    const { email, setCookies } = outcome.data;
    const params = new URLSearchParams({
      email,
      type: "email-verification",
      msg: `Use the code sent to ${email}'s inbox. Check the junk folder.`,
    });
    return authRedirect(Astro.request, `/login?${params}`, setCookies);
  }

  state = outcome.state;
  Astro.response.status = state.status;
}
---

<CommonPageLayout title={'Sign Up'}>
  <header>
    <h1>Sign Up</h1>
  </header>
  <div data-layout="content">

    <FormCard id="sign-up-form" submitText="Sign Up" {state}>
      <div class="flex gap-m">
        <InputField
          name="first_name"
          type="text"
          id="first_name"
          model="accounts"
          value={state.values.first_name}
          fieldError={state.fieldErrors.first_name}
        />
        <InputField
          name="last_name"
          type="text"
          id="last_name"
          model="accounts"
          value={state.values.last_name}
          fieldError={state.fieldErrors.last_name}
        />
      </div>
      <InputField
        name="email"
        type="email"
        id="email"
        model="accounts"
        required
        value={state.values.email}
        fieldError={state.fieldErrors.email}
      />
      <InputField
        name="password"
        type="password"
        id="password"
        model="accounts"
        required
        fieldError={state.fieldErrors.password}
      />
      <InputField
        name="image"
        type="text"
        id="image"
        model="accounts"
        value={state.values.image}
        fieldError={state.fieldErrors.image}
      />
    </FormCard>
  </div>
</CommonPageLayout>
