---
import InputField from "@components/form/InputField.astro";
import SubmitButton from "@components/form/SubmitButton.astro";
import TopLevelError from "@components/mgmt/TopLevelError.partial.astro";
import CommonPageLayout from "@layouts/CommonPageLayout.astro";
import { signup } from "@lib/auth/signup";
import type { SignupCredentials } from "@ty/Auth";

type SignUpFields = {
  email: string;
  password: string;
  image: string;
  username: string;
};

const session = Astro.locals.session;

let error: string | null = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  const payload = Object.fromEntries(formData.entries()) as SignUpFields;

  const { email, password, image, username } = payload;

  console.log({ payload });

  const result = await signup(payload);

  // const result = await signup(payload)

  if (result.success) {
    const redirectResponse = new Response(null, {
      status: 302,
      headers: { Location: "/dashboard?msg='Account Created! Welcome.'" },
    });
    for (const cookie of result.setCookies) {
      redirectResponse.headers.append("set-cookie", cookie);
    }
    return redirectResponse;
  }

  error = result.error;
}
---

<CommonPageLayout>
  <header>
    <h1>Sign Up</h1>
  </header>
  <div data-layout="content">
    {
      session ? (
        <p>
          You are currently logged in as{" "}
          <pre>{JSON.stringify(session, null, 2)}</pre>
        </p>
      ) : null
    }
    <form id="sign-up-form" method="POST">
      <div class="flex gap-m">
        <InputField
          name="first_name"
          type={"text"}
          id="first_name"
          model={"accounts"}
        />
        <InputField
          name="last_name"
          type={"text"}
          id="last_name"
          model={"accounts"}
        />
      </div>
      <InputField
        name="email"
        type={"email"}
        id="email"
        model={"accounts"}
        required={true}
      />
      <InputField
        name="password"
        type={"password"}
        id="password"
        model={"accounts"}
        required={true}
      />
      <InputField name="image" type={"text"} id="image" model={"accounts"} />

      <SubmitButton text="Sign Up" />
    </form>
    {
      error && (
        <p class="form-error error callout" role="alert">
          {error}
        </p>
      )
    }
  </div>
</CommonPageLayout>
