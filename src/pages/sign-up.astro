---
// pages/sign-up.astro
import InputField from "@components/form/InputField.astro";
import SubmitButton from "@components/form/SubmitButton.astro";
import TopLevelError from "@components/mgmt/TopLevelError.partial.astro";
import CommonPageLayout from "@layouts/CommonPageLayout.astro";
import { signup } from "@lib/auth/signup";
import { validate } from "@lib/validate";
import type { SignupCredentials } from "@ty/Auth";

type SignUpFields = {
  email: string;
  password: string;
  image: string;
  username: string;
};

const { session, user } = Astro.locals;

let error: string | null = null;

if (Astro.request.method === "POST") {
  const formData = Object.fromEntries(await Astro.request.formData());
  const validated = validate.signup.safeParse(formData);
  // const { email, password, image, first_name, last_name } = payload;
  const result = await signup(validated);

  if (result.success) {
    const redirectResponse = new Response(null, {
      status: 302,
      headers: {
        Location: `/dashboard?msg=${encodeURIComponent("Account Created! Welcome.")}`,
      },
    });
    for (const cookie of result.setCookies) {
      redirectResponse.headers.append("set-cookie", cookie);
    }
    return redirectResponse;
  }

  error = result.error;
}
---

<CommonPageLayout>
  <header>
    <h1>Sign Up</h1>
  </header>
  <div data-layout="content">
    {
      user ? (
        <p>
          You are currently logged in as <pre>{user.email}</pre>
        </p>
      ) : null
    }
    <form
      id="sign-up-form"
      method="POST"
      hx-boost="true"
      hx-disabled-elt="find button[type=submit]"
    >
      <div class="flex gap-m">
        <InputField
          name="first_name"
          type={"text"}
          id="first_name"
          model={"accounts"}
        />
        <InputField
          name="last_name"
          type={"text"}
          id="last_name"
          model={"accounts"}
        />
      </div>
      <InputField
        name="email"
        type={"email"}
        id="email"
        model={"accounts"}
        required={true}
      />
      <InputField
        name="password"
        type={"password"}
        id="password"
        model={"accounts"}
        required={true}
      />
      <InputField name="image" type={"text"} id="image" model={"accounts"} />

      <SubmitButton text="Sign Up" />
    </form>
    {
      error && (
        <p class="form-error error callout" role="alert">
          {error}
        </p>
      )
    }
  </div>
</CommonPageLayout>
