---
interface Params {
  id: string;
}
import { db } from "@db/db";
import { User, Ticket, Event, Location } from "@db/schema";
import { eq } from "drizzle-orm";
import BaseLayout from "@layouts/BaseLayout.astro";
import AdminNav from "@components/navigation/AdminNav.astro";
import TableEditable from "@components/TableEditable.astro";
import { crud } from "@lib/crudRegistry";
import { TEST_ADMIN_SESSION } from "@lib/auth/session";
import { formatPhonePrettyManual, prettyDateToLocale } from "@lib/formatters";
export const prerender = false; // Not needed in 'server' mode
const { id } = Astro.params;
if (!id) return Astro.redirect("/404");
const [ticket] = await db
  .select()
  .from(Ticket)
  .where(eq(Ticket.id, id))
  .limit(1);

if (!ticket) return Astro.redirect("/404");

const [courseJoin] = await db
  .select({
    user: User,
    course: Event,
    location: Location,
  })
  .from(Event)
  .innerJoin(Location, eq(Event.location_id, Location.id))
  .innerJoin(User, eq(User.id, ticket.user_id))
  .where(eq(Event.id, ticket.event_id))
  .limit(1);

const { timestamp, attended } = ticket;
const { subject, excerpt, date_civil, wp_post_id } = courseJoin.course;
const { address, city, zip, state } = courseJoin.location;
const { first_name, last_name, email, phone, middle_initial, address_1 } =
  courseJoin.user;
// const locations = await crud.locations.readMany(session);
---

<BaseLayout>
  <AdminNav />
  <main>
    <header>
      <h1>
        Ticket: <code>{id}</code>
      </h1>

      <a href={`./${id}/edit`} class="edit-tab">
        <svg
          width="30px"
          height="30px"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path opacity="0.15" d="M8 16H12L18 10L14 6L8 12V16Z" fill="#000000"
          ></path>
          <path
            d="M14 6L8 12V16H12L18 10M14 6L17 3L21 7L18 10M14 6L18 10M10 4L4 4L4 20L20 20V14"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span> Edit </span>
      </a>

      <dl class="kv">
        <dt>Attended:</dt>
        <dd>{attended}</dd>
        <dt>Timestamp:</dt>
        <dd>{timestamp}</dd>
      </dl>
    </header>
    <hr />
    <div data-layout="content">
      <div class="card">
        <div class="flex space-between">
          <h2>
            User:
            {first_name}
            {last_name}
            {middle_initial ? `(, ${middle_initial})` : ""}
          </h2>
          <a href={`/users/${ticket.user_id}`}>view</a>
        </div>
        <div class="user-info">
          <address>
            {address_1}
            <br />
            {city}, {state}
            {zip}
            USA
          </address>

          <div>
            <a href={`mailto:${email}`}>{email}</a>
            <br />
            <a href={`tel:${phone}`}>{formatPhonePrettyManual(phone)}</a>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="flex space-between">
          <h2>Event: {subject}</h2>
          <a href={`/events/${ticket.event_id}`}>view</a>
        </div>
        <time datetime={date_civil}>
          {prettyDateToLocale(new Date(date_civil))}
        </time>
        <br />
        <br />
        <div class="location-info">
          <address>
            {address}
            <br />
            {city}, {state}
            {zip}
            USA
          </address>
        </div>
        <hr />
        <p class="excerpt">{excerpt}</p>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  main {
    padding: 1rem;
  }

  h1 {
    anchor-name: --heading;
    width: fit-content;
  }

  .user-info {
    display: flex;
    gap: 2rem;
  }

  .edit-tab {
    position: absolute;
    position-anchor: --heading;
    top: anchor(top); /* aligns to h1's top edge */
    right: anchor(right); /* aligns to h1's right edge */
    transform: translate(100%, 0%); /* nudge outside the corner */
  }

  div[data-layout="content"] {
    display: grid;
    gap: 1rem;
  }
</style>
