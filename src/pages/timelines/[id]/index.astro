---
interface Params {
  id: string;
}

import TimelineGraph from "@components/TimelineGraph.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
export const prerender = false; // Not needed in 'server' mode
const { id } = Astro.params;
if (!id) return Astro.redirect("/404");

// const vendors = [
//   {
//     name: "DJ",
//     skills: ["MC", "Song Que", "Music Playlist"],
//   },
//   {
//     name: "Photographer",
//     skills: ["special moment", "candid"],
//   },
// ];

const parseTime = (hhmm: string) => {
  const [h, m] = hhmm.split(":").map(Number);
  return h * 60 + m;
};

const formatTimeRange = (start: string, end: string) => {
  let startMin = parseTime(start);
  let endMin = parseTime(end);

  // if end is "earlier", it means next day
  if (endMin <= startMin) {
    endMin += 1440;
  }

  return { start: startMin, end: endMin };
};
---

<BaseLayout>
  <main>
    <div class="callout error flex-align-center gap-s">
      <p id="banner-message"></p>
    </div>
    <header id="page-header" class="flex gap-l space-between">
      <div>
        <h1 id="page-title" class="flex gap-m">
          <input type="text" name="summary" value="temporary" />
          <span class="sub-text">rev</span>
          <span id="timeline-revision">#</span>
        </h1>
        <div class="grid gap-s">
          <input type="date" name="date_civil" />
          <input type="text" name="timezone" placeholder="timezone" />
        </div>
      </div>
      <div>
        <menu id="timeline-action-menu" data-timelineUUID={id} class="gap-s">
          <button data-action="commit">Commit Rev</button>
          <button data-action="export">Export JSON</button>
          <a href={`./${id}/print`} target="_blank" data-action="print">Print</a
          >
          <label>
            <span>Import JSON</span>
            <input type="file" data-action="import" />
          </label>
        </menu>
        <details>
          <summary>{id}</summary>
          <dl class="kv meta ghost">
            <dd>created</dd>
            <dt data-field="date_created">***</dt>
            <dd>modified</dd>
            <dt data-field="date_modified">***</dt>
            <dd>revision</dd>
            <dt data-field="rev">***</dt>
          </dl>
        </details>
      </div>
    </header>
    <hr />

    <TimelineGraph moments={[]} skills={[]} />

    <hr />

    <div class="timeline-grid gap-m" data-layout="content">
      <table id="timeline-moment-table" class="timeline-schedule">
        <thead>
          <tr>
            <th>time</th>
            <th>desc</th>
            <th>skill</th>
            <th>group</th>
            <th>note</th>
            <th>actions</th>
          </tr>
        </thead>
        <tbody id="time-moment-list"></tbody>
      </table>
      <aside class="grid gap-m">
        <h2 class="display none">blocks</h2>
        <ul id="time-groups-list" class="unstyled grid gap-s"></ul>
        <button id="create-group-item" class="btn ghost">+ add group</button>
      </aside>
    </div>
    <hr />
    <div class="card">
      <h2>Skills</h2>
      <ul id="skills-list" class="unstyled grid gap-m editable"></ul>
      <br />
      <button id="create-skill-item" class="btn ghost">+ add skill</button>
    </div>
  </main>
</BaseLayout>

<script>
  import {
    idbCreateMoment,
    idbDeleteMoment,
    idbUpdateMoment,
    idbCreateTimelineSkill,
    idbUpdateTimeSkill,
    idbDeleteTimeSkill,
    idbUpdateTimeGroup,
    idbCreateTimelineGroup,
    idbDeleteTimeGroup,
    idbUpdateStep,
    idbCreateStep,
    idbDeleteStep,
    idbGetSingleTimelineData,
    idbUpdateTimeline,
  } from "@client/indexedDB";
  import { seedIfEmpty } from "@client/initTimelineDB";
  import {
    createEmptyMoment,
    createStepEl,
    timeMomentRowEl,
  } from "@client/templates/timeMomentRow";
  import { groupCard } from "@client/templates/groupCard";
  import type {
    BtnAction,
    BtnDirection,
    TimelineSkill,
    MomentStep,
    Timeline,
    TimelineBtnAction,
    TimelineState,
    TimelineMoment,
    TimelineGroup,
  } from "@ty/Schema";

  import { debounce } from "@lib/wait";
  import { editableListItemElement } from "@client/templates/editableListItemElement";
  import { MOMENTS_STORE, STEPS_STORE } from "@client/indexedDB";
  import { downloadAsJSON } from "@client/downloadOnClient";
  import {
    prettyDateToLocale,
    prettyPlainCivilDateFull,
  } from "@lib/formatters";
  import { createStore } from "@client/stores";

  const pageHeader = document.getElementById("page-header")!;
  const timelineRevSpan = document.getElementById("timeline-revision")!;
  const table = document.getElementById("timeline-moment-table")!;
  const tbody = document.getElementById("time-moment-list")!;
  const skillList = document.getElementById("skills-list")!;
  const groupList = document.getElementById("time-groups-list")!;
  const skillCreateBtn = document.getElementById("create-skill-item")!;
  const groupCreateBtn = document.getElementById("create-group-item")!;
  const bannerMsgP = document.getElementById("banner-message")!;
  // let timelineData: TimelineData | null = null;

  const timeline_uuid = window.location.pathname.split("/").at(-1);

  async function fetchIdbData() {
    if (!timeline_uuid)
      throw new Error(
        `timeline_uuid: ${timeline_uuid}. how did you even get here?`,
      );
    try {
      await seedIfEmpty().catch((e) => console.error(`seedIfEmpty: ${e}`));
      return await idbGetSingleTimelineData(timeline_uuid);
    } catch (error) {
      bannerMsgP.textContent = String(error);
      throw new Error(`fetchIdbData, ${error}`);
    }
  }

  function renderTimelineUI(timeline: Timeline) {
    const { summary, date_civil, timezone, date_created, date_modified, rev } =
      timeline;
    const summaryInput = pageHeader?.querySelector(
      'input[name="summary"]',
    ) as HTMLInputElement;
    const dateCivilInput = pageHeader?.querySelector(
      'input[name="date_civil"]',
    ) as HTMLInputElement;
    const timezoneInput = pageHeader?.querySelector(
      'input[name="timezone"]',
    ) as HTMLInputElement;
    const dateCreatedEl = pageHeader?.querySelector(
      'dt[data-field="date_created"]',
    );
    const dateModifiedEl = pageHeader?.querySelector(
      'dt[data-field="date_modified"]',
    );
    const revEl = pageHeader?.querySelector('dt[data-field="rev"]');
    if (
      !summaryInput ||
      !dateCivilInput ||
      !timezoneInput ||
      !dateCreatedEl ||
      !dateModifiedEl ||
      !revEl
    )
      throw new Error("timeline input/el not found");
    summaryInput.value = summary;
    dateCivilInput.value = date_civil;
    timezoneInput.value = timezone;
    timelineRevSpan.textContent = String(rev);
    dateCreatedEl.textContent = prettyDateToLocale(date_created);
    dateModifiedEl.textContent = prettyDateToLocale(date_modified);
    revEl.textContent = String(rev);
  }

  function renderGroupsUI(groups: TimelineGroup[], moments: TimelineMoment[]) {
    groupList.replaceChildren(); // clear before re-render
    groups.forEach((g) =>
      groupList.appendChild(
        groupCard(
          g,
          moments.filter((b) => b.group_id === g.id),
        ),
      ),
    );

    if (!timeline_uuid)
      throw new Error(
        `timeline_uuid: ${timeline_uuid}. how did you even get here?`,
      );

    // TODO hoist event listeners so it isn't rerendred
    groupCreateBtn.addEventListener("pointerup", async (e) => {
      const newGroup = await idbCreateTimelineGroup({
        name: "",
        timeline_uuid,
      });
      const div = groupCard(
        newGroup,
        moments.filter((b) => b.group_id === newGroup.id),
      );
      div.dataset.groupId = String(newGroup.id);
      groupList.appendChild(div);
    });
  }

  function renderSkillsUI(skills: TimelineSkill[]) {
    skillList.replaceChildren();
    skills.forEach((s) => {
      // const li = document.createElement("li");
      // li.textContent = s.name;
      const li = editableListItemElement(s.name);
      li.dataset.skillId = String(s.id);
      skillList.appendChild(li);
    });

    if (!timeline_uuid)
      throw new Error(
        `timeline_uuid: ${timeline_uuid}. how did you even get here?`,
      );

    // TODO hoist event listeners so it isn't rerendred
    skillCreateBtn.addEventListener("pointerup", async (e) => {
      const emptySkill = await idbCreateTimelineSkill({
        name: "",
        timeline_uuid,
      });
      const li = editableListItemElement(emptySkill.name);
      li.dataset.skillId = String(emptySkill.id);
      skillList.appendChild(li);
    });
  }

  function renderTableUI(tmlnData: TimelineState) {
    const { moments, skills, groups, steps } = tmlnData;
    tbody.replaceChildren(); // clear existing
    moments.sort((a, b) => {
      return a.start - b.start;
    });
    moments.forEach((b) =>
      tbody.append(
        ...timeMomentRowEl(
          b,
          skills,
          groups,
          steps.filter((t) => t.moment_id === b.id),
        ),
      ),
    );
  }

  function renderGraphUI(moments: TimelineMoment[], skills: TimelineSkill[]) {
    document.dispatchEvent(
      new CustomEvent("timeline:load", {
        detail: { moments, skills },
      }),
    );
  }

  function renderUI(tmlnData: TimelineState) {
    if (!timeline_uuid)
      throw new Error(
        `timeline_uuid: ${timeline_uuid}. how did you even get here?`,
      );

    const { moments, skills, groups, steps } = tmlnData;

    renderGraphUI(moments, skills);

    // TODO move event listener outside of this render func
    table.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement;

      const btn = target.closest("button"); // handles clicks on child elements too
      if (!btn) return;
      const rowEl = btn.closest("tr")!;
      // const liEl = btn.closest("li");
      // console.log({liEl});
      const momentId = Number(rowEl.dataset.momentId);
      if (isNaN(momentId)) throw new Error(`moment id invalid: ${momentId}`);
      const btnType = btn.dataset.type;
      const btnAction = btn.dataset.action as BtnAction;
      const btnDirection = btn.dataset.direction as BtnDirection | undefined;
      // const stepId = Number(liEl?.dataset.stepId);

      const targetBlock = moments.find((b) => b.id === momentId);

      if (btnAction === "delete" && btnType === MOMENTS_STORE) {
        rowEl.remove();
        const arrIndex = moments.findIndex((b) => b.id === momentId);
        if (arrIndex !== -1) {
          moments.splice(arrIndex, 1);
        }

        await idbDeleteMoment(momentId);
        return;
      }

      if (btnAction === "delete" && btnType === STEPS_STORE) {
        const stepLi = btn.closest("li")!;
        const stepId = Number(stepLi.dataset.stepId);
        if (isNaN(stepId)) throw new Error(`step.id is invalid: ${stepId}`);
        stepLi.remove();
        const arrIndex = steps.findIndex((t) => t.id === stepId);
        if (arrIndex !== -1) {
          steps.splice(arrIndex, 1);
        }

        await idbDeleteStep(stepId);
        return;
      }

      if (!isNaN(momentId) && btnAction === "create") {
        const emptyStep: Omit<MomentStep, "id"> = {
          text: "",
          tbd: false,
          moment_id: momentId,
          note: "",
          order: 1,
        };

        const newStep = await idbCreateStep(emptyStep);
        const stepEl = createStepEl(newStep);
        const stepList = btn.closest("td")!.querySelector("ul.steps");
        stepList?.appendChild(stepEl);
        return;
      }
      if (btnAction === "insert") {
        // TODO get start and end from targed row
        // insert into createEmptyBlock

        let newStart = 0;
        let newEnd = 0;

        if (btnDirection === "above") {
          newStart = targetBlock ? targetBlock.start - 15 : 0;
          newEnd = targetBlock ? targetBlock.start : 0;
        } else if (btnDirection === "below") {
          newStart = targetBlock ? targetBlock.end : 0;
          newEnd = targetBlock ? targetBlock.end + 15 : 0;
        } else {
          console.log("❌ Direction not supported");
        }

        const emptyMoment = createEmptyMoment(timeline_uuid, {
          start: newStart,
          end: newEnd,
        });
        const newMoment = await idbCreateMoment(emptyMoment);
        // const newRow = timeMomentRow(newBlock, skills, groups);
        const [newRow, newSubRow] = timeMomentRowEl(
          newMoment,
          skills,
          groups,
          [],
        );

        if (btnDirection === "above") {
          rowEl.insertAdjacentElement("beforebegin", newRow);
          newRow.insertAdjacentElement("afterend", newSubRow);
        } else if (btn.dataset.direction === "below") {
          const existingSubRow = rowEl.nextElementSibling;
          existingSubRow
            ? existingSubRow.insertAdjacentElement("afterend", newRow)
            : rowEl.insertAdjacentElement("afterend", newRow);
          newRow.insertAdjacentElement("afterend", newSubRow);
        } else {
          console.log("❌ Direction not supported");
        }

        moments.push(newMoment);
        renderGraphUI(moments, skills);
        return;
      }
    });
  }

  const tmlnData = await fetchIdbData();

  const { skills, groups, moments } = tmlnData;
  if (!timeline_uuid) throw new Error("no uuid");

  const timelineStore = createStore<TimelineState>({
    ...tmlnData,
    id: timeline_uuid,
  });
  renderTimelineUI(tmlnData);
  renderSkillsUI(skills);
  renderGroupsUI(groups, moments);
  renderTableUI(tmlnData);
  renderUI(tmlnData);

  // TODO move all render ui funcs here
  timelineStore.subscribe((state) => {
    renderGraphUI(state.moments, state.skills);
  });

  const debouncedSaveMoment = debounce(
    async (momentId: number, field: string, value: string) => {
      const updated = await idbUpdateMoment(momentId, { [field]: value });
      timelineStore.update((state) => ({
        ...state,
        moments: state.moments.map((m) => (m.id === updated.id ? updated : m)),
      }));
    },
    500,
  );
  const debouncedSaveStep = debounce(
    async (momentId: number, field: string, value: string) => {
      await idbUpdateStep(momentId, { [field]: value });
    },
    500,
  );
  const debouncedSaveSkill = debounce(
    async (skillId: number, field: string, value: string) => {
      await idbUpdateTimeSkill(skillId, { [field]: value });
    },
    500,
  );
  const debouncedSaveGroup = debounce(
    async (groupId: number, field: string, value: string) => {
      await idbUpdateTimeGroup(groupId, { [field]: value });
    },
    500,
  );
  const debouncedSaveTimeline = debounce(
    async (uuid: string, field: string, value: string) => {
      await idbUpdateTimeline(uuid, { [field]: value });
      // TODO timelineStore.update for header text
    },
    500,
  );

  groupList.addEventListener("input", (e) => {
    const target = e.target as HTMLInputElement | HTMLTextAreaElement;
    if (!target.matches("input, textarea")) return;
    const cardEl = target.closest("div")!;
    const groupId = Number(cardEl.dataset.groupId);
    const field = target.name;
    if (!groupId || !field) return;
    debouncedSaveGroup(groupId, field, target.value);
  });
  skillList.addEventListener("input", (e) => {
    const target = e.target as HTMLInputElement | HTMLTextAreaElement;
    if (!target.matches("input, textarea")) return;
    const itemEl = target.closest("li")!;
    const skillId = Number(itemEl.dataset.skillId);
    const field = target.name;
    if (!skillId || !field) return;
    debouncedSaveSkill(skillId, field, target.value);
  });

  pageHeader?.addEventListener("input", (e) => {
    if (!timeline_uuid) throw new Error(`timeline_uuid: ${timeline_uuid}`);
    const target = e.target as HTMLInputElement | HTMLTextAreaElement;
    if (!target.matches("input, textarea")) return;
    const field = target.name;
    // console.log(timeline_uuid, field, target.value);
    debouncedSaveTimeline(timeline_uuid, field, target.value);
  });

  skillList.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;

    const btn = target.closest("button"); // handles clicks on child elements too
    if (!btn) return;
    const liEl = btn.closest("li")!;
    const skillId = Number(liEl.dataset.skillId);
    // const targetBlock = skills.find((b) => b.id === skillId);
    if (btn.dataset.action === "delete") {
      if (isNaN(skillId)) throw new Error(`skill id invalid: ${skillId}`);
      const deleted = await idbDeleteTimeSkill(skillId);
      liEl.remove();
    }
  });

  groupList.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest("button");
    if (!btn) return;
    const divEl = btn.closest("div")!;
    const groupId = Number(divEl.dataset.groupId);
    // const targetBlock = skills.find((b) => b.id === skillId);
    if (btn.dataset.action === "delete") {
      if (isNaN(groupId)) throw new Error(`group id invalid: ${groupId}`);
      const deleted = await idbDeleteTimeGroup(groupId);
      divEl.remove();
    }
  });

  table.addEventListener("input", (e) => {
    const target = e.target as HTMLInputElement | HTMLTextAreaElement;
    if (!target.matches("input, textarea")) return;

    const stepItem = target.closest("li[data-step-id]");
    if (stepItem) {
      const stepId = Number((stepItem as HTMLElement).dataset.stepId);
      const field = target.name as keyof MomentStep;
      debouncedSaveStep(stepId, field, target.value);
      return;
    }

    const row = target.closest("tr[data-moment-id]") as HTMLTableRowElement;
    if (!row) return;
    const momentId = Number(row.dataset.momentId);
    const field = target.name;
    if (!momentId || !field) return;

    debouncedSaveMoment(momentId, field, target.value);
  });

  // selects feel snappier with instant save on "change" instead
  table.addEventListener("change", (e) => {
    const target = e.target as HTMLSelectElement;
    if (!target.matches("select, input[type='checkbox']")) return;

    const stepItem = target.closest("li[data-step-id]");
    if (stepItem) {
      const stepId = Number((stepItem as HTMLElement).dataset.stepId);
      const field = target.name as keyof MomentStep;
      debouncedSaveStep(stepId, field, target.value);
      return;
    }

    const row = target.closest("tr")!;
    const momentId = Number(row.dataset.momentId);
    const field = target.name;
    if (!momentId || !field) return;

    idbUpdateMoment(momentId, { [field]: target.value });
  });

  document.querySelectorAll("textarea").forEach((el) => {
    const resize = () => {
      el.style.height = "auto";
      el.style.height = el.scrollHeight + "px";
    };

    el.addEventListener("input", resize);
    resize();
  });

  const timelineActionMenu = document.getElementById("timeline-action-menu");
  if (!timeline_uuid)
    throw new Error(
      `timeline_uuid: ${timeline_uuid}. how did you even get here?`,
    );
  timelineActionMenu?.addEventListener("click", async (e) => {
    const target = e.target as HTMLButtonElement;
    if (!target.matches("button")) return;
    const action = target.dataset.action as TimelineBtnAction | undefined;
    if (!action) throw new Error("TimelineBtnAction not defined");

    switch (action) {
      case "commit":
        console.log("POST to server DB");
        const updated = await idbUpdateTimeline(timeline_uuid, {});
        // TODO move to timelineStore.update for reactivity
        renderTimelineUI(updated);
        return;

      case "import":
        return console.log("import");

      case "print":
        return console.log("print");

      case "export":
        console.log("export");
        const tmlDt = await idbGetSingleTimelineData(timeline_uuid);
        const { summary, rev, date_modified } = tmlDt;
        return downloadAsJSON(tmlDt, `${summary} rev-${rev} ${date_modified}`);

      default:
        throw new Error(`TimelineBtnAction not supported: ${action}`);
    }
  });
  timelineActionMenu?.addEventListener("change", async (e) => {
    const target = e.target as HTMLInputElement;
    if (!target.matches("input")) return;
    const action = target.dataset.action as TimelineBtnAction | undefined;
    if (!action) throw new Error("TimelineBtnAction not defined");

    const file = target.files?.[0];
    if (!file) return;

    // Validate it's JSON by extension + type
    if (!file.name.endsWith(".json") || file.type !== "application/json") {
      alert("Please select a valid .json file");
      return;
    }

    if (action === "import") {
      try {
        const text = await file.text();
        const data = JSON.parse(text) as TimelineState;

        // Validate shape before writing — at minimum check required fields
        if (!data.id || !data.summary) {
          throw new Error("Invalid timeline format");
        }

        // await importTimelineData(data);
        renderUI(data);
      } catch (err) {
        console.error("Import failed:", err);
        alert("Failed to import: invalid or corrupted file");
      } finally {
        target.value = ""; // reset so the same file can be re-imported
      }
    }
  });
</script>

<style>
  main > header {
    align-items: flex-start;
  }

  div:has(#banner-message:empty) {
    display: none;
  }

  menu {
    padding-inline-start: 0;
  }

  input {
    background-color: transparent;
    border-color: transparent;

    &:hover {
      background-color: var(--c-input-bg, rgba(128, 128, 128, 0.456));
    }
    &:focus {
      border-color: initial;
    }
  }

  input[name="summary"] {
    font-size: var(--size-xl);
  }
</style>
