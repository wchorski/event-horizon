---
interface Params {
  id: string;
}

import TimelineGraph from "@components/TimelineGraph.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE_TITLE } from "astro:env/client";
export const prerender = false; // Not needed in 'server' mode
const { id } = Astro.params;
if (!id) return Astro.redirect("/404");

// const vendors = [
//   {
//     name: "DJ",
//     skills: ["MC", "Song Que", "Music Playlist"],
//   },
//   {
//     name: "Photographer",
//     skills: ["special moment", "candid"],
//   },
// ];

const parseTime = (hhmm: string) => {
  const [h, m] = hhmm.split(":").map(Number);
  return h * 60 + m;
};

const formatTimeRange = (start: string, end: string) => {
  let startMin = parseTime(start);
  let endMin = parseTime(end);

  // if end is "earlier", it means next day
  if (endMin <= startMin) {
    endMin += 1440;
  }

  return { start: startMin, end: endMin };
};
---

<BaseLayout title={`Timeline | ${SITE_TITLE}`}>
  <main>
    <p id="banner-message"></p>
    <header id="page-header" class="flex gap-l space-between">
      <div>
        <h1 id="page-title" class="flex gap-m">
          <input type="text" name="summary" value="temporary" />
          <span class="sub-text">rev</span>
          <span id="timeline-revision">#</span>
        </h1>
        <div class="grid gap-s">
          <input type="date" name="date_civil" />
          <input type="text" name="timezone" placeholder="timezone" />
        </div>
      </div>
      <div id="timeline-page-actions">
        <menu
          id="timeline-action-menu"
          data-timelineUUID={id}
          class="flex gap-s flex-align-center"
        >
          <button data-action="commit" hx-target={"#banner-message"} class="m">
            Commit Rev
          </button>
          <a href={`./${id}/print`} target="_blank" data-action="print">Print</a
          >
        </menu>
        <details>
          <summary>{id}</summary>
          <dl class="kv meta ghost">
            <dd>created</dd>
            <dt data-field="date_created">***</dt>
            <dd>modified</dd>
            <dt data-field="date_modified">***</dt>
            <dd>revision</dd>
            <dt data-field="rev">***</dt>
            <dd>Export</dd>
            <dt><button data-action="export">Export JSON</button></dt>
            <dd>Import</dd>
            <dt>
              <label>
                <span>Import JSON</span>
                <input type="file" data-action="import" />
              </label>
            </dt>
          </dl>
        </details>
        <p><a id="booking-link">BOOKING</a></p>
      </div>
    </header>
    <hr />

    <TimelineGraph moments={[]} skills={[]} />

    <hr />

    <div class="timeline-grid gap-m" data-layout="content">
      <table id="timeline-moment-table" class="timeline-schedule">
        <thead>
          <tr>
            <th>time</th>
            <th>desc</th>
            <th>skill</th>
            <th>group</th>
            <th>note</th>
            <th>actions</th>
          </tr>
        </thead>
        <tbody id="time-moment-list"></tbody>
        <tfoot>
          <tr>
            <td>
              <hr />
              <button id="create-moment-item" class="btn ghost"
                >+ add moment</button
              >
            </td>
          </tr>
        </tfoot>
      </table>
      <aside class="grid gap-m">
        <h2 class="display none">blocks</h2>
        <ul id="time-groups-list" class="unstyled grid gap-s"></ul>
        <button id="create-group-item" class="btn ghost">+ add group</button>
      </aside>
    </div>
    <hr />
    <div class="card">
      <h2>Skills</h2>
      <ul id="skills-list" class="unstyled grid gap-m editable"></ul>
      <br />
      <button
        id="create-skill-item"
        class="btn ghost"
        data-action="create"
        data-type="skills">+ add skill</button
      >
    </div>
  </main>
</BaseLayout>

<script >
  import "@client/timelineSignals";
  import "@client/textareaResize";
  import "@client/draggableMomentRow";
</script>

<style>
  #banner-message {
    display: none;
    /* margin: 0; */
    padding: var(--size-m);
    border-left-width: var(--size-xs);
    border-left-style: solid;
    border-left-color: var(--c-txt);
    border-radius: var(--size-m);
  }

  #banner-message[data-state] {
    display: block;
  }

  #banner-message[data-state="success"] {
    background-color: color-mix(in srgb, var(--c-success) 10%, transparent);
    border-left-color: var(--c-success);
    color: var(--c-success);
  }

  #banner-message[data-state="error"] {
    background-color: color-mix(in srgb, var(--c-error) 10%, transparent);
    border-left-color: var(--c-error);
    color: var(--c-error);
  }

  #banner-message[data-state="info"] {
    background-color: color-mix(in srgb, var(--c-success) 10%, transparent);
    border-left-color: var(--c-info);
  }
  main > header {
    align-items: flex-start;
  }

  menu {
    padding-inline-start: 0;
  }

  input {
    background-color: transparent;
    border-color: transparent;

    &:hover {
      background-color: var(--c-input-bg, rgba(128, 128, 128, 0.456));
    }
    &:focus {
      border-color: initial;
    }
  }

  input[name="summary"] {
    font-size: var(--size-xl);
  }
</style>
