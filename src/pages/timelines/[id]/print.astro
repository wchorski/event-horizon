---
import BaseLayout from "@layouts/BaseLayout.astro";

interface Params {
  id: string;
}
const { id } = Astro.params;
if (!id) return Astro.redirect("/404");
---

<BaseLayout>
  <main>
    <div class="callout error flex-align-center gap-s">
      <p id="banner-message"></p>
    </div>
    <header>
      <h1>print me {id}</h1>
    </header>
    <hr />
    <div class="timeline-grid gap-m" data-layout="content">
      <table id="timeline-moment-table" class="timeline-schedule">
        <thead>
          <tr>
            <th>time</th>
            <th>desc</th>
            <th>skill</th>
            <th>group</th>
            <th>note</th>
          </tr>
        </thead>
        <tbody id="time-moment-list"></tbody>
      </table>
      <aside class="grid gap-m">
        <h2 class="display none">blocks</h2>
        <ul id="time-groups-list" class="unstyled grid gap-s"></ul>
      </aside>
    </div>
  </main>
</BaseLayout>

<script>
  import { createElement } from "@client/elementRenders";
  import { idbGetSingleTimelineData } from "@client/indexedDB";
  import { timeMomentRowEl } from "@client/templates/timeMomentRow";
  import type { MomentStep, TimelineMoment, TimelineState } from "@ty/Schema";

  const tbody = document.getElementById("time-moment-list")!;
  const bannerMsgP = document.getElementById("banner-message")!;
  const timeline_uuid = window.location.pathname.split("/").at(-2);

  async function fetchIdbData() {
    if (!timeline_uuid)
      throw new Error(
        `timeline_uuid: ${timeline_uuid}. how did you even get here?`,
      );
    try {
      return await idbGetSingleTimelineData(timeline_uuid);
    } catch (error) {
      bannerMsgP.textContent = String(error);
      throw new Error(`fetchIdbData, ${error}`);
    }
  }
  const tmlnFetch = await fetchIdbData();

  const {
    summary,
    date_civil,
    rev,
    date_created,
    date_modified,
    moments,
    skills,
    groups,
  } = tmlnFetch;

  const h1 = document.querySelector("h1")!;
  h1.textContent = summary;

  renderTableUI(tmlnFetch);

  function uiMomentRowEls(moment: TimelineMoment, steps: MomentStep[]) {
    const { id } = moment;
    const tr = createElement(
      "tr",
      {
        id: `timeline-moment-anchor-${id}`,
        className: `time-moment-row`,
      },
      { momentId: String(id) },
    );

    const fields: (keyof TimelineMoment)[] = [
      "start",
      "desc",
      "skill_id",
      "group_id",
      "note",
    ];

    const cells = fields.map((key) =>
      createElement(
        "td",
        {
          textContent: String(moment[key] ?? ""),
        },
        {
          fieldName: key,
        },
      ),
    );
    tr.append(...cells);

    const trSub = createElement("tr", {
      id: `timeline-moment-anchor-${id}`,
      className: `time-moment-steps`,
    });
    const stepsCell = createElement("td", { colSpan: 999 });
    const stepsDetails = createElement("details", { open: true });
    const stepsSummary = createElement("summary", {
      className: "ghost",
      textContent: `${steps.length} step${steps.length > 1 ? "s" : ""}`,
    });
    const stepsList = createElement("ol", { className: "steps" });
    const stepItems = steps.map((s) =>
      createElement("li", { textContent: s.text || "-- blank --" }),
    );

    stepsList.append(...stepItems);
    stepsDetails.append(stepsSummary, stepsList);
    stepsCell.append(stepsDetails);
    trSub.append(stepsCell);

    return [tr, trSub];
  }

  function renderTableUI(tmlnData: TimelineState) {
    const { moments, skills, groups, steps } = tmlnData;
    tbody.replaceChildren(); // clear existing
    moments.sort((a, b) => {
      return a.start - b.start;
    });
    moments.forEach((m) => {
      const [tr, trSub] = uiMomentRowEls(
        m,
        steps.filter((t) => t.moment_id === m.id),
      );
      tbody.append(tr, trSub);
    });
    // moments.forEach((b) =>
    //   tbody.append(
    //     ...timeMomentRowEl(
    //       b,
    //       skills,
    //       groups,
    //       steps.filter((t) => t.moment_id === b.id),
    //     ),
    //   ),
    // );
  }
</script>

<style>
  div:has(#banner-message:empty) {
    display: none;
  }
</style>
