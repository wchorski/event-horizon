---
import PrintButton from "@components/PrintButton.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
interface Params {
  id: string;
}
const { id } = Astro.params;
if (!id) return Astro.redirect("/404");
---

<BaseLayout>
  <main>
    <div class="callout error flex-align-center gap-s">
      <p id="banner-message"></p>
    </div>
    <header class="flex space-between">
      <div>
        <h1>Timeline: {id}</h1>
        <time
          class="ghost"
          datetime=""
          id="timeline-date_civil"
          aria-label="date_civil">***</time
        >
      </div>
      <div>
        <PrintButton />
        <dl class="kv meta ghost">
          <dt>rev</dt>
          <dd id="timeline-rev">#</dd>
          <dt>modified</dt>
          <dd id="timeline-date_modified">***</dd>
        </dl>
      </div>
    </header>

    <table id="timeline-moment-table" class="timeline-schedule">
      <thead>
        <tr>
          <th>time</th>
          <th>desc</th>
          <th>skill</th>
          <th>group</th>
          <th>note</th>
        </tr>
      </thead>
      <tbody id="time-moment-list"></tbody>
    </table>
    <aside class="grid gap-m">
      <h2 class="display none">blocks</h2>
      <ul id="time-groups-list" class="unstyled grid gap-s"></ul>
    </aside>
  </main>
  <hr class="print-break" />
  <section id="timeline-calendar" class="page">
    <h2 class="display none">Timeline</h2>
    <div class="col-headers" id="col-headers"></div>

    <div class="wrap">
      <div class="time-col" id="time-col"></div>
      <div class="columns-area" id="columns-area"></div>
    </div>

    <div class="tooltip" id="tooltip">
      <div class="tooltip-title" id="tt-title"></div>
      <div class="tooltip-detail" id="tt-detail"></div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  @import "../../../styles/timeline-calendar.css";
</style>

<script>
  import { createElement } from "@client/elementRenders";
  import { idbGetSingleTimelineData } from "@client/indexedDB";

  import {
    prettyDateToLocale,
    prettyPlainCivilDateFull,
  } from "@lib/formatters";
  import { formatTimeMinutesToClockString } from "@lib/timeFormatters";
  import type {
    MomentStep,
    TimelineGroup,
    TimelineMoment,
    TimelineState,
  } from "@ty/Schema";
  import { timelineCalendarEls } from "@client/templates/timelineCalendarEls";

  const tbody = document.getElementById("time-moment-list")!;
  const groupsList = document.getElementById("time-groups-list")!;
  const bannerMsgP = document.getElementById("banner-message")!;
  const timeline_uuid = window.location.pathname.split("/").at(-2);

  async function fetchIdbData() {
    if (!timeline_uuid)
      throw new Error(
        `timeline_uuid: ${timeline_uuid}. how did you even get here?`,
      );
    try {
      return await idbGetSingleTimelineData(timeline_uuid);
    } catch (error) {
      bannerMsgP.textContent = String(error);
      throw new Error(`fetchIdbData, ${error}`);
    }
  }
  const tmlnFetch = await fetchIdbData();
  if (!tmlnFetch) throw new Error("timeline not found: null");
  const {
    summary,
    date_civil,
    rev,
    date_modified,
    skills,
    groups,
    // date_created,
    moments,
  } = tmlnFetch;

  timelineCalendarEls(tmlnFetch);

  const h1 = document.querySelector("h1")!;
  const elDate_civil = document.getElementById("timeline-date_civil")!;
  const elDate_modified = document.getElementById("timeline-date_modified")!;
  const elRev = document.getElementById("timeline-rev")!;
  h1.textContent = summary;
  elDate_civil.textContent = prettyPlainCivilDateFull(date_civil);
  elDate_modified.textContent = prettyDateToLocale(date_modified);
  elRev.textContent = String(rev);

  renderTableUI(tmlnFetch);
  uiGroupsList(groups, moments);

  function uiMomentRowEls(moment: TimelineMoment, steps: MomentStep[]) {
    const { id, start, end, desc, skill_id, group_id, note, tbd } = moment;
    const mSkill = skills.find((s) => s.id === skill_id);
    const tr = createElement(
      "tr",
      {
        id: `timeline-moment-anchor-${id}`,
        className: `time-moment-row`,
      },
      { momentId: String(id), tbd: String(tbd) },
    );

    // const fields: (keyof TimelineMoment)[] = [
    //   "start",
    //   "desc",
    //   "skill_id",
    //   "group_id",
    //   "note",
    // ];

    // TODO custom cell render start & end together with formatting

    const tdStartEnd = createElement(
      "td",
      {},
      {
        fieldName: "start-end",
      },
    );
    const ulStartEnd = createElement("ul", {
      className: "unstyled",
    });
    const liStart = createElement(
      "li",
      {
        textContent: formatTimeMinutesToClockString(start, true),
      },
      {
        fieldName: "start",
      },
    );
    const liEnd = createElement(
      "li",
      {
        textContent: formatTimeMinutesToClockString(end, true),
      },
      {
        fieldName: "end",
      },
    );
    ulStartEnd.append(liStart, liEnd);
    tdStartEnd.append(ulStartEnd);
    const tdDesc = createElement(
      "td",
      {
        textContent: desc,
      },
      {
        fieldName: "desc",
      },
    );
    const tdSkill = createElement(
      "td",
      {
        className: "skill_name",
        textContent: mSkill?.name,
        style: {
          "--icon": `"${mSkill?.icon || "•"}"`,
          "--color": mSkill?.color || "hsla(0, 0%, 50%, 0.257)",
        },
      },
      {
        fieldName: "skill_name",
      },
    );
    const tdGroup = createElement(
      "td",
      {
        textContent: groups.find((g) => g.id === group_id)?.name,
      },
      {
        fieldName: "group_name",
      },
    );
    const tdNote = createElement(
      "td",
      {
        textContent: note,
      },
      {
        fieldName: "note",
      },
    );
    // const cells = fields.map((key) =>
    //   createElement(
    //     "td",
    //     {
    //       textContent: String(moment[key] ?? ""),
    //     },
    //     {
    //       fieldName: key,
    //     },
    //   ),
    // );
    tr.append(tdStartEnd, tdDesc, tdSkill, tdGroup, tdNote);

    if (steps.length > 0) {
      const trSub = createElement(
        "tr",
        {
          id: `timeline-moment-step-${id}`,
          className: `time-moment-steps`,
        },
        { "moment-id": String(id) },
      );
      const stepsCell = createElement("td", { colSpan: 999 });
      const stepsDetails = createElement("details", { open: true });
      const stepsSummary = createElement("summary", {
        className: "ghost",
        textContent: `${steps.length} step${steps.length > 1 ? "s" : ""}`,
      });
      const stepsList = createElement("ol", { className: "steps" });
      const stepItems = steps.map((s) => {
        const li = createElement(
          "li",
          {
            // textContent:
            //   (s.text || "-- blank --") + (s.note ? ` [${s.note}]` : ""),
          },
          {
            tbd: String(s.tbd),
          },
        );

        const summarySpan = createElement("span", {
          textContent: s.text || "-- blank --",
          className: "summary",
        });

        const noteSpan = createElement("span", {
          textContent: s.note,
          className: "note",
        });

        li.append(summarySpan, noteSpan);
        return li;
      });

      stepsList.append(...stepItems);
      stepsDetails.append(stepsSummary, stepsList);
      stepsCell.append(stepsDetails);
      trSub.append(stepsCell);
      return [tr, trSub];
    }
    return [tr];
  }

  function renderTableUI(tmlnData: TimelineState) {
    const { moments, skills, groups, steps } = tmlnData;
    tbody.replaceChildren(); // clear existing
    moments.sort((a, b) => {
      return a.start - b.start;
    });
    moments.forEach((m) => {
      const [tr, trSub] = uiMomentRowEls(
        m,
        steps.filter((t) => t.moment_id === m.id),
      );
      tbody.append(tr);
      if (trSub) tbody.appendChild(trSub);
    });
    // moments.forEach((b) =>
    //   tbody.append(
    //     ...timeMomentRowEl(
    //       b,
    //       skills,
    //       groups,
    //       steps.filter((t) => t.moment_id === b.id),
    //     ),
    //   ),
    // );
  }

  function uiGroupsList(groups: TimelineGroup[], moments: TimelineMoment[]) {
    const groupLis = groups.map((g) => {
      const divCard = createElement(
        "div",
        { className: "card" },
        { groupId: String(g.id) },
      );
      const h3 = createElement("h3", { textContent: g.name });
      const ul = createElement("ul", {});
      const lis = moments
        .filter((m) => m.group_id === g.id)
        .map((m) => createElement("li", { textContent: m.desc }));
      ul.append(...lis);

      divCard.append(h3, ul);
      return divCard;
    });
    groupsList.append(...groupLis);
  }
</script>

<style is:global>
  div:has(#banner-message:empty) {
    display: none;
  }
  td[data-field-name="note"] {
    max-width: 15ch;
  }
  td[data-field-name="start-end"] {
    font-family: "Courier New", Courier, monospace;
  }

  .time-moment-row:not(:has(+ .time-moment-steps)) > td {
    padding-bottom: var(--size-m);
  }

  .time-moment-steps > td {
    margin-bottom: 1rem;
  }

  li[data-tbd="true"] {
    border-bottom: orange dotted 1px;
    &::marker {
      color: orange;
    }
    &::after {
      content: "*TBD* ";
      color: orange;
    }
  }

  td[data-field-name="skill_name"]:not(:empty) {
    --icon: "•";
    --color: hsla(0, 0%, 50%, 0.257);

    &::before {
      content: var(--icon);
      background-color: var(--color);
      color: black;
      border-radius: 30px;
      padding: 0.3rem;
      margin-right: 0.2rem;
      opacity: 0.7;
    }
  }

  ol.steps {
    padding-inline-start: var(--size-m, 1rem);
    list-style-position: inside;

    & > li {
      width: fit-content;
      display: grid;
      grid-template-columns: 250px 200px 1fr;
      gap: 1rem;

      & .note {
        color: var(--c-ghost);
        font-style: italic;
      }
    }
  }
</style>
