{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@components/*": ["./src/components/*"],
      "@client/*": ["./src/client/*"],
      "@styles/*": ["./src/styles/*"],
      "@partials/*": ["./src/pages/partials/*"],
      "@lib/*": ["./src/lib/*"],
      "@ty/*": ["./types/*"],
      "@db/*": ["./src/db/*"],
      "@public/*": ["./public/*"],
      "@layouts/*": ["./src/layouts/*"]
    },
    "plugins": [
      {
        "name": "typescript-plugin-css-modules"
      }
    ],
  }
}
